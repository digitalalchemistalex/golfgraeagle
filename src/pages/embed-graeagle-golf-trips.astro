---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/content.js';

const title = "Free Graeagle Golf Trip Widget — Embed Real Package Pricing on Your Site";
const description = "Add a live Graeagle golf trip pricing widget to any website in 30 seconds. Shows real completed packages with verified pricing. Free to embed. No signup required.";
const canonicalUrl = `${siteConfig.url}/embed-graeagle-golf-trips/`;
const ogImage = `${siteConfig.url}/wp-images/grizzly-ranch-hero.webp`;

const previewTrips = [
  { price: 620,  nights: 2, golfers: 24, rounds: 3, courses: ['Whitehawk Ranch', 'Graeagle Meadows'] },
  { price: 645,  nights: 2, golfers: 12, rounds: 2, courses: ['Grizzly Ranch', 'Whitehawk Ranch'] },
  { price: 675,  nights: 2, golfers: 8,  rounds: 3, courses: ['Whitehawk Ranch', 'Graeagle Meadows'] },
  { price: 849,  nights: 3, golfers: 16, rounds: 3, courses: ['Nakoma Dragon', 'Grizzly Ranch'] },
  { price: 1067, nights: 3, golfers: 30, rounds: 4, courses: ['Plumas Pines', 'Whitehawk Ranch'] },
  { price: 1150, nights: 3, golfers: 36, rounds: 4, courses: ['Grizzly Ranch', 'Whitehawk Ranch'] },
];

const platforms = [
  { name: 'WordPress', how: 'Post editor → click + → search "Custom HTML" → paste code inside that block.' },
  { name: 'Squarespace', how: 'Edit page → Add block → Embed → paste the code.' },
  { name: 'Wix', how: 'Add Elements → Embed Code → HTML iframe → paste the code.' },
  { name: 'Plain HTML', how: 'Paste directly into your .html file where you want the widget.' },
  { name: 'Webflow', how: 'Add an Embed element to your page → paste the code inside it.' },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": canonicalUrl,
    "name": title,
    "description": description,
    "url": canonicalUrl,
    "inLanguage": "en-US",
    "isPartOf": { "@id": "https://golfgraeagle.com/#website" },
    "about": { "@id": "https://golfgraeagle.com/#organization" },
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".speakable", ".aeo-answer", "[data-speakable]"] }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Embed the Graeagle Golf Trip Widget on Your Website",
    "description": "Add a live Graeagle golf trip pricing widget to any website in three steps.",
    "totalTime": "PT2M",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Copy the embed code", "text": "Copy the single iframe code snippet from this page." },
      { "@type": "HowToStep", "position": 2, "name": "Paste into your page", "text": "Paste the code into your blog post, travel guide, or website wherever you want the widget to appear." },
      { "@type": "HowToStep", "position": 3, "name": "Publish", "text": "Save and publish. The widget loads automatically showing real Graeagle golf trip packages with verified pricing." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Is the Graeagle golf trip widget free to embed?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The widget is completely free to embed on any website. No account, no signup, no API key required. Copy the iframe code and paste it into your page." } },
      { "@type": "Question", "name": "What does the widget show?", "acceptedAnswer": { "@type": "Answer", "text": "The widget displays real completed Graeagle golf trip packages with verified pricing, courses played, group size, number of nights, and rounds. Data is pulled live from GolfGraeagle.com's trip archive of 22+ actual packages." } },
      { "@type": "Question", "name": "Does the widget update automatically?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The widget pulls live data from GolfGraeagle.com's trip archive every time it loads. When new trips are added, they appear automatically." } },
      { "@type": "Question", "name": "What websites can use this widget?", "acceptedAnswer": { "@type": "Answer", "text": "Any website can embed this widget — WordPress, Squarespace, Wix, Webflow, plain HTML, or any blog platform that allows iframe embeds." } },
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Graeagle Golf Trip Pricing Widget",
    "applicationCategory": "TravelApplication",
    "operatingSystem": "Web",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "description": "A free embeddable widget showing real Graeagle golf trip packages with verified pricing.",
    "url": "https://golfgraeagle.com/trips-widget/",
    "provider": { "@id": "https://golfgraeagle.com/#organization" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteConfig.url },
      { "@type": "ListItem", "position": 2, "name": "Embed Widget", "item": canonicalUrl }
    ]
  }
];
---
<Base title={title} description={description} schema={schema} canonical={canonicalUrl} ogImage={ogImage} bodyClass="light-page">
  <Nav />

  <main class="ew-main">

    <!-- HERO — mobile-first, full-width -->
    <section class="ew-hero">
      <div class="ew-hero-inner">
        <p class="ew-eyebrow">Free Tool for Golf & Travel Websites</p>
        <h1 class="speakable ew-hero-h1">Embed Real Graeagle Golf<br class="ew-br"/> Trip Pricing on Your Site</h1>
        <p class="aeo-answer ew-hero-sub">One line of code. Live data. 22 real packages with verified pricing — auto-updated. Free forever.</p>
        <!-- Mobile: separate CTAs. Writers = embed. Golfers = quote. -->
        <div class="ew-hero-btns">
          <a href="#get-the-code" class="ew-btn-primary">Get the embed code ↓</a>
          <a href="https://golfgraeagle.com/trips-widget/" target="_blank" rel="noopener" class="ew-btn-ghost">Preview live widget ↗</a>
        </div>
        <!-- Mobile only: if you're a golfer not a blogger -->
        <p class="ew-hero-golfer-nudge">Planning a Graeagle golf trip yourself? <a href="/request-a-quote/" class="ew-hero-golfer-link">Get a free quote →</a></p>
      </div>
    </section>

    <!-- STATS STRIP — mobile scannable -->
    <section class="ew-stats-strip">
      {[
        { num: '22+', label: 'Real trips' },
        { num: '$379', label: 'From' },
        { num: '$1,705', label: 'Up to' },
        { num: '5', label: 'Courses' },
        { num: 'Free', label: 'Cost' },
      ].map(s => (
        <div class="ew-stat">
          <div class="ew-stat-num">{s.num}</div>
          <div class="ew-stat-label">{s.label}</div>
        </div>
      ))}
    </section>

    <!-- WHAT IS IT — stacked on mobile -->
    <section class="ew-section">
      <div class="ew-container">
        <p class="ew-label">What it is</p>
        <h2 class="ew-h2" data-speakable>A live pricing widget your readers will actually use</h2>
        <p class="ew-body">Your readers ask "how much does a Graeagle golf trip cost?" You now have a real answer — not a range, not "contact us", but actual completed packages with real dollar amounts.</p>
        <p class="ew-body">The widget pulls live from GolfGraeagle.com's trip archive. Every card shows courses played, group size, nights, and verified per-person cost. When new trips are added, they appear automatically — zero action needed from your site.</p>
        <ul class="ew-checklist">
          <li>No account or signup required</li>
          <li>Updates automatically — zero maintenance</li>
          <li>Works on WordPress, Squarespace, Wix, plain HTML</li>
          <li>Mobile responsive — stacks to single column</li>
          <li>Free. No ads. No tracking of your visitors.</li>
        </ul>
      </div>
    </section>

    <!-- LIVE PREVIEW — the widget mock inside a browser chrome -->
    <section class="ew-section ew-preview-section">
      <div class="ew-container">
        <p class="ew-label">Live preview</p>
        <h2 class="ew-h2">This is exactly what your readers see</h2>
        <p class="ew-body-center">Real data. Not a mockup. This renders from GolfGraeagle.com's live trip archive.</p>
      </div>

      <!-- Browser chrome — constrained but scrollable on small screens -->
      <div class="ew-browser-wrap">
        <div class="ew-browser">
          <!-- Browser bar -->
          <div class="ew-browser-bar">
            <div class="ew-dots">
              <span class="ew-dot ew-dot-red"></span>
              <span class="ew-dot ew-dot-yellow"></span>
              <span class="ew-dot ew-dot-green"></span>
            </div>
            <div class="ew-url-bar">yourgolfblog.com/graeagle-guide</div>
          </div>
          <!-- Blog context text -->
          <div class="ew-blog-ctx">
            <p class="ew-blog-cont">...continued from article...</p>
            <p class="ew-blog-para">When planning a Graeagle golf trip, the most common question is: <em>what will this actually cost?</em> Rather than a vague estimate, here are real packages from GolfGraeagle.com's trip archive:</p>
          </div>
          <!-- Widget replica -->
          <div class="ew-widget-mock">
            <div class="ew-wm-header">
              <div>
                <div class="ew-wm-title">Real Graeagle Golf Trips</div>
                <div class="ew-wm-sub">Actual packages with verified pricing</div>
              </div>
              <span class="ew-wm-badge">22 trips · from $379/person</span>
            </div>
            <div class="ew-cards-grid">
              {previewTrips.map(trip => (
                <div class="ew-card">
                  <div class="ew-card-label">Courses Played</div>
                  <div class="ew-card-courses">{trip.courses.join(' · ')}</div>
                  <div class="ew-card-tags">
                    <span class="ew-tag">{trip.nights}n</span>
                    <span class="ew-tag">{trip.golfers} golfers</span>
                    <span class="ew-tag">{trip.rounds} rounds</span>
                  </div>
                  <div class="ew-card-footer">
                    <div class="ew-card-price">${trip.price}<span class="ew-card-per">/person</span></div>
                    <span class="ew-card-cta">Plan Similar →</span>
                  </div>
                </div>
              ))}
            </div>
            <div class="ew-wm-powered">Powered by <strong>GolfGraeagle.com</strong> — Graeagle golf specialists since 2004</div>
          </div>
          <!-- Blog continues -->
          <div class="ew-blog-ctx">
            <p class="ew-blog-para">These are actual completed packages, not estimates. Click "Plan Similar" to request a custom quote...</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 STEPS -->
    <section id="get-the-code" class="ew-section">
      <div class="ew-container">
        <p class="ew-label">How to add it</p>
        <h2 class="ew-h2" data-speakable>3 steps. Under 2 minutes.</h2>
        <p class="ew-body-center">Works on WordPress, Squarespace, Wix, Webflow, or any site that allows HTML.</p>

        <div class="ew-steps">

          <!-- Step 1 -->
          <div class="ew-step">
            <div class="ew-step-num">1</div>
            <div class="ew-step-body">
              <h3 class="ew-step-h3">Copy this code</h3>
              <p class="ew-step-p">Select all and copy — or tap the button.</p>
              <div class="ew-code-wrap">
                <pre id="embed-code" class="ew-code">{`<iframe
  src="https://golfgraeagle.com/trips-widget/"
  width="100%"
  height="520"
  frameborder="0"
  style="border-radius:12px;"
  title="Real Graeagle Golf Trip Packages"
></iframe>`}</pre>
                <button
                  class="ew-copy-btn"
                  onclick="var t=document.getElementById('embed-code').textContent;navigator.clipboard.writeText(t).then(function(){var b=document.querySelector('.ew-copy-btn');b.textContent='✓ Copied!';b.style.background='#3a8a48';b.style.color='#fff';setTimeout(function(){b.textContent='Copy';b.style.background='#e8a850';b.style.color='#1a2e1a'},2000)})">
                  Copy
                </button>
              </div>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="ew-step">
            <div class="ew-step-num">2</div>
            <div class="ew-step-body">
              <h3 class="ew-step-h3">Paste into your page</h3>
              <p class="ew-step-p">Where to paste it depends on your platform:</p>
              <div class="ew-platforms">
                {platforms.map(p => (
                  <div class="ew-platform">
                    <div class="ew-platform-name">{p.name}</div>
                    <div class="ew-platform-how">{p.how}</div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="ew-step">
            <div class="ew-step-num">3</div>
            <div class="ew-step-body">
              <h3 class="ew-step-h3">Publish — you're done</h3>
              <p class="ew-step-p">Save and publish your page. The widget loads automatically. No settings, no API key, no account. When new Graeagle trips are added to our archive, they appear in your widget automatically — you never have to update anything.</p>
              <div class="ew-tip">
                <strong>Tip:</strong> Place the widget right after a paragraph that mentions Graeagle golf trip costs. It answers the question your reader just asked — before they leave your page to search elsewhere.
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- WHY BLOGGERS USE IT -->
    <section class="ew-section ew-why-section">
      <div class="ew-container">
        <h2 class="ew-h2" data-speakable>Why travel writers and golf bloggers add it</h2>
        <div class="ew-why-grid">
          {[
            { icon: '📊', title: 'Real data your readers trust', body: 'Pricing articles without real numbers get ignored. This widget shows verified costs from actual completed packages — the specificity readers search for and stay for.' },
            { icon: '⏱️', title: 'Zero maintenance forever', body: 'Paste once. The widget updates itself. No broken links, no outdated numbers, no annual "refresh this post" task.' },
            { icon: '🔗', title: 'Your readers get the answer', body: 'Every "Plan Similar →" card links to GolfGraeagle.com\'s quote form. Your reader gets to a real booking conversation without leaving to Google something.' },
          ].map(w => (
            <div class="ew-why-card">
              <div class="ew-why-icon">{w.icon}</div>
              <h3 class="ew-why-h3">{w.title}</h3>
              <p class="ew-why-body">{w.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="ew-section">
      <div class="ew-container ew-faq-container">
        <h2 class="ew-h2">Common questions</h2>
        <div class="ew-faqs">
          {[
            { q: 'Is it really free?', a: 'Yes. No cost, no account, no strings. We built it because real pricing data benefits everyone planning a Graeagle golf trip — and the bloggers who cover it.' },
            { q: 'Will it slow down my site?', a: 'No. The widget loads inside an iframe — completely isolated from your page. It cannot affect your site speed, SEO, or Core Web Vitals.' },
            { q: 'Can I change the height?', a: 'Yes. Adjust height="520" in the code. Set it to 400 for compact or 700+ to show more cards without scrolling.' },
            { q: 'Does it work on mobile?', a: 'Yes. The widget is fully responsive. On screens under 600px it stacks to a single column automatically.' },
            { q: 'Does GolfGraeagle track my visitors?', a: 'No. The widget does not set cookies or track your visitors. It only loads trip data from our archive.' },
            { q: 'Want a custom integration?', a: 'Email mike.eskuchen@golfthehighsierra.com. We can discuss custom implementations for larger golf and travel platforms.' },
          ].map((f, i) => (
            <details class="ew-faq">
              <summary class="ew-faq-q">
                {f.q}
                <span class="ew-faq-icon">+</span>
              </summary>
              <p class="ew-faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- DUAL CTA — different for mobile users (likely golfers) vs desktop (likely bloggers) -->
    <section class="ew-cta-section">
      <div class="ew-container">
        <!-- For bloggers / writers -->
        <div class="ew-cta-card ew-cta-blogger">
          <div class="ew-cta-icon">✍️</div>
          <h3 class="ew-cta-h3">Writing about Graeagle golf?</h3>
          <p class="ew-cta-p">Add real verified pricing to your article in 30 seconds. Free, zero maintenance.</p>
          <a href="#get-the-code" class="ew-cta-btn-dark">Get the embed code ↑</a>
        </div>
        <!-- For golfers planning a trip — mobile-first -->
        <div class="ew-cta-card ew-cta-golfer">
          <div class="ew-cta-icon">⛳</div>
          <h3 class="ew-cta-h3">Planning a Graeagle trip yourself?</h3>
          <p class="ew-cta-p">Mike Eskuchen builds every package personally. Free quote, 24-hour response. 4.8/5 from 672 trips.</p>
          <a href="/request-a-quote/" class="btn-green-glow ew-cta-btn-green">Get a free quote →</a>
          <p class="ew-cta-tel">or call <a href="tel:+18885861157">(888) 586-1157</a></p>
        </div>
      </div>
    </section>

  </main>

  <style>
    /* ── Base ── */
    .ew-main { background: #fff; }

    /* ── Hero ── */
    .ew-hero { background: linear-gradient(160deg, #0d1a0e 0%, #1a3020 65%, #0d2010 100%); padding: clamp(48px,8vw,96px) 20px clamp(40px,7vw,80px); text-align: center; }
    .ew-hero-inner { max-width: 680px; margin: 0 auto; }
    .ew-eyebrow { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.14em; color: #e8a850; margin: 0 0 14px; }
    .ew-hero-h1 { font-family: 'Playfair Display', serif; font-size: clamp(26px, 6vw, 48px); line-height: 1.15; color: #f0ece3; margin: 0 0 16px; }
    .ew-br { display: none; }
    .ew-hero-sub { font-size: clamp(15px, 2.5vw, 19px); color: rgba(240,236,227,0.72); line-height: 1.6; margin: 0 0 28px; }
    .ew-hero-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 20px; }
    .ew-btn-primary { display: inline-block; background: #3a8a48; color: #fff; font-size: 15px; font-weight: 700; padding: 13px 28px; border-radius: 100px; text-decoration: none; }
    .ew-btn-ghost { display: inline-block; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2); color: #f0ece3; font-size: 15px; font-weight: 600; padding: 13px 28px; border-radius: 100px; text-decoration: none; }
    .ew-hero-golfer-nudge { font-size: 13px; color: rgba(240,236,227,0.45); margin: 0; }
    .ew-hero-golfer-link { color: #e8a850; text-decoration: none; font-weight: 600; }

    /* ── Stats strip ── */
    .ew-stats-strip { display: flex; justify-content: center; flex-wrap: wrap; gap: 0; background: #f0f8f0; border-bottom: 1px solid #d4edd4; }
    .ew-stat { padding: 16px 20px; text-align: center; border-right: 1px solid #d4edd4; flex: 1; min-width: 80px; }
    .ew-stat:last-child { border-right: none; }
    .ew-stat-num { font-size: clamp(18px, 3vw, 24px); font-weight: 800; color: #1a2e1a; }
    .ew-stat-label { font-size: 11px; color: #5a7060; text-transform: uppercase; letter-spacing: 0.08em; }

    /* ── Sections ── */
    .ew-section { padding: clamp(40px,6vw,72px) 0; }
    .ew-preview-section { background: #f9fcf9; }
    .ew-why-section { background: #f4f9f4; }
    .ew-container { max-width: 760px; margin: 0 auto; padding: 0 20px; }
    .ew-label { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: #a06c30; margin: 0 0 10px; }
    .ew-h2 { font-family: 'Playfair Display', serif; font-size: clamp(22px, 4vw, 32px); color: #1a2e1a; margin: 0 0 16px; }
    .ew-body { font-size: 15px; color: #3d5240; line-height: 1.7; margin: 0 0 14px; }
    .ew-body-center { font-size: 15px; color: #5a7060; line-height: 1.7; margin: 0 0 28px; }
    .ew-checklist { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-direction: column; gap: 8px; }
    .ew-checklist li { font-size: 14px; color: #1a6030; font-weight: 500; padding-left: 20px; position: relative; }
    .ew-checklist li::before { content: '✓'; position: absolute; left: 0; color: #3a8a48; }

    /* ── Browser mockup ── */
    .ew-browser-wrap { max-width: 860px; margin: 0 auto; padding: 0 20px; overflow-x: auto; }
    .ew-browser { border-radius: 12px; overflow: hidden; box-shadow: 0 8px 40px rgba(26,46,26,0.14); border: 1px solid #d0e0d0; min-width: 320px; }
    .ew-browser-bar { background: #f2f2f2; padding: 10px 14px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #e0e0e0; }
    .ew-dots { display: flex; gap: 5px; }
    .ew-dot { width: 11px; height: 11px; border-radius: 50%; flex-shrink: 0; }
    .ew-dot-red { background: #ff5f57; }
    .ew-dot-yellow { background: #febc2e; }
    .ew-dot-green { background: #28c840; }
    .ew-url-bar { flex: 1; background: #fff; border-radius: 5px; padding: 5px 10px; font-size: 12px; color: #888; border: 1px solid #e0e0e0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ew-blog-ctx { background: #fff; padding: 20px; }
    .ew-blog-cont { font-size: 12px; color: #aaa; margin: 0 0 6px; }
    .ew-blog-para { font-size: 14px; color: #333; line-height: 1.65; margin: 0; }

    /* ── Widget mock ── */
    .ew-widget-mock { background: #fff; padding: 16px; border-top: 1px solid #eee; border-bottom: 1px solid #eee; }
    .ew-wm-header { display: flex; align-items: center; justify-content: space-between; padding-bottom: 14px; border-bottom: 2px solid #e0ece0; margin-bottom: 16px; flex-wrap: wrap; gap: 8px; }
    .ew-wm-title { font-size: 16px; font-weight: 700; color: #1a2e1a; }
    .ew-wm-sub { font-size: 12px; color: #5a7060; }
    .ew-wm-badge { background: #3a8a4822; color: #1a6030; padding: 3px 10px; border-radius: 100px; font-size: 11px; font-weight: 700; white-space: nowrap; }
    .ew-cards-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .ew-card { border: 1px solid #ddeedd; border-radius: 10px; padding: 12px; }
    .ew-card-label { font-size: 9px; font-weight: 700; color: #3a8a48; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 5px; }
    .ew-card-courses { font-size: 12px; font-weight: 600; color: #1a2e1a; margin-bottom: 8px; line-height: 1.3; }
    .ew-card-tags { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 8px; }
    .ew-tag { font-size: 10px; padding: 2px 7px; border-radius: 100px; background: #f0f8f0; color: #3a6a40; border: 1px solid #c8e8c8; }
    .ew-card-footer { display: flex; align-items: center; justify-content: space-between; padding-top: 8px; border-top: 1px solid #e8f0e8; }
    .ew-card-price { font-size: 17px; font-weight: 800; color: #1a2e1a; }
    .ew-card-per { font-size: 10px; color: #8a9a8e; font-weight: 400; }
    .ew-card-cta { font-size: 10px; font-weight: 700; color: #3a8a48; }
    .ew-wm-powered { text-align: center; padding-top: 12px; font-size: 11px; color: #8a9a8e; }

    /* ── Steps ── */
    .ew-steps { display: flex; flex-direction: column; gap: 20px; margin-top: 32px; }
    .ew-step { display: flex; gap: 20px; align-items: flex-start; background: #f9fcf9; border: 1px solid #e0ece0; border-radius: 14px; padding: 24px 20px; }
