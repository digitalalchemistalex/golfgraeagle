---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/content.js';

const title = "Free Graeagle Golf Trip Widget — Embed Real Package Pricing on Your Site";
const description = "Add a live Graeagle golf trip pricing widget to any website in 30 seconds. Shows real completed packages with verified pricing. Free to embed. No signup required.";
const canonicalUrl = `${siteConfig.url}/embed-graeagle-golf-trips/`;
const ogImage = `${siteConfig.url}/wp-images/grizzly-ranch-hero.webp`;

const WIDGET_URL = "https://golfgraeagle.com/trips-widget/";
const EMBED_CODE = `<iframe\n  src="https://golfgraeagle.com/trips-widget/"\n  width="100%"\n  height="520"\n  frameborder="0"\n  style="border-radius:12px;"\n  title="Real Graeagle Golf Trip Packages"\n></iframe>`;

// Real trip data for static preview - verified from TripsCaddie API
const previewTrips = [
  { price: 620,  nights: 2, golfers: 24, rounds: 3, vibe: 'Value',   courses: ['Whitehawk Ranch', 'Graeagle Meadows'] },
  { price: 645,  nights: 2, golfers: 12, rounds: 2, vibe: 'Value',   courses: ['Grizzly Ranch', 'Whitehawk Ranch'] },
  { price: 675,  nights: 2, golfers: 8,  rounds: 3, vibe: 'Value',   courses: ['Whitehawk Ranch', 'Graeagle Meadows'] },
  { price: 849,  nights: 3, golfers: 16, rounds: 3, vibe: 'Value',   courses: ['Nakoma Dragon', 'Grizzly Ranch'] },
  { price: 1067, nights: 3, golfers: 30, rounds: 4, vibe: 'Premium', courses: ['Plumas Pines', 'Whitehawk Ranch'] },
  { price: 1150, nights: 3, golfers: 36, rounds: 4, vibe: 'Premium', courses: ['Grizzly Ranch', 'Whitehawk Ranch'] },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": canonicalUrl,
    "name": title,
    "description": description,
    "url": canonicalUrl,
    "inLanguage": "en-US",
    "isPartOf": { "@id": "https://golfgraeagle.com/#website" },
    "about": { "@id": "https://golfgraeagle.com/#organization" },
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".speakable", ".aeo-answer", "[data-speakable]"] }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Embed the Graeagle Golf Trip Widget on Your Website",
    "description": "Add a live Graeagle golf trip pricing widget to any website in three steps.",
    "totalTime": "PT2M",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Copy the embed code", "text": "Copy the single iframe code snippet from this page." },
      { "@type": "HowToStep", "position": 2, "name": "Paste into your page", "text": "Paste the code into your blog post, travel guide, or website wherever you want the widget to appear." },
      { "@type": "HowToStep", "position": 3, "name": "Publish", "text": "Save and publish. The widget loads automatically showing real Graeagle golf trip packages with verified pricing." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Is the Graeagle golf trip widget free to embed?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The widget is completely free to embed on any website. No account, no signup, no API key required. Copy the iframe code and paste it into your page." } },
      { "@type": "Question", "name": "What does the widget show?", "acceptedAnswer": { "@type": "Answer", "text": "The widget displays real completed Graeagle golf trip packages with verified pricing, courses played, group size, number of nights, and rounds. Data is pulled live from GolfGraeagle.com's trip archive of 22+ actual packages." } },
      { "@type": "Question", "name": "Does the widget update automatically?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The widget pulls live data from GolfGraeagle.com's trip archive every time it loads. When new trips are added to the archive, they appear automatically — no action needed from the site that embeds it." } },
      { "@type": "Question", "name": "What websites can use this widget?", "acceptedAnswer": { "@type": "Answer", "text": "Any website can embed this widget — WordPress, Squarespace, Wix, Webflow, plain HTML, or any blog platform that allows iframe embeds. It works anywhere you can paste HTML." } },
      { "@type": "Question", "name": "How wide should the embed be?", "acceptedAnswer": { "@type": "Answer", "text": "The widget is fully responsive. Set width to 100% and it adapts to any container. On mobile it stacks to a single column. Minimum recommended width is 320px." } },
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Graeagle Golf Trip Pricing Widget",
    "applicationCategory": "TravelApplication",
    "operatingSystem": "Web",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "description": "A free embeddable widget showing real Graeagle golf trip packages with verified pricing. Displays 22+ actual completed trips including courses, group size, nights, and per-person cost.",
    "url": WIDGET_URL,
    "provider": { "@id": "https://golfgraeagle.com/#organization" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteConfig.url },
      { "@type": "ListItem", "position": 2, "name": "Embed Widget", "item": canonicalUrl }
    ]
  }
];
---
<Base title={title} description={description} schema={schema} canonical={canonicalUrl} ogImage={ogImage} bodyClass="light-page">
  <Nav />

  <main>

    <!-- HERO -->
    <section style="background:linear-gradient(135deg,#0d1a0e 0%,#1a3020 60%,#0d2010 100%);padding:clamp(60px,8vw,100px) 24px clamp(50px,7vw,90px);text-align:center;">
      <div style="max-width:760px;margin:0 auto;">
        <p style="font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:0.14em;color:#e8a850;margin-bottom:16px;">Free Tool for Golf & Travel Websites</p>
        <h1 class="speakable" style="font-family:'Playfair Display',serif;font-size:clamp(28px,5vw,52px);line-height:1.15;color:#f0ece3;margin:0 0 20px;">Embed Real Graeagle Golf<br/>Trip Pricing on Your Site</h1>
        <p class="aeo-answer" style="font-size:clamp(16px,2vw,20px);color:rgba(240,236,227,0.75);line-height:1.6;margin:0 0 36px;max-width:580px;margin-left:auto;margin-right:auto;">One line of code. Live data. 22 real packages with verified pricing — automatically updated. Free forever.</p>
        <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
          <a href="#get-the-code" style="display:inline-block;background:#3a8a48;color:#fff;font-size:15px;font-weight:700;padding:14px 32px;border-radius:100px;text-decoration:none;">Get the embed code →</a>
          <a href={WIDGET_URL} target="_blank" rel="noopener" style="display:inline-block;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.2);color:#f0ece3;font-size:15px;font-weight:600;padding:14px 32px;border-radius:100px;text-decoration:none;">Preview widget ↗</a>
        </div>
      </div>
    </section>

    <!-- WHAT IS IT -->
    <section style="max-width:900px;margin:0 auto;padding:64px 24px 0;">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;" class="what-grid">
        <div>
          <p style="font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:0.12em;color:#a06c30;margin-bottom:12px;">What it is</p>
          <h2 style="font-family:'Playfair Display',serif;font-size:28px;color:#1a2e1a;margin:0 0 16px;" data-speakable>A live pricing widget your readers will actually use</h2>
          <p style="color:#3d5240;line-height:1.7;margin-bottom:16px;">Your readers ask "how much does a Graeagle golf trip cost?" You now have a real answer — not a range, not "contact us", but actual completed packages with real dollar amounts.</p>
          <p style="color:#3d5240;line-height:1.7;margin-bottom:20px;">The widget pulls live from GolfGraeagle.com's trip archive. Every card shows courses played, group size, number of nights, and verified per-person cost. When new trips are added, they appear automatically.</p>
          <div style="display:flex;flex-direction:column;gap:10px;">
            {[
              '✓ No account or signup required',
              '✓ Updates automatically — zero maintenance',
              '✓ Works on WordPress, Squarespace, Wix, plain HTML',
              '✓ Mobile responsive — stacks to single column',
              '✓ Free. No ads. No tracking of your visitors.',
            ].map(f => (
              <div style="font-size:14px;color:#1a6030;font-weight:500;">{f}</div>
            ))}
          </div>
        </div>

        <!-- Stats block -->
        <div style="background:#f0f8f0;border-radius:20px;padding:32px;">
          <p style="font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;color:#3a8a48;margin-bottom:20px;">What's inside</p>
          {[
            { num: '22+', label: 'Real completed trips' },
            { num: '$379', label: 'Lowest price shown' },
            { num: '$1,705', label: 'Highest price shown' },
            { num: '5', label: 'Graeagle courses covered' },
            { num: '0', label: 'Cost to embed' },
          ].map(s => (
            <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid #d4edd4;">
              <span style="color:#5a7060;font-size:14px;">{s.label}</span>
              <span style="font-size:22px;font-weight:800;color:#1a2e1a;">{s.num}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- LIVE PREVIEW -->
    <section style="max-width:900px;margin:0 auto;padding:64px 24px 0;">
      <p style="font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:0.12em;color:#a06c30;margin-bottom:12px;text-align:center;">Live preview</p>
      <h2 style="font-family:'Playfair Display',serif;font-size:28px;color:#1a2e1a;margin:0 0 8px;text-align:center;">This is what your readers will see</h2>
      <p style="color:#5a7060;text-align:center;margin-bottom:32px;font-size:15px;">Exact rendering. Real data. This is not a mockup.</p>

      <!-- Browser chrome mockup -->
      <div style="border-radius:16px;overflow:hidden;box-shadow:0 12px 48px rgba(26,46,26,0.15);border:1px solid #d0e0d0;">
        <!-- Browser bar -->
        <div style="background:#f5f5f5;padding:12px 16px;display:flex;align-items:center;gap:8px;border-bottom:1px solid #e0e0e0;">
          <div style="display:flex;gap:6px;">
            <div style="width:12px;height:12px;border-radius:50%;background:#ff5f57;"></div>
            <div style="width:12px;height:12px;border-radius:50%;background:#febc2e;"></div>
            <div style="width:12px;height:12px;border-radius:50%;background:#28c840;"></div>
          </div>
          <div style="flex:1;background:#fff;border-radius:6px;padding:6px 12px;font-size:12px;color:#888;border:1px solid #e0e0e0;">yourgolfblog.com/graeagle-guide</div>
        </div>

        <!-- Blog context -->
        <div style="background:#fff;padding:28px 32px 0;">
          <div style="max-width:680px;margin:0 auto;">
            <p style="font-size:13px;color:#888;margin-bottom:8px;">...continued from article...</p>
            <p style="font-size:16px;color:#333;line-height:1.7;margin-bottom:4px;">When planning a Graeagle golf trip, the most common question is: <em>what will this actually cost?</em> Rather than give you a vague estimate, here are real packages from GolfGraeagle.com's trip archive — actual completed trips with verified pricing:</p>
          </div>
        </div>

        <!-- The actual widget preview (static replica with real data) -->
        <div style="background:#fff;padding:24px 32px 32px;">
          <div style="max-width:680px;margin:0 auto;border:1px solid #e0ece0;border-radius:12px;padding:20px;">
            <!-- Widget header -->
            <div style="display:flex;align-items:center;justify-content:space-between;padding-bottom:16px;border-bottom:2px solid #e0ece0;margin-bottom:20px;flex-wrap:wrap;gap:10px;">
              <div>
                <div style="font-size:18px;font-weight:700;color:#1a2e1a;">Real Graeagle Golf Trips</div>
                <div style="font-size:13px;color:#5a7060;">Actual packages with verified pricing</div>
              </div>
              <span style="background:#3a8a4822;color:#1a6030;padding:4px 12px;border-radius:100px;font-size:12px;font-weight:700;">22 trips · from $379/person</span>
            </div>
            <!-- Trip cards grid -->
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;" class="preview-grid">
              {previewTrips.slice(0, 6).map(trip => (
                <div style="border:1px solid #ddeedd;border-radius:10px;padding:14px;background:#fff;">
                  <div style="font-size:10px;font-weight:700;color:#3a8a48;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Courses Played</div>
                  <div style="font-size:13px;font-weight:600;color:#1a2e1a;margin-bottom:8px;line-height:1.35;">{trip.courses.join(' · ')}</div>
                  <div style="display:flex;gap:5px;flex-wrap:wrap;margin-bottom:8px;">
                    <span style="font-size:10px;padding:2px 8px;border-radius:100px;background:#f0f8f0;color:#3a6a40;border:1px solid #c8e8c8;">{trip.nights}n</span>
                    <span style="font-size:10px;padding:2px 8px;border-radius:100px;background:#f0f8f0;color:#3a6a40;border:1px solid #c8e8c8;">{trip.golfers} golfers</span>
                    <span style="font-size:10px;padding:2px 8px;border-radius:100px;background:#f0f8f0;color:#3a6a40;border:1px solid #c8e8c8;">{trip.rounds} rounds</span>
                  </div>
                  <div style="display:flex;align-items:center;justify-content:space-between;padding-top:10px;border-top:1px solid #e8f0e8;">
                    <div style="font-size:18px;font-weight:800;color:#1a2e1a;">${trip.price}<span style="font-size:10px;color:#8a9a8e;font-weight:400;">/person</span></div>
                    <span style="font-size:11px;font-weight:700;color:#3a8a48;">Plan Similar →</span>
                  </div>
                </div>
              ))}
            </div>
            <!-- Powered by -->
            <div style="text-align:center;padding-top:14px;font-size:12px;color:#8a9a8e;">
              Powered by <strong style="color:#3a8a48;">GolfGraeagle.com</strong> — Graeagle golf trip specialists since 2004
            </div>
          </div>
        </div>

        <!-- Blog continues -->
        <div style="background:#fff;padding:0 32px 28px;">
          <div style="max-width:680px;margin:0 auto;">
            <p style="font-size:16px;color:#333;line-height:1.7;">These figures represent actual completed packages — not estimates. Click "Plan Similar" to request a custom quote for your group...</p>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW TO EMBED — 3 steps -->
    <section id="get-the-code" style="max-width:900px;margin:0 auto;padding:64px 24px 0;">
      <p style="font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:0.12em;color:#a06c30;margin-bottom:12px;text-align:center;">How to add it</p>
      <h2 style="font-family:'Playfair Display',serif;font-size:28px;color:#1a2e1a;margin:0 0 8px;text-align:center;" data-speakable>Three steps. Under 2 minutes.</h2>
      <p style="color:#5a7060;text-align:center;margin-bottom:48px;">Works on WordPress, Squarespace, Wix, Webflow, or any site that allows HTML.</p>

      <div style="display:grid;gap:24px;">

        <!-- Step 1 -->
        <div style="display:grid;grid-template-columns:60px 1fr;gap:24px;align-items:start;padding:28px;background:#f9fcf9;border:1px solid #e0ece0;border-radius:16px;">
          <div style="width:52px;height:52px;border-radius:50%;background:#1a2e1a;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800;color:#e8a850;flex-shrink:0;">1</div>
          <div>
            <h3 style="font-size:18px;font-weight:700;color:#1a2e1a;margin:0 0 8px;">Copy this code</h3>
            <p style="color:#5a7060;font-size:14px;margin-bottom:16px;">Select all the code below and copy it.</p>
            <div style="position:relative;">
              <pre id="embed-code" style="background:#1a2e1a;color:#78c488;font-size:13px;padding:20px;border-radius:10px;overflow-x:auto;line-height:1.6;margin:0;font-family:'Courier New',monospace;">{`<iframe
  src="https://golfgraeagle.com/trips-widget/"
  width="100%"
  height="520"
  frameborder="0"
  style="border-radius:12px;"
  title="Real Graeagle Golf Trip Packages"
></iframe>`}</pre>
              <button
                onclick="navigator.clipboard.writeText(document.getElementById('embed-code').textContent).then(()=>{this.textContent='✓ Copied!';this.style.background='#3a8a48';setTimeout(()=>{this.textContent='Copy code';this.style.background='#e8a850'},2000)})"
                style="position:absolute;top:12px;right:12px;background:#e8a850;color:#1a2e1a;border:none;padding:6px 14px;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer;">Copy code</button>
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div style="display:grid;grid-template-columns:60px 1fr;gap:24px;align-items:start;padding:28px;background:#f9fcf9;border:1px solid #e0ece0;border-radius:16px;">
          <div style="width:52px;height:52px;border-radius:50%;background:#1a2e1a;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800;color:#e8a850;flex-shrink:0;">2</div>
          <div>
            <h3 style="font-size:18px;font-weight:700;color:#1a2e1a;margin:0 0 8px;">Paste into your page</h3>
            <p style="color:#5a7060;font-size:14px;margin-bottom:16px;">How you paste it depends on your platform. Here's where to put it:</p>
            <div style="display:grid;gap:10px;">
              {[
                { platform: 'WordPress', how: 'In your post editor, click the + button → search "Custom HTML" → paste the code inside that block.' },
                { platform: 'Squarespace', how: 'Edit your page → Add block → Embed → paste the code.' },
                { platform: 'Wix', how: 'Edit page → Add Elements → Embed Code → HTML iframe → paste the code.' },
                { platform: 'Plain HTML', how: 'Paste directly into your .html file where you want the widget to appear.' },
                { platform: 'Webflow', how: 'Add an Embed element to your page → paste the code inside it.' },
              ].map(p => (
                <div style="display:grid;grid-template-columns:120px 1fr;gap:12px;padding:12px 16px;background:#fff;border:1px solid #e8f0e8;border-radius:8px;align-items:start;">
                  <div style="font-size:13px;font-weight:700;color:#1a2e1a;">{p.platform}</div>
                  <div style="font-size:13px;color:#5a7060;">{p.how}</div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div style="display:grid;grid-template-columns:60px 1fr;gap:24px;align-items:start;padding:28px;background:#f9fcf9;border:1px solid #e0ece0;border-radius:16px;">
          <div style="width:52px;height:52px;border-radius:50%;background:#1a2e1a;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800;color:#e8a850;flex-shrink:0;">3</div>
          <div>
            <h3 style="font-size:18px;font-weight:700;color:#1a2e1a;margin:0 0 8px;">Publish — you're done</h3>
            <p style="color:#5a7060;font-size:14px;line-height:1.6;">Save and publish your page. The widget loads immediately. No settings to configure, no API key, no account. When new Graeagle trips are added to our archive, they appear in your widget automatically — you never have to update anything.</p>
            <div style="margin-top:16px;padding:14px 18px;background:#e8f8e8;border-radius:8px;border-left:3px solid #3a8a48;">
              <p style="font-size:13px;color:#1a6030;margin:0;"><strong>Tip:</strong> Place the widget right after a paragraph that mentions Graeagle golf trip costs. It answers the question your reader just asked — before they leave your page to go search for the answer.</p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- WHY BLOGGERS USE IT -->
    <section style="max-width:900px;margin:0 auto;padding:64px 24px 0;">
      <h2 style="font-family:'Playfair Display',serif;font-size:28px;color:#1a2e1a;margin:0 0 32px;text-align:center;" data-speakable>Why travel writers and golf bloggers add it</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;" class="why-grid">
        {[
          {
            icon: '📊',
            title: 'Real data your readers trust',
            body: 'Pricing articles without real numbers get ignored. This widget shows verified costs from actual completed packages — the kind of specificity readers search for and stay for.'
          },
          {
            icon: '⏱️',
            title: 'Zero maintenance forever',
            body: 'You paste it once. The widget updates itself as new trips are logged. You never touch it again. No broken links, no outdated numbers, no annual "refresh this post" reminder.'
          },
          {
            icon: '🔗',
            title: 'Your readers get the answer',
            body: 'Every "Plan Similar →" card links directly to GolfGraeagle.com\'s quote form. Your reader gets to a real booking conversation without leaving to Google something else.'
          },
        ].map(w => (
          <div style="padding:24px;background:#fff;border:1px solid #e0ece0;border-radius:16px;text-align:center;">
            <div style="font-size:32px;margin-bottom:12px;">{w.icon}</div>
            <h3 style="font-size:16px;font-weight:700;color:#1a2e1a;margin:0 0 10px;">{w.title}</h3>
            <p style="font-size:14px;color:#5a7060;line-height:1.6;margin:0;">{w.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section style="max-width:760px;margin:0 auto;padding:64px 24px 0;">
      <h2 style="font-family:'Playfair Display',serif;font-size:28px;color:#1a2e1a;margin:0 0 32px;text-align:center;">Common questions</h2>
      <div style="display:grid;gap:2px;">
        {[
          { q: 'Is it really free?', a: 'Yes. No cost, no account, no strings. We built it because real pricing data benefits everyone planning a Graeagle golf trip — and bloggers who cover it.' },
          { q: 'Will it slow down my site?', a: 'No. The widget loads inside an iframe — completely isolated from your page. It cannot affect your site speed, SEO, or Core Web Vitals.' },
          { q: 'Can I change the height?', a: 'Yes. Adjust the height="520" value in the code. Set it to 400 for a compact view or 700+ to show more cards without scrolling.' },
          { q: 'Does it work on mobile?', a: 'Yes. The widget is fully responsive. On screens under 600px it automatically stacks to a single column. No extra code needed.' },
          { q: 'What if I want more control?', a: 'Email us at mike.eskuchen@golfthehighsierra.com. We can discuss custom implementations for larger golf and travel platforms.' },
          { q: 'Does GolfGraeagle track my visitors?', a: 'No. The widget does not set cookies or track your visitors. It only loads trip data from our archive.' },
        ].map((f, i) => (
          <details style={`padding:20px 0;border-bottom:1px solid #e8f0e8;${i===0?'border-top:1px solid #e8f0e8;':''}`}>
            <summary style="font-size:16px;font-weight:600;color:#1a2e1a;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;">
              {f.q}
              <span style="color:#3a8a48;font-size:20px;flex-shrink:0;margin-left:12px;">+</span>
            </summary>
            <p style="font-size:15px;color:#5a7060;line-height:1.7;margin:12px 0 0;">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- FINAL CTA -->
    <section style="max-width:900px;margin:0 auto;padding:64px 24px 80px;">
