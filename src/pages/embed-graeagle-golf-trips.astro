---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/content.js';

const title = "Free Graeagle Golf Trip Widget — Embed Real Package Pricing on Your Site";
const description = "Add a live Graeagle golf trip pricing widget to any website in 30 seconds. Shows real completed packages with verified pricing, photos, lodging, and course details. Free to embed. No signup required.";
const canonicalUrl = `${siteConfig.url}/embed-graeagle-golf-trips/`;
const ogImage = `${siteConfig.url}/wp-images/grizzly-ranch-.webp`;

// Real trips with verified images from TripsCaddie API — filtered to Graeagle only
const featuredTrips = [
  {
    price: 675,
    nights: 2,
    golfers: 8,
    rounds: 3,
    vibe: 'Value',
    month: 'June',
    courses: ['Whitehawk Ranch', 'Graeagle Meadows', 'Grizzly Ranch'],
    lodging: 'River Pines Resort',
    synopsis: '2-night, 3-round package. Comfortable resort rooms, three of Graeagle\'s best courses, walking distance to dining.',
    highlights: ['3 rounds with cart', '2 nights River Pines Resort', 'All tee times secured'],
    image: 'https://golfthehighsierra.com/trips-caddie/uploads/trip_1766434476_24eb2409db35c4c8.webp',
    slug: 'grizzly-ranch-golf-packages',
  },
  {
    price: 849,
    nights: 3,
    golfers: 16,
    rounds: 3,
    vibe: 'Value',
    month: 'September',
    courses: ['The Dragon at Nakoma', 'Grizzly Ranch', 'Whitehawk Ranch'],
    lodging: '4-Bedroom Townhome at Plumas Pines',
    synopsis: '3-night townhome stay. September conditions — no crowds, aspens turning, firm fairways. The Dragon + two Top 100s.',
    highlights: ['3 nights townhome — own bedrooms', 'Nakoma Dragon (FLW clubhouse)', 'Best month for conditions'],
    image: 'https://golfthehighsierra.com/trips-caddie/uploads/trip_1774118142_fe9758d0bb513d2f.jpg',
    slug: 'nakoma-dragon-golf-packages',
  },
  {
    price: 1009,
    nights: 3,
    golfers: 8,
    rounds: 4,
    vibe: 'Value',
    month: 'August',
    courses: ['Plumas Pines', 'Graeagle Meadows', 'Grizzly Ranch', 'Whitehawk Ranch'],
    lodging: 'Plumas Pines Townhomes',
    synopsis: 'All 4 public courses in 3 nights. Private townhomes, everyone gets their own bedroom, 4 rounds with cart included.',
    highlights: ['All 4 public courses', '3 nights private townhomes', '4 rounds with cart'],
    image: 'https://golfthehighsierra.com/trips-caddie/uploads/trip_1774117619_6322b7649999cfe6.jpg',
    slug: 'plumas-pines-golf-packages',
  },
  {
    price: 1067,
    nights: 3,
    golfers: 30,
    rounds: 3,
    vibe: 'Premium',
    month: 'June',
    courses: ['Plumas Pines', 'Whitehawk Ranch', 'Grizzly Ranch'],
    lodging: 'Plumas Pines Private Townhomes',
    synopsis: 'Large group done right. 30 golfers, private 3-bedroom townhomes (own bedrooms), three premier courses, banquet dinner.',
    highlights: ['30 golfers — own bedrooms guaranteed', 'Private townhome block', 'Banquet dinner arranged'],
    image: 'https://golfthehighsierra.com/trips-caddie/uploads/trip_1769105871_ebf5c47de7d6a4e9.jpg',
    slug: 'whitehawk-ranch-golf-packages',
  },
  {
    price: 1105,
    nights: 3,
    golfers: 8,
    rounds: 4,
    vibe: 'Value',
    month: 'July',
    courses: ['Plumas Pines', 'Graeagle Meadows', 'Grizzly Ranch', 'Whitehawk Ranch'],
    lodging: '4-Bedroom Townhomes at Plumas Pines',
    synopsis: 'Peak summer, 4 rounds, every course. Private 4-bedroom townhomes with full kitchen. The classic Graeagle bucket list trip.',
    highlights: ['4 rounds — every Graeagle course', 'Private 4-bedroom townhomes', 'Peak season availability secured'],
    image: 'https://golfthehighsierra.com/trips-caddie/uploads/trip_1774117532_bc48cf8894ea6ef5.webp',
    slug: 'graeagle-meadows-golf-packages',
  },
  {
    price: 1150,
    nights: 3,
    golfers: 36,
    rounds: 3,
    vibe: 'Premium',
    month: 'July',
    courses: ['Grizzly Ranch', 'Whitehawk Ranch', 'Plumas Pines'],
    lodging: 'Townhomes at Plumas Pines Resort',
    synopsis: '36 golfers, 3 courses, 3 nights. Multiple tee sheet blocks coordinated. 36 holes at Whitehawk in one day. Clean invoicing.',
    highlights: ['36 golfers — all logistics handled', '36-hole day at Whitehawk', 'Clean group invoicing'],
    image: 'https://golfthehighsierra.com/trips-caddie/uploads/trip_1766435975_d3d06c7c651da8da.webp',
    slug: 'grizzly-ranch-golf-packages',
  },
];

const vibeColors = {
  'Value': { bg: '#e8f8e8', text: '#1a6030', border: '#b4e0b4' },
  'Premium': { bg: '#fff8e8', text: '#7a4d10', border: '#e8d490' },
};

const platforms = [
  { name: 'WordPress', how: 'Post editor → click + → search "Custom HTML" → paste.' },
  { name: 'Squarespace', how: 'Edit page → Add block → Embed → paste.' },
  { name: 'Wix', how: 'Add Elements → Embed Code → HTML iframe → paste.' },
  { name: 'Plain HTML', how: 'Paste directly into your .html file.' },
  { name: 'Webflow', how: 'Add Embed element → paste the code inside.' },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": canonicalUrl,
    "name": title,
    "description": description,
    "url": canonicalUrl,
    "inLanguage": "en-US",
    "isPartOf": { "@id": "https://golfgraeagle.com/#website" },
    "about": { "@id": "https://golfgraeagle.com/#organization" },
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".speakable", ".aeo-answer", "[data-speakable]"] }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Embed the Graeagle Golf Trip Widget on Your Website",
    "description": "Add a live Graeagle golf trip pricing widget to any website in three steps.",
    "totalTime": "PT2M",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Copy the embed code", "text": "Copy the iframe code snippet from this page." },
      { "@type": "HowToStep", "position": 2, "name": "Paste into your page", "text": "Paste the code into your blog post or website." },
      { "@type": "HowToStep", "position": 3, "name": "Publish", "text": "Save and publish. The widget loads automatically with real Graeagle golf trip packages." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Is the Graeagle golf trip widget free to embed?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Completely free. No account, no signup, no API key. Copy the iframe and paste it." } },
      { "@type": "Question", "name": "What does the widget show?", "acceptedAnswer": { "@type": "Answer", "text": "Real completed Graeagle golf trip packages with photos, verified pricing, courses played, lodging used, group size, and highlights. Data from GolfGraeagle.com's archive of 22+ actual packages." } },
      { "@type": "Question", "name": "Does the widget update automatically?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The widget pulls live data every time it loads. New trips appear automatically — zero maintenance required." } },
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Graeagle Golf Trip Pricing Widget",
    "applicationCategory": "TravelApplication",
    "operatingSystem": "Web",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "description": "A free embeddable widget showing real Graeagle golf trip packages with photos, verified pricing, lodging, and course details.",
    "url": "https://golfgraeagle.com/trips-widget/",
    "provider": { "@id": "https://golfgraeagle.com/#organization" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteConfig.url },
      { "@type": "ListItem", "position": 2, "name": "Embed Widget", "item": canonicalUrl }
    ]
  }
];
---
<Base title={title} description={description} schema={schema} canonical={canonicalUrl} ogImage={ogImage} bodyClass="light-page">
  <Nav />
  <main class="ew">

    <!-- HERO -->
    <section class="ew-hero">
      <div class="ew-hero-inner">
        <p class="ew-eyebrow">Free Tool for Golf & Travel Websites</p>
        <h1 class="speakable ew-h1">Embed Real Graeagle Golf<br class="ew-br-mob"/> Trip Pricing on Your Site</h1>
        <p class="aeo-answer ew-hero-sub">One iframe. Live photos and pricing from real completed trips. Auto-updates. Free forever.</p>
        <div class="ew-hero-btns">
          <a href="#get-the-code" class="ew-btn-gold">Get the embed code ↓</a>
          <a href="https://golfgraeagle.com/trips-widget/" target="_blank" rel="noopener" class="ew-btn-ghost">Preview live widget ↗</a>
        </div>
        <p class="ew-golfer-nudge">Planning your own trip? <a href="/request-a-quote/" class="ew-golfer-link">Get a free quote →</a></p>
      </div>
    </section>

    <!-- STATS STRIP -->
    <div class="ew-stats">
      {[
        { n: '22+', l: 'Real trips' },
        { n: '$379', l: 'From' },
        { n: '$1,705', l: 'Up to' },
        { n: '5', l: 'Courses' },
        { n: 'Free', l: 'To embed' },
      ].map(s => (
        <div class="ew-stat">
          <strong class="ew-stat-n">{s.n}</strong>
          <span class="ew-stat-l">{s.l}</span>
        </div>
      ))}
    </div>

    <!-- TRIP CARDS — the actual preview, visually stunning -->
    <section class="ew-cards-section">
      <div class="ew-wrap">
        <p class="ew-label">Live preview — real data</p>
        <h2 class="ew-h2" data-speakable>This is what your readers will see</h2>
        <p class="ew-sub">Every card below is a real completed Graeagle golf trip with a real photo, real price, and real courses. This is the actual widget data.</p>
      </div>

      <div class="ew-cards-grid">
        {featuredTrips.map((trip, i) => {
          const vc = vibeColors[trip.vibe] || vibeColors['Value'];
          return (
            <article class="ew-card" style={i >= 3 ? 'display:none;' : ''} data-extra={i >= 3 ? 'true' : 'false'}>
              <!-- Photo -->
              <div class="ew-card-img-wrap">
                <img
                  src={trip.image}
                  alt={`Graeagle golf trip — ${trip.courses[0]}`}
                  class="ew-card-img"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  width="420"
                  height="240"
                />
                <div class="ew-card-img-overlay">
                  <span class="ew-vibe-badge" style={`background:${vc.bg};color:${vc.text};border:1px solid ${vc.border};`}>{trip.vibe}</span>
                  <div class="ew-card-price-hero">${trip.price}<span class="ew-per">/person</span></div>
                </div>
              </div>

              <!-- Content -->
              <div class="ew-card-body">
                <!-- Meta row -->
                <div class="ew-card-meta">
                  <span class="ew-meta-chip">🌙 {trip.nights} nights</span>
                  <span class="ew-meta-chip">👥 {trip.golfers} golfers</span>
                  <span class="ew-meta-chip">⛳ {trip.rounds} rounds</span>
                  <span class="ew-meta-chip">📅 {trip.month}</span>
                </div>

                <!-- Courses -->
                <div class="ew-card-courses-label">Courses played</div>
                <div class="ew-card-courses">
                  {trip.courses.map((c, ci) => (
                    <span class="ew-course-tag">{c}{ci < trip.courses.length - 1 ? '' : ''}</span>
                  ))}
                </div>

                <!-- Lodging -->
                <div class="ew-card-lodging">
                  <span class="ew-lodging-icon">🏠</span>
                  <span class="ew-lodging-text">{trip.lodging}</span>
                </div>

                <!-- Synopsis -->
                <p class="ew-card-synopsis">{trip.synopsis}</p>

                <!-- Highlights -->
                <ul class="ew-card-highlights">
                  {trip.highlights.map(h => <li>{h}</li>)}
                </ul>

                <!-- Footer CTA -->
                <div class="ew-card-footer">
                  <a href={`/portfolio/${trip.slug}/`} class="ew-card-learn">View {trip.courses[0].split(' ')[0]} packages</a>
                  <a href="/request-a-quote/" class="ew-card-cta">Plan Similar →</a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Show more -->
      <div class="ew-show-more-wrap" id="show-more-wrap">
        <button class="ew-show-more" id="show-more-btn" onclick="document.querySelectorAll('[data-extra=true]').forEach(function(el){el.style.display='';});document.getElementById('show-more-wrap').style.display='none';">
          Show {featuredTrips.length - 3} more real trips ↓
        </button>
      </div>

      <div class="ew-wrap ew-cards-footer">
        <p class="ew-cards-note">These are 6 of 22+ real completed Graeagle golf trips in our archive. The live widget loads all of them automatically.</p>
        <a href="/request-a-quote/" class="btn-green-glow ew-main-cta">Build your own Graeagle trip — free quote →</a>
      </div>
    </section>

    <!-- HOW TO EMBED -->
    <section id="get-the-code" class="ew-steps-section">
      <div class="ew-wrap">
        <p class="ew-label">For golf bloggers & travel writers</p>
        <h2 class="ew-h2" data-speakable>Embed all of this on your site in 3 steps</h2>
        <p class="ew-sub">Works on WordPress, Squarespace, Wix, Webflow, plain HTML. Under 2 minutes.</p>

        <div class="ew-steps">

          <div class="ew-step">
            <div class="ew-step-n">1</div>
            <div class="ew-step-body">
              <h3 class="ew-step-h3">Copy this code</h3>
              <div class="ew-code-wrap">
                <pre id="embed-code" class="ew-code">{`<iframe
  src="https://golfgraeagle.com/trips-widget/"
  width="100%"
  height="560"
  frameborder="0"
  style="border-radius:12px;"
  title="Real Graeagle Golf Trip Packages"
></iframe>`}</pre>
                <button class="ew-copy" onclick="var t=document.getElementById('embed-code').textContent;navigator.clipboard.writeText(t).then(function(){var b=document.querySelector('.ew-copy');b.textContent='✓ Copied!';b.style.background='#3a8a48';b.style.color='#fff';setTimeout(function(){b.textContent='Copy';b.style.background='#e8a850';b.style.color='#1a2e1a'},2000)})">Copy</button>
              </div>
            </div>
          </div>

          <div class="ew-step">
            <div class="ew-step-n">2</div>
            <div class="ew-step-body">
              <h3 class="ew-step-h3">Paste into your page</h3>
              <div class="ew-platforms">
                {platforms.map(p => (
                  <div class="ew-platform">
                    <div class="ew-p-name">{p.name}</div>
                    <div class="ew-p-how">{p.how}</div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="ew-step">
            <div class="ew-step-n">3</div>
            <div class="ew-step-body">
              <h3 class="ew-step-h3">Publish</h3>
              <p class="ew-step-p">Done. The widget loads all 22+ trips automatically. When new packages are added to our archive, they appear in your widget — you never touch it again.</p>
              <div class="ew-tip">💡 <strong>Best placement:</strong> Right after a paragraph about Graeagle golf trip costs. It answers the question your reader just asked — before they leave to search elsewhere.</div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- WHY -->
    <section class="ew-why-section">
      <div class="ew-wrap">
        <h2 class="ew-h2" data-speakable>Why travel writers embed it</h2>
        <div class="ew-why-grid">
          {[
            { icon: '📸', title: 'Real photos, real data', body: 'Not stock photos. Every card shows an actual photo from that specific trip, with real pricing, real courses, and real lodging. Your readers trust specifics.' },
            { icon: '⏱️', title: 'Zero maintenance', body: 'Paste once. Auto-updates forever. No broken links, no outdated numbers, no annual "refresh this post" on your calendar.' },
            { icon: '⛳', title: 'Useful for real golfers', body: 'Lodging names, course lists, group sizes, highlights — everything a golfer comparing trips actually needs. Not just a price.' },
            { icon: '🔗', title: 'Your readers get answers', body: 'Every card links directly to GolfGraeagle.com\'s quote form. They go from your article to a real booking conversation without Googling anything.' },
          ].map(w => (
            <div class="ew-why-card">
              <div class="ew-why-icon">{w.icon}</div>
              <h3 class="ew-why-h3">{w.title}</h3>
              <p class="ew-why-body">{w.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="ew-faq-section">
      <div class="ew-wrap ew-faq-wrap">
        <h2 class="ew-h2">Questions</h2>
        {[
          { q: 'Is it free?', a: 'Yes. No cost, no account, no strings. The widget is free to embed on any site.' },
          { q: 'Will it slow my site?', a: 'No. Loads inside an iframe — completely isolated from your page. No effect on your speed scores or Core Web Vitals.' },
          { q: 'Can I change the height?', a: 'Yes. Change height="560" to whatever fits your layout. 400 for compact, 700+ to show more cards without scrolling inside the iframe.' },
          { q: 'Does it work on mobile?', a: 'Yes. The widget is fully responsive — cards stack to single column on small screens automatically.' },
          { q: 'Does GolfGraeagle track my visitors?', a: 'No. The widget does not set cookies or track your visitors. It only loads trip data from our archive.' },
          { q: 'Can I get a custom version?', a: 'Email mike.eskuchen@golfthehighsierra.com — we\'re happy to discuss custom implementations for larger platforms.' },
        ].map(f => (
          <details class="ew-faq">
            <summary class="ew-faq-q">{f.q}<span class="ew-faq-plus">+</span></summary>
            <p class="ew-faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- DUAL CTA -->
    <section class="ew-cta-section">
      <div class="ew-wrap ew-cta-grid">
        <div class="ew-cta-writer">
          <div class="ew-cta-icon">✍️</div>
          <h3 class="ew-cta-h3">You're a golf writer or blogger</h3>
          <p class="ew-cta-p">Add real Graeagle trip pricing to your content in 30 seconds. Free, one line of code.</p>
          <a href="#get-the-code" class="ew-cta-btn-outline">Get the embed code ↑</a>
        </div>
        <div class="ew-cta-golfer">
          <div class="ew-cta-icon">⛳</div>
          <h3 class="ew-cta-h3" style="color:#f0ece3;">You're planning a Graeagle trip</h3>
          <p class="ew-cta-p" style="color:rgba(240,236,227,0.65);">Mike Eskuchen builds every package personally. Free quote, 24-hour response. 4.8/5 from 672 verified trips.</p>
          <a href="/request-a-quote/" class="btn-green-glow">Get a free quote →</a>
          <p class="ew-cta-tel"><a href="tel:+18885861157">(888) 586-1157</a></p>
        </div>
      </div>
    </section>

  </main>

  <style>
    .ew { background: #fff; }

    /* Hero */
    .ew-hero { background: linear-gradient(160deg,#0d1a0e 0%,#1a3020 65%,#0d2010 100%); padding: clamp(52px,9vw,100px) 20px clamp(44px,7vw,80px); text-align: center; }
    .ew-hero-inner { max-width: 660px; margin: 0 auto; }
    .ew-eyebrow { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.14em; color: #e8a850; margin: 0 0 14px; }
    .ew-h1 { font-family:'Playfair Display',serif; font-size: clamp(26px,6vw,50px); line-height: 1.12; color: #f0ece3; margin: 0 0 16px; }
    .ew-br-mob { display: none; }
    .ew-hero-sub { font-size: clamp(15px,2.5vw,18px); color: rgba(240,236,227,0.72); line-height: 1.6; margin: 0 0 28px; }
    .ew-hero-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 18px; }
    .ew-btn-gold { display: inline-block; background: #e8a850; color: #1a2e1a; font-size: 15px; font-weight: 700; padding: 13px 28px; border-radius: 100px; text-decoration: none; }
    .ew-btn-ghost { display: inline-block; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2); color: #f0ece3; font-size: 15px; font-weight: 600; padding: 13px 28px; border-radius: 100px; text-decoration: none; }
    .ew-golfer-nudge { font-size: 13px; color: rgba(240,236,227,0.4); margin: 0; }
    .ew-golfer-link { color: #e8a850; text-decoration: none; font-weight: 600; }

    /* Stats strip */
    .ew-stats { display: flex; background: #f0f8f0; border-bottom: 1px solid #d4edd4; }
    .ew-stat { flex: 1; padding: 14px 8px; text-align: center; border-right: 1px solid #d4edd4; display: flex; flex-direction: column; gap: 2px; }
    .ew-stat:last-child { border-right: none; }
    .ew-stat-n { font-size: clamp(16px,3vw,22px); font-weight: 800; color: #1a2e1a; display: block; }
    .ew-stat-l { font-size: 10px; color: #5a7060; text-transform: uppercase; letter-spacing: 0.07em; display: block; }

    /* Layout */
    .ew-wrap { max-width: 900px; margin: 0 auto; padding: 0 20px; }
    .ew-label { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: #a06c30; margin: 0 0 10px; }
    .ew-h2 { font-family:'Playfair Display',serif; font-size: clamp(22px,4vw,34px); color: #1a2e1a; margin: 0 0 12px; }
    .ew-sub { font-size: 15px; color: #5a7060; line-height: 1.65; margin: 0 0 32px; }

    /* Cards section */
    .ew-cards-section { padding: clamp(48px,7vw,80px) 0 0; }
    .ew-cards-grid { max-width: 1100px; margin: 0 auto; padding: 0 20px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 24px; }

    /* Individual card */
    .ew-card { background: #fff; border: 1px solid #e0ece0; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 2px 12px rgba(26,46,26,0.06); transition: box-shadow 0.2s, transform 0.2s; }
    .ew-card:hover { box-shadow: 0 8px 32px rgba(26,46,26,0.14); transform: translateY(-2px); }

    /* Card photo */
    .ew-card-img-wrap { position: relative; aspect-ratio: 16/9; overflow: hidden; }
    .ew-card-img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ew-card-img-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,20,10,0.75) 0%, rgba(10,20,10,0.1) 50%, transparent 100%); display: flex; align-items: flex-end; justify-content: space-between; padding: 12px 14px; }
    .ew-vibe-badge { font-size: 10px; font-weight: 700; padding: 3px 10px; border-radius: 100px; }
    .ew-card-price-hero { font-size: 24px; font-weight: 800; color: #fff; text-shadow: 0 1px 4px rgba(0,0,0,0.4); }
    .ew-per { font-size: 12px; font-weight: 400; opacity: 0.85; }

    /* Card body */
    .ew-card-body { padding: 16px; flex: 1; display: flex; flex-direction: column; gap: 10px; }
    .ew-card-meta { display: flex; gap: 5px; flex-wrap: wrap; }
