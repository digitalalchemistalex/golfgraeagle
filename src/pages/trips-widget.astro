---
export const prerender = false;
import { fetchTripStats } from '../lib/tripStats';
const { trips, tripCount, minPrice, maxPrice } = await fetchTripStats();

// Only use real trips with pricing data
const realTrips = (trips || [])
  .filter((t: any) => t.price_per_person && t.courses?.length > 0)
  .slice(0, 12);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Graeagle Golf Trips — Real Packages with Pricing</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: transparent;
      color: #1a2e1a;
    }
    .widget-wrap {
      max-width: 100%;
      padding: 0;
    }
    .widget-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 0 20px;
      border-bottom: 2px solid #e0ece0;
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 10px;
    }
    .widget-title {
      font-size: 18px;
      font-weight: 700;
      color: #1a2e1a;
    }
    .widget-meta {
      font-size: 13px;
      color: #5a7060;
    }
    .widget-badge {
      background: #3a8a4822;
      color: #1a6030;
      padding: 4px 12px;
      border-radius: 100px;
      font-size: 12px;
      font-weight: 700;
    }
    .trips-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 14px;
    }
    .trip-card {
      border: 1px solid #ddeedd;
      border-radius: 12px;
      padding: 16px;
      background: #fff;
      transition: box-shadow 0.15s;
    }
    .trip-card:hover {
      box-shadow: 0 4px 16px rgba(26,46,26,0.1);
    }
    .trip-courses {
      font-size: 12px;
      font-weight: 700;
      color: #3a8a48;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 8px;
    }
    .trip-courses-list {
      font-size: 14px;
      font-weight: 600;
      color: #1a2e1a;
      margin-bottom: 10px;
      line-height: 1.4;
    }
    .trip-meta-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 10px;
    }
    .trip-badge {
      font-size: 11px;
      padding: 3px 9px;
      border-radius: 100px;
      background: #f0f8f0;
      color: #3a6a40;
      border: 1px solid #c8e8c8;
    }
    .trip-price {
      font-size: 20px;
      font-weight: 800;
      color: #1a2e1a;
    }
    .trip-price-label {
      font-size: 11px;
      color: #8a9a8e;
      font-weight: 400;
    }
    .trip-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid #e8f0e8;
    }
    .trip-cta {
      font-size: 12px;
      font-weight: 700;
      color: #3a8a48;
      text-decoration: none;
    }
    .powered-by {
      text-align: center;
      padding: 20px 0 4px;
      font-size: 12px;
      color: #8a9a8e;
    }
    .powered-by a {
      color: #3a8a48;
      font-weight: 700;
      text-decoration: none;
    }
  </style>
</head>
<body>
<div class="widget-wrap">
  <div class="widget-header">
    <div>
      <div class="widget-title">Real Graeagle Golf Trips</div>
      <div class="widget-meta">Actual packages with verified pricing</div>
    </div>
    <span class="widget-badge">{tripCount} trips · from ${minPrice}/person</span>
  </div>

  <div class="trips-grid">
    {realTrips.length > 0 ? realTrips.map((trip: any) => (
      <div class="trip-card">
        <div class="trip-courses">Courses Played</div>
        <div class="trip-courses-list">
          {(trip.courses || []).slice(0, 3).join(' · ')}
          {trip.courses?.length > 3 && ` +${trip.courses.length - 3} more`}
        </div>
        <div class="trip-meta-row">
          {trip.nights && <span class="trip-badge">{trip.nights} nights</span>}
          {trip.group_size && <span class="trip-badge">{trip.group_size} golfers</span>}
          {trip.rounds && <span class="trip-badge">{trip.rounds} rounds</span>}
        </div>
        <div class="trip-footer">
          <div>
            <div class="trip-price">${trip.price_per_person}<span class="trip-price-label">/person</span></div>
          </div>
          <a href="https://golfgraeagle.com/request-a-quote/" target="_blank" rel="noopener" class="trip-cta">Plan Similar →</a>
        </div>
      </div>
    )) : (
      <div style="grid-column:1/-1;text-align:center;padding:40px;color:#5a7060;">
        Loading trip data...
      </div>
    )}
  </div>

  <div class="powered-by">
    Powered by <a href="https://golfgraeagle.com" target="_blank" rel="noopener">GolfGraeagle.com</a> — Graeagle golf trip specialists since 2004
  </div>
</div>
</body>
</html>
