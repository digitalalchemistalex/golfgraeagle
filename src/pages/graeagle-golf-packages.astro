.gp-faq-icon{font-size:24px;color:var(--gp-gold);flex-shrink:0;transition:transform .3s}
.gp-faq[open] .gp-faq-icon{transform:rotate(45deg)}
.gp-faq-a{font-size:14px;color:var(--gp-muted);line-height:1.82;padding:0 0 20px;margin:0}

/* FINAL CTA */
.gp-cta-final{padding:clamp(80px,10vw,132px) 0;position:relative;overflow:hidden}
.gp-cta-glow{position:absolute;width:720px;height:720px;border-radius:50%;background:radial-gradient(circle,rgba(26,122,64,.18) 0%,transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none}
.gp-cta-h2{font-family:'Playfair Display',serif;font-size:clamp(28px,5vw,54px);color:#f5f0e8;font-weight:500;line-height:1.15;margin:0 0 18px}
.gp-cta-h2 em{color:var(--gp-gold);font-style:italic}
.gp-cta-sub{font-size:16px;color:rgba(245,240,232,.76);line-height:1.75;margin:0 0 36px}

/* MOBILE */
@media(max-width:1000px){
