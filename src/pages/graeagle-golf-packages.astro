<style>
/* ─── Variables ─────────────────────────────── */
:root{
  --gp-gold:#e8a850;--gp-green:#1a7a40;--gp-dark:#0d1a0e;
  --gp-text:#1c1208;--gp-muted:rgba(28,18,8,0.52);
  --gp-border:rgba(28,18,8,0.08);--gp-r:20px;
}
/* ─── Layout ─────────────────────────────────── */
.gp-container{max-width:1140px;margin:0 auto;padding:0 clamp(20px,6%,80px)}
.gp-section{padding:clamp(72px,9vw,120px) 0;background:var(--page-bg,#f0ece3)}
.gp-dark{background:var(--gp-dark)!important}
.gp-alt{background:#f8f5f0}
.gp-header{text-align:center;margin-bottom:clamp(40px,5vw,68px)}
.gp-h2{font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,50px);font-weight:500;color:var(--gp-text);line-height:1.1;margin:8px 0 0}
.gp-h2 em{font-style:italic;color:var(--gp-green)}
.gp-subhead{font-size:16px;color:var(--gp-muted);line-height:1.75;margin:20px auto 0;max-width:700px}

/* ─── Hero ───────────────────────────────────── */
.gp-hero{position:relative;min-height:94vh;display:flex;align-items:flex-end;overflow:hidden}
.gp-bg{position:absolute;inset:0;background-size:cover;background-position:center 35%;transform:scale(1.07);animation:gpZoom 12s ease forwards}
@keyframes gpZoom{to{transform:scale(1)}}
.gp-overlay{position:absolute;inset:0;background:linear-gradient(165deg,rgba(13,26,14,.04) 0%,rgba(13,26,14,.48) 38%,rgba(13,26,14,.97) 100%)}
.gp-hero-inner{position:relative;z-index:2;padding:0 clamp(24px,8%,120px) clamp(60px,8vw,108px);max-width:900px}
.gp-eyebrow{font-size:10px;font-weight:700;letter-spacing:.24em;text-transform:uppercase;color:rgba(232,168,80,.8);margin:0 0 18px}
.gp-h1{font-family:'Playfair Display',serif;font-size:clamp(44px,7.5vw,94px);font-weight:500;color:#f5f0e8;line-height:.97;margin:0 0 22px}
.gp-h1 em{font-style:italic;color:var(--gp-gold)}

/* AEO answer block — machine-readable, human-friendly */
.gp-aeo-answer{font-size:clamp(15px,1.8vw,18px);color:rgba(245,240,232,.72);line-height:1.65;margin:0 0 28px;max-width:740px;border-left:3px solid rgba(232,168,80,.4);padding-left:20px}
.gp-aeo-answer p{margin:0}

.gp-pills{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px}
.gp-pills span{font-size:12px;font-weight:600;color:rgba(245,240,232,.82);padding:6px 16px;background:rgba(255,255,255,.1);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.18);border-radius:100px}
.gp-pills strong{color:var(--gp-gold)}
.gp-ctas{display:flex;gap:20px;align-items:center;flex-wrap:wrap;margin-bottom:14px}
.gp-btn{display:inline-block;padding:15px 38px;border-radius:100px;font-size:15px;font-weight:700;text-decoration:none;letter-spacing:.01em}
.gp-ghost{font-size:14px;font-weight:600;color:rgba(232,168,80,.9);text-decoration:none}
.gp-ghost-green{font-size:15px;font-weight:600;color:var(--gp-green);text-decoration:none}
.gp-trust{font-size:12px;color:rgba(245,240,232,.32);margin:0}
.gp-floats{position:absolute;right:clamp(24px,5%,72px);bottom:clamp(56px,8vw,96px);display:flex;flex-direction:column;gap:10px;z-index:3}
