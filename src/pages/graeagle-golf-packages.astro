---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import RelatedTrips from '../components/RelatedTrips.tsx';
import { fetchTripStats } from '../lib/tripStats';

const { minPrice, maxPrice, tripCount, trips: allTrips } = await fetchTripStats();

// Real completed packages for social proof — sorted cheapest to most expensive
const proofTrips = allTrips
  .filter((t: any) => t.pricePerPerson && t.whyItWorked && t.nights >= 2)
  .sort((a: any, b: any) => a.pricePerPerson - b.pricePerPerson)
  .slice(0, 3);

// ── SEO / AEO / Meta ────────────────────────────────────────────────────────
const title = "Graeagle Golf Packages | Stay & Play from $299/Golfer | GolfGraeagle.com";
const description = `Custom Graeagle golf packages from $${minPrice}/golfer — guaranteed tee times at all 5 championship courses, lodging, and full itinerary. Golf Digest Top 100, Frank Lloyd Wright clubhouse. Groups 2–200+. Free quote in 24 hours.`;
const QUOTE_URL = '/request-a-quote/?ref=graeagle-golf-packages';
const OG_IMAGE = 'https://golfgraeagle.com/wp-images/grizzly-ranch-hero.webp';

// ── Schema: Full @graph with every relevant type ────────────────────────────
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What do Graeagle golf packages include?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Graeagle golf packages from GolfGraeagle.com include guaranteed tee times at your chosen courses, lodging matched to your group size, and a day-by-day itinerary. All 5 championship courses are available — including semi-private Grizzly Ranch and Nakoma Dragon, which are not bookable directly by the public. Dining reservations are available on request. Packages start from $299 per golfer for groups of 2 to 200+."
      }
    },
    {
      "@type": "Question",
      "name": "How much does a Graeagle golf package cost per person?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Real completed Graeagle golf packages range from $${minPrice} to $${maxPrice} per person. Most 2-night, 3-course packages for groups of 8–24 golfers come in between $620 and $875 per person including lodging and tee times. Larger groups of 30+ typically receive better per-person rates. The price varies based on number of nights, courses selected, lodging property, and group size.`
      }
    },
    {
      "@type": "Question",
      "name": "What golf courses are included in Graeagle golf packages?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GolfGraeagle packages include any combination of the five Graeagle championship courses: Grizzly Ranch Golf Club (Golf Digest Top 100 Greatest Public Courses, 2021), Whitehawk Ranch Golf Course (Top 20 California), Plumas Pines Golf Resort (Top 5 Best Value Sierra Nevada), Graeagle Meadows Golf Course (par 72, open to all levels), and Nakoma — The Dragon (Golf World Top 75, the only golf clubhouse designed by Frank Lloyd Wright). All five courses are within 25 minutes of each other in Plumas County, Northern California."
      }
    },
    {
      "@type": "Question",
      "name": "Can GolfGraeagle book Grizzly Ranch tee times for groups?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Grizzly Ranch Golf Club is semi-private and cannot be booked directly by the public for group play. GolfGraeagle has a direct relationship with the Grizzly Ranch pro shop and secures guaranteed tee times as part of every stay-and-play package. Grizzly Ranch tee times release 30 days in advance and fill within days during peak season."
      }
    },
    {
      "@type": "Question",
      "name": "How far in advance should I book a Graeagle golf package?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For summer weekends (June through August), book 4 to 6 weeks in advance. Grizzly Ranch semi-private tee times release 30 days out and fill within days during peak season. Spring and fall (May, September, October) can typically be arranged 2 to 3 weeks in advance. GolfGraeagle handles all tee time booking — submit a quote request and receive a full package proposal within 24 hours."
      }
    },
    {
      "@type": "Question",
      "name": "When is the best time of year for a Graeagle golf package?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "September and October are the best months for a Graeagle golf package — peak course conditions, fall foliage on the Sierra Nevada slopes, fewer crowds after Labor Day, and the same championship courses without summer pricing. June through August is peak season with the longest days. May offers uncrowded courses and spring conditions. Graeagle Meadows Golf Course opens in April; all five courses are typically open from late May through October or early November."
      }
    },
    {
      "@type": "Question",
      "name": "How does Graeagle compare to Lake Tahoe for a golf trip?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Graeagle has five championship courses within 25 minutes of each other versus Lake Tahoe's courses spread across a 60-mile radius. Graeagle packages typically run 30 to 40 percent less than comparable Lake Tahoe golf packages while offering the same Sierra Nevada elevation (4,000 to 5,400 feet), mountain scenery, and championship conditioning. Graeagle also includes Grizzly Ranch (Golf Digest Top 100) and Nakoma Dragon (Frank Lloyd Wright clubhouse) — two courses with no equivalent near Lake Tahoe. Graeagle is approximately 1.5 hours from North Lake Tahoe via Highway 89."
      }
    },
    {
      "@type": "Question",
      "name": "How far is Graeagle from Sacramento, Reno, and San Francisco?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Graeagle is approximately 2.5 hours northeast of Sacramento via I-80 East to Highway 89 North, approximately 1 hour west of Reno, Nevada via Highway 395 to Highway 70, and approximately 3.5 to 4 hours northeast of San Francisco via I-80 East. Reno-Tahoe International Airport (RNO) is the closest major airport, roughly 1 hour from Graeagle."
      }
    }
  ]
};

