.gp-lodge-name{font-family:'Playfair Display',serif;font-size:17px;color:var(--gp-text);margin-bottom:8px}
.gp-lodge-desc{font-size:13px;color:var(--gp-muted);line-height:1.7;margin:0 0 14px}

/* PROOF */
.gp-proof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:48px}
.gp-proof-card{background:rgba(255,255,255,.7);border:1px solid rgba(28,18,8,.08);border-radius:18px;padding:28px 24px;display:flex;flex-direction:column;gap:14px;box-shadow:0 4px 24px rgba(28,18,8,.06)}
.gp-proof-top{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.gp-proof-pax{background:rgba(26,122,64,.1);color:#1a7a40;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;padding:4px 10px;border-radius:20px}
.gp-proof-nights{font-size:13px;color:rgba(28,18,8,.5);font-weight:600}
.gp-proof-price{margin-left:auto;font-family:'Playfair Display',serif;font-size:22px;color:#1c1208}
.gp-proof-courses{font-size:13px;color:rgba(28,18,8,.6);line-height:1.5}
.gp-proof-why{font-size:14px;color:rgba(28,18,8,.75);line-height:1.65;font-style:italic;flex:1}
.gp-proof-mike{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:rgba(26,122,64,.7)}

/* WHY GRID */
.gp-why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.gp-why-card{padding:28px 24px;border-radius:16px;border:1px solid rgba(245,240,232,.08);background:rgba(255,255,255,.05);transition:all .35s}
.gp-why-card:hover{border-color:rgba(232,168,80,.2);transform:translateY(-3px)}
.gp-why-stat{font-family:'Playfair Display',serif;font-size:26px;color:var(--gp-gold);font-weight:400;margin-bottom:4px}
.gp-why-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:rgba(245,240,232,.5);margin-bottom:12px}
.gp-why-body{font-size:13px;color:rgba(245,240,232,.65);line-height:1.75;margin:0}

/* MIKE */
.gp-mike-wrap{display:grid;grid-template-columns:1fr 400px;gap:72px;align-items:center}
.gp-mike-body{font-size:15px;color:var(--gp-muted);line-height:1.8;margin:16px 0 0}
.gp-mike-list{list-style:none;padding:0;margin:20px 0 0;display:flex;flex-direction:column;gap:8px}
.gp-mike-list li{font-size:14px;color:var(--gp-muted)}
.gp-mike-img{position:relative;border-radius:22px;overflow:hidden;box-shadow:0 32px 80px rgba(0,0,0,.18)}
.gp-mike-img img{width:100%;height:460px;object-fit:cover;object-position:top;display:block}
.gp-mike-badge{position:absolute;bottom:20px;left:20px;right:20px;background:rgba(13,26,14,.88);backdrop-filter:blur(14px);border:1px solid rgba(232,168,80,.22);border-radius:14px;padding:14px 18px}
.gp-mike-name{font-family:'Playfair Display',serif;font-size:18px;color:#f5f0e8;font-weight:400;margin-bottom:4px}
.gp-mike-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:rgba(232,168,80,.8)}

/* FAQ */
.gp-faqs{display:flex;flex-direction:column}
.gp-faq{border-bottom:1px solid var(--gp-border)}
.gp-faq[open]{background:rgba(232,168,80,.03);border-radius:12px;border-color:rgba(232,168,80,.22)}
.gp-faq-q{font-size:15px;font-weight:600;color:var(--gp-text);padding:20px 0;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px}
.gp-faq-q::-webkit-details-marker{display:none}
