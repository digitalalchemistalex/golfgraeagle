<style>
:root{--gp-gold:#e8a850;--gp-green:#1a7a40;--gp-dark:#0d1a0e;--gp-text:#1c1208;--gp-muted:rgba(28,18,8,0.52);--gp-border:rgba(28,18,8,0.08);--gp-r:20px}
.gp-container{max-width:1140px;margin:0 auto;padding:0 clamp(20px,6%,80px)}
.gp-section{padding:clamp(72px,9vw,120px) 0;background:var(--page-bg,#f0ece3)}
.gp-dark{background:var(--gp-dark)!important}
.gp-alt{background:#f8f5f0}
.gp-header{text-align:center;margin-bottom:clamp(40px,5vw,68px)}
.gp-h2{font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,50px);font-weight:500;color:var(--gp-text);line-height:1.1;margin:8px 0 0}
.gp-h2 em{font-style:italic;color:var(--gp-green)}
.gp-subhead{font-size:16px;color:var(--gp-muted);line-height:1.7;margin:20px auto 0;max-width:680px}

/* HERO */
.gp-hero{position:relative;min-height:92vh;display:flex;align-items:flex-end;overflow:hidden}
.gp-bg{position:absolute;inset:0;background-size:cover;background-position:center 35%;transform:scale(1.07);animation:gpZoom 10s ease forwards}
@keyframes gpZoom{to{transform:scale(1)}}
.gp-overlay{position:absolute;inset:0;background:linear-gradient(160deg,rgba(13,26,14,.05) 0%,rgba(13,26,14,.5) 40%,rgba(13,26,14,.97) 100%)}
.gp-hero-inner{position:relative;z-index:2;padding:0 clamp(24px,8%,120px) clamp(60px,8vw,100px);max-width:860px}
.gp-eyebrow{font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:rgba(232,168,80,.82);margin:0 0 18px}
.gp-h1{font-family:'Playfair Display',serif;font-size:clamp(42px,7vw,88px);font-weight:500;color:#f5f0e8;line-height:.98;margin:0 0 18px}
.gp-h1 em{font-style:italic;color:var(--gp-gold)}
.gp-sub{font-size:clamp(15px,2vw,20px);color:rgba(245,240,232,.62);line-height:1.6;margin:0 0 26px}
.gp-pills{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px}
.gp-pills span{font-size:12px;font-weight:600;color:rgba(245,240,232,.8);padding:6px 15px;background:rgba(255,255,255,.1);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.18);border-radius:100px}
.gp-pills strong{color:var(--gp-gold)}
.gp-ctas{display:flex;gap:20px;align-items:center;flex-wrap:wrap;margin-bottom:16px}
.gp-btn{display:inline-block;padding:15px 36px;border-radius:100px;font-size:15px;font-weight:700;text-decoration:none}
.gp-ghost{font-size:14px;font-weight:600;color:rgba(232,168,80,.9);text-decoration:none}
.gp-ghost-green{font-size:15px;font-weight:600;color:var(--gp-green);text-decoration:none}
.gp-trust{font-size:12px;color:rgba(245,240,232,.35);margin:0}
.gp-floats{position:absolute;right:clamp(24px,5%,72px);bottom:clamp(56px,8vw,90px);display:flex;flex-direction:column;gap:10px;z-index:3}
.gp-float{background:rgba(255,255,255,.1);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.2);border-radius:16px;padding:14px 22px;text-align:center;min-width:116px}
.gp-float-val{font-family:'Playfair Display',serif;font-size:22px;color:var(--gp-gold);font-weight:400;line-height:1}
.gp-float-lbl{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.14em;color:rgba(245,240,232,.45);margin-top:5px}

/* INCLUDED */
.gp-included{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(240px,45vw),1fr));gap:24px}
.gp-inc-card{border-radius:var(--gp-r);padding:28px 24px;border:1px solid var(--gp-border);background:#fff;box-shadow:0 2px 12px rgba(0,0,0,.04);transition:all .35s}
.gp-inc-card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(0,0,0,.08);border-color:rgba(232,168,80,.25)}
.gp-inc-icon{font-size:32px;margin-bottom:12px}
.gp-inc-title{font-size:15px;font-weight:700;color:var(--gp-text);margin-bottom:8px}
.gp-inc-body{font-size:13px;color:var(--gp-muted);line-height:1.75;margin:0}

/* TABLE */
.gp-table-wrap{overflow-x:auto;border-radius:12px;border:1px solid var(--gp-border);box-shadow:0 2px 12px rgba(0,0,0,.04)}
.gp-table{width:100%;border-collapse:collapse;background:#fff;font-size:14px}
.gp-table thead th{background:#1a2e1a;color:#f5f0e8;padding:14px 20px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;white-space:nowrap}
.gp-table tbody td{padding:14px 20px;border-bottom:1px solid var(--gp-border);color:var(--gp-text);vertical-align:middle}
.gp-table tbody tr:last-child td{border-bottom:none}
.gp-table tbody tr:hover td{background:rgba(232,168,80,.04)}
.gp-course-link{color:var(--gp-green);font-weight:600;text-decoration:none}
.gp-course-link:hover{text-decoration:underline}
.gp-access{font-size:11px;font-weight:700;padding:3px 10px;border-radius:100px;text-transform:uppercase;letter-spacing:.06em}
.gp-access-pub{background:rgba(26,122,64,.1);color:#1a7a40}
.gp-access-pkg{background:rgba(232,168,80,.15);color:#8a6008}

/* COURSE CARDS */
.gp-courses{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
.gp-course-card{border-radius:var(--gp-r);overflow:hidden;background:#fff;border:1px solid var(--gp-border);box-shadow:0 2px 10px rgba(0,0,0,.04);transition:all .35s;flex:0 0 220px}
.gp-course-card:hover{transform:translateY(-5px);box-shadow:0 20px 48px rgba(0,0,0,.1);border-color:rgba(232,168,80,.3)}
.gp-course-img-wrap{position:relative;height:170px;overflow:hidden}
.gp-course-img{width:100%;height:100%;object-fit:cover;transition:transform 6s ease}
.gp-course-card:hover .gp-course-img{transform:scale(1.06)}
.gp-course-fade{position:absolute;inset:0;background:linear-gradient(to top,rgba(13,26,14,.82) 0%,transparent 55%)}
.gp-course-badge{position:absolute;top:10px;left:10px;font-size:8px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;background:rgba(232,168,80,.92);color:#0d1a0e;padding:3px 8px;border-radius:100px}
.gp-course-stats{position:absolute;bottom:10px;left:10px;display:flex;gap:6px}
