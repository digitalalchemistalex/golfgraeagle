.gp-course-body{padding:14px 16px 18px}
.gp-course-name{font-family:'Playfair Display',serif;font-size:14px;color:var(--gp-text);margin-bottom:5px}
.gp-course-line{font-size:12px;color:var(--gp-muted);line-height:1.6;margin:0 0 10px}
.gp-course-cta{font-size:11px;font-weight:600;color:var(--gp-green);text-decoration:none}

/* PACKAGES */
.gp-pkgs{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;max-width:900px;margin:0 auto}
.gp-pkg-card{border-radius:var(--gp-r);padding:36px 28px;border:1px solid rgba(245,240,232,.08);background:rgba(255,255,255,.06);position:relative;transition:all .35s}
.gp-pkg-card:hover{transform:translateY(-5px);border-color:rgba(232,168,80,.25)}
.gp-pkg-hot{border-color:rgba(232,168,80,.28)!important;background:rgba(232,168,80,.06)!important}
.gp-hot-tag{position:absolute;top:-1px;left:50%;transform:translateX(-50%);background:var(--gp-gold);color:#1c1208;font-size:9px;font-weight:800;padding:4px 14px;border-radius:0 0 10px 10px;text-transform:uppercase;letter-spacing:.1em;white-space:nowrap}
.gp-pkg-nights{font-size:11px;font-weight:700;color:rgba(232,168,80,.8);text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px}
.gp-pkg-label{font-family:'Playfair Display',serif;font-size:26px;color:#f5f0e8;font-weight:400;margin-bottom:4px}
.gp-pkg-rounds{font-size:13px;font-weight:600;color:rgba(245,240,232,.6);margin-bottom:16px}
.gp-pkg-desc{font-size:13px;color:rgba(245,240,232,.6);line-height:1.8;margin:0 0 14px}
.gp-pkg-for{font-size:11px;font-weight:700;color:rgba(232,168,80,.7);text-transform:uppercase;letter-spacing:.08em;margin-bottom:18px}
.gp-pkg-link{font-size:13px;font-weight:600;color:rgba(232,168,80,.9);text-decoration:none}

/* INLINE CTA */
.gp-cta-inline{padding:clamp(48px,6vw,72px) 0;background:rgba(26,122,64,.06);border-top:1px solid rgba(26,122,64,.1);border-bottom:1px solid rgba(26,122,64,.1)}
.gp-cta-inline-line{font-size:18px;font-weight:600;color:var(--gp-text);margin:0 0 20px}
.gp-cta-inline-trust{font-size:12px;color:var(--gp-muted);margin:14px 0 0}

/* LODGING */
.gp-lodging{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.gp-lodge-card{border-radius:var(--gp-r);overflow:hidden;border:1px solid var(--gp-border);background:#fff;box-shadow:0 2px 12px rgba(0,0,0,.04);transition:all .35s}
.gp-lodge-card:hover{transform:translateY(-5px);box-shadow:0 20px 48px rgba(0,0,0,.1);border-color:rgba(232,168,80,.3)}
.gp-lodge-img-wrap{position:relative;height:200px;overflow:hidden}
.gp-lodge-img{width:100%;height:100%;object-fit:cover;transition:transform 6s ease}
