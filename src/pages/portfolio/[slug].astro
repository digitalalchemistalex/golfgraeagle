    const reviews = (courseReviewData[item.slug]?.quotes || []).slice(0, 3).map((q: any) => ({
      author: q.author,
      stars: q.rating,
      body: q.text,
      when: q.when,
    }));
    return [
      {
        '@type': ['GolfCourse', 'Service', 'Product'],
        '@id': `${pageUrl}#golfcourse`,
