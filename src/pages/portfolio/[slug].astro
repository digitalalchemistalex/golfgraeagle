        <a href={`/request-a-quote/?utm_source=golfgraeagle&utm_medium=internal&utm_campaign=cta&utm_content=${item.slug}-dining-cta`}
           class="btn-green-glow"
           style="display:inline-block;background:var(--gold-light);color:#0d1a0e;font-weight:700;font-size:15px;padding:16px 44px;border-radius:100px;text-decoration:none;transition:transform 0.2s;"
           onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
          Include in My Golf Package →
        </a>
        <div style="margin-top:14px;"><a href="/dining/" style="font-size:13px;color:rgba(28,18,8,0.28);text-decoration:none;" onmouseover="this.style.color='rgba(28,18,8,0.5)'" onmouseout="this.style.color='rgba(28,18,8,0.28)'">Browse all Graeagle dining →</a></div>
      </div>
    </div>

  <RelatedTrips client:load slug={item.slug} type="dining" showAll={true} />

    </>
  );})()}

  {!item && (
    <section style="min-height:60vh;display:flex;align-items:center;justify-content:center;padding:80px 24px;text-align:center;">
      <div>
        <h1 style="font-family:'Playfair Display',serif;font-size:40px;color:var(--text-primary);margin:0 0 16px;">Graeagle Golf</h1>
        <p style="font-size:16px;color:rgba(28,18,8,0.45);margin:0 0 28px;">This page is being updated with fresh content.</p>
        <a href="/request-a-quote/?utm_source=golfgraeagle&utm_medium=internal&utm_campaign=cta&utm_content=404-fallback" class="btn-green-glow" style="display:inline-block;background:var(--gold-light);color:#0d1a0e;font-weight:700;padding:14px 36px;border-radius:100px;text-decoration:none;">Plan Your Trip →</a>
      </div>
    </section>
  )}

  <Footer />

  <!-- ── LIGHTBOX ─────────────────────────────────────────── -->
  <div id="lb" style="position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.93);align-items:center;justify-content:center;display:none;">
    <button id="lb-close" onclick="lbClose()" style="position:fixed;top:12px;right:12px;background:rgba(0,0,0,0.5);border:2px solid rgba(255,255,255,0.3);color:white;font-size:28px;cursor:pointer;z-index:10002;line-height:1;opacity:1;width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;touch-action:manipulation;-webkit-tap-highlight-color:transparent;" aria-label="Close gallery">&times;</button>
    <button id="lb-prev" onclick="lbNav(-1)" style="position:fixed;left:16px;top:50%;transform:translateY(-50%);background:rgba(255,255,255,0.1);border:none;color:white;font-size:28px;cursor:pointer;z-index:10001;width:52px;height:52px;border-radius:50%;touch-action:manipulation;">&#8249;</button>
    <img id="lb-img" src="" alt="Photo gallery — click arrows to navigate" style="max-width:92vw;max-height:88vh;object-fit:contain;border-radius:8px;box-shadow:0 8px 60px rgba(0,0,0,0.6);transition:opacity 0.2s;"/>
    <button id="lb-next" onclick="lbNav(1)" style="position:fixed;right:16px;top:50%;transform:translateY(-50%);background:rgba(255,255,255,0.1);border:none;color:white;font-size:28px;cursor:pointer;z-index:10001;width:52px;height:52px;border-radius:50%;touch-action:manipulation;">&#8250;</button>
    <div id="lb-counter" style="position:fixed;bottom:20px;left:50%;transform:translateX(-50%);color:rgba(255,255,255,0.5);font-size:13px;letter-spacing:0.1em;"></div>
  </div>

  <style>
    #lb.open { display:flex !important; }
    .gallery-btn:hover img { transform:scale(1.05); }
    .gallery-btn:hover .gal-ov { background:rgba(0,0,0,0.35) !important; }
    .gallery-btn:hover .gal-ov svg { opacity:1 !important; }
    #lb-prev:hover, #lb-next:hover { background:rgba(255,255,255,0.2) !important; }
  </style>

  <script>
    let lbSrcs = [], lbIdx = 0;
    let touchStartX = 0, touchStartY = 0;

    function lbOpen(srcs, idx) {
      lbSrcs = srcs; lbIdx = idx;
      document.getElementById('lb').classList.add('open');
      document.body.style.overflow = 'hidden';
      lbShow();
    }
    function lbClose() {
      document.getElementById('lb').classList.remove('open');
      document.body.style.overflow = '';
    }
    function lbNav(dir) {
      lbIdx = (lbIdx + dir + lbSrcs.length) % lbSrcs.length;
      lbShow();
    }
    function lbShow() {
      const img = document.getElementById('lb-img');
      img.style.opacity = '0';
      setTimeout(() => { img.src = lbSrcs[lbIdx]; img.style.opacity = '1'; }, 150);
      document.getElementById('lb-counter').textContent = (lbIdx + 1) + ' / ' + lbSrcs.length;
      document.getElementById('lb-prev').style.display = lbSrcs.length > 1 ? '' : 'none';
      document.getElementById('lb-next').style.display = lbSrcs.length > 1 ? '' : 'none';
    }

    document.addEventListener('DOMContentLoaded', () => {
      const btns = Array.from(document.querySelectorAll('.gallery-btn'));
      if (!btns.length) return;
      const allSrcs = btns.map(b => b.dataset.src);
      btns.forEach((btn, i) => btn.addEventListener('click', () => lbOpen(allSrcs, i)));

      const lb = document.getElementById('lb');
      if (!lb) return;

      // Keyboard nav
      document.addEventListener('keydown', e => {
        if (!lb.classList.contains('open')) return;
        if (e.key === 'Escape') lbClose();
        if (e.key === 'ArrowRight') lbNav(1);
        if (e.key === 'ArrowLeft') lbNav(-1);
      });

      // Close button — explicit listener as backup to onclick
      const lbCloseBtn = document.getElementById('lb-close');
      if (lbCloseBtn) lbCloseBtn.addEventListener('click', e => {
        e.stopPropagation();
        lbClose();
      });

      // Click backdrop to close
      lb.addEventListener('click', e => {
        if ((e.target as HTMLElement).id === 'lb') lbClose();
      });

      // Touch/swipe support for mobile
      lb.addEventListener('touchstart', e => {
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
      }, { passive: true });

      lb.addEventListener('touchend', e => {
        const dx = e.changedTouches[0].screenX - touchStartX;
        const dy = e.changedTouches[0].screenY - touchStartY;
        // Only trigger if horizontal swipe > 50px and more horizontal than vertical
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
          lbNav(dx < 0 ? 1 : -1);
        } else if (Math.abs(dy) > 80 && dy > 0) {
          // Swipe down to close
          lbClose();
        }
      }, { passive: true });
    });

    // ── CAROUSEL: arrow nav + dot sync ─────────────────────
    document.querySelectorAll('[data-carousel]').forEach(wrap => {
      const track = wrap.querySelector('.gal-carousel');
      const prev  = wrap.querySelector('.gal-arrow-prev');
      const next  = wrap.querySelector('.gal-arrow-next');
      if (!track) return;

      const btns = Array.from(track.querySelectorAll('.gallery-btn'));
      const total = btns.length;
      if (total < 2) { if(prev) prev.style.display='none'; if(next) next.style.display='none'; return; }

      // Build dots
      const dotsWrap = document.createElement('div');
      dotsWrap.className = 'gal-dots';
      const dots = Array.from({length: total}, (_, i) => {
        const d = document.createElement('span');
        if (i === 0) d.classList.add('active');
        d.addEventListener('click', () => scrollTo(i));
        return d;
      });
      dots.forEach(d => dotsWrap.appendChild(d));
      wrap.appendChild(dotsWrap);

      function itemWidth() {
        return btns[0] ? btns[0].getBoundingClientRect().width + 4 : 0;
      }
      function currentIdx() {
        const w = itemWidth();
        return w ? Math.round(track.scrollLeft / w) : 0;
      }
      function scrollTo(i) {
        const w = itemWidth();
        track.scrollTo({ left: w * i, behavior: 'smooth' });
      }
      function updateDots() {
        const i = currentIdx();
        dots.forEach((d, idx) => d.classList.toggle('active', idx === i));
      }

      if (prev) prev.addEventListener('click', () => scrollTo(Math.max(0, currentIdx() - 1)));
      if (next) next.addEventListener('click', () => scrollTo(Math.min(total - 1, currentIdx() + 1)));

      track.addEventListener('scroll', updateDots, { passive: true });
    });
  </script>
</Base>
