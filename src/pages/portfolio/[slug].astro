// Fetch reviews for all 5 courses at build time
async function fetchCourseReviews(placeId: string): Promise<{ text: string; author: string; rating: number; when: string }[]> {
  try {
    const res = await fetch(
      `https://places.googleapis.com/v1/places/${placeId}?key=${PLACES_API_KEY}`,
      { headers: { 'X-Goog-FieldMask': 'reviews' } }
    );
    const data = await res.json();
    return (data.reviews || [])
      .filter((r: any) => r.rating >= 4 && (r.text?.text || '').length >= 40)
      .slice(0, 5)
      .map((r: any) => ({
        text: r.text?.text || '',
        author: r.authorAttribution?.displayName || 'Google reviewer',
        rating: r.rating,
        when: r.relativePublishTimeDescription || '',
      }));
  } catch {
    return [];
  }
}

const courseReviewData: Record<string, { quotes: { text: string; author: string; rating: number; when: string }[]; tripadvisorUrl: string; googlePlaceId: string }> = {};
await Promise.all(
  Object.entries(COURSE_PLACE_IDS).map(async ([slug, { placeId, tripadvisorUrl }]) => {
    courseReviewData[slug] = {
      googlePlaceId: placeId,
      tripadvisorUrl,
      quotes: await fetchCourseReviews(placeId),
