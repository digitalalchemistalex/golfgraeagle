---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { siteConfig, lodging, dining } from '../data/content.js';

const title = "Graeagle Golf Hotels & Lodging | Stay & Play Packages";
const description = "Best Graeagle golf lodging — River Pines Resort, Inn at Nakoma (FLW), Chalet View Lodge, Townhomes at Plumas Pines. Stay-and-play with guaranteed tee times from $299/golfer. Free quote.";
const canonical = `${siteConfig.url}/graeagle-golf-hotels/`;

// Pull real data
const riverPines  = lodging.find((l:any) => l.slug === 'river-pines-resort');
const chaletView  = lodging.find((l:any) => l.slug === 'chalet-view-lodge');
const innNakoma   = lodging.find((l:any) => l.slug === 'inn-at-nakoma');
const townhomes   = lodging.find((l:any) => l.slug === 'townhomes-at-plumas-pines');

// On-site dining
const roadhouse   = dining.find((d:any) => d.slug === 'roadhouse');
const eureka      = dining.find((d:any) => d.slug === 'eureka-peak-brewing');
const longboards  = dining.find((d:any) => d.slug === 'longboards');

// Drive times per property — from confirmed FAQ answers
const riverPineDrives = [
  { course:'Graeagle Meadows', time:'Walk',   slug:'graeagle-meadows-golf-packages' },
  { course:'Plumas Pines',     time:'5 min',  slug:'plumas-pines-golf-packages' },
  { course:'Whitehawk Ranch',  time:'10 min', slug:'whitehawk-ranch-golf-packages' },
  { course:'Grizzly Ranch',    time:'18 min', slug:'grizzly-ranch-golf-packages' },
  { course:'Nakoma Dragon',    time:'20 min', slug:'nakoma-dragon-golf-packages' },
];
const chaletDrives = [
  { course:'Graeagle Meadows', time:'5 min',  slug:'graeagle-meadows-golf-packages' },
  { course:'Whitehawk Ranch',  time:'8 min',  slug:'whitehawk-ranch-golf-packages' },
  { course:'Plumas Pines',     time:'10 min', slug:'plumas-pines-golf-packages' },
  { course:'Grizzly Ranch',    time:'15 min', slug:'grizzly-ranch-golf-packages' },
  { course:'Nakoma Dragon',    time:'20 min', slug:'nakoma-dragon-golf-packages' },
];
const innDrives = [
  { course:'Nakoma Dragon',    time:'On-site', slug:'nakoma-dragon-golf-packages' },
  { course:'Grizzly Ranch',    time:'20 min',  slug:'grizzly-ranch-golf-packages' },
  { course:'Whitehawk Ranch',  time:'20 min',  slug:'whitehawk-ranch-golf-packages' },
  { course:'Plumas Pines',     time:'22 min',  slug:'plumas-pines-golf-packages' },
  { course:'Graeagle Meadows', time:'25 min',  slug:'graeagle-meadows-golf-packages' },
];
const townhomeDrives = [
  { course:'Plumas Pines',     time:'Steps',  slug:'plumas-pines-golf-packages' },
  { course:'Graeagle Meadows', time:'10 min', slug:'graeagle-meadows-golf-packages' },
  { course:'Whitehawk Ranch',  time:'12 min', slug:'whitehawk-ranch-golf-packages' },
  { course:'Nakoma Dragon',    time:'18 min', slug:'nakoma-dragon-golf-packages' },
  { course:'Grizzly Ranch',    time:'22 min', slug:'grizzly-ranch-golf-packages' },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Graeagle Golf Hotels and Lodging",
    "description": "Hotels, resorts, and lodging for golf groups visiting Graeagle, California",
    "numberOfItems": 4,
    "itemListElement": [
      { "@type":"ListItem","position":1,"name":"River Pines Resort","url":`${siteConfig.url}/portfolio/river-pines-resort-graeagle-ca/`,"item":{"@type":"LodgingBusiness","@id":`${siteConfig.url}/portfolio/river-pines-resort-graeagle-ca/#lodging`,"name":"River Pines Resort","url":`${siteConfig.url}/portfolio/river-pines-resort-graeagle-ca/`} },
      { "@type":"ListItem","position":2,"name":"Chalet View Lodge","url":`${siteConfig.url}/portfolio/chalet-view-lodge-graeagle-ca/`,"item":{"@type":"LodgingBusiness","@id":`${siteConfig.url}/portfolio/chalet-view-lodge-graeagle-ca/#lodging`,"name":"Chalet View Lodge","url":`${siteConfig.url}/portfolio/chalet-view-lodge-graeagle-ca/`} },
      { "@type":"ListItem","position":3,"name":"Inn at Nakoma","url":`${siteConfig.url}/portfolio/the-inn-at-nakoma-clio-ca/`,"item":{"@type":"LodgingBusiness","@id":`${siteConfig.url}/portfolio/the-inn-at-nakoma-clio-ca/#lodging`,"name":"Inn at Nakoma","url":`${siteConfig.url}/portfolio/the-inn-at-nakoma-clio-ca/`} },
      { "@type":"ListItem","position":4,"name":"Townhomes at Plumas Pines","url":`${siteConfig.url}/portfolio/the-townhomes-at-plumas-pines/`,"item":{"@type":"LodgingBusiness","@id":`${siteConfig.url}/portfolio/the-townhomes-at-plumas-pines/#lodging`,"name":"Townhomes at Plumas Pines","url":`${siteConfig.url}/portfolio/the-townhomes-at-plumas-pines/`} },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type":"Question","name":"What hotels are near Graeagle golf courses?","acceptedAnswer":{"@type":"Answer","text":"Graeagle has 4 main lodging options for golfers: River Pines Resort (family-owned, walking distance to Graeagle Meadows, pool, hot tub, Roadhouse on-site), Chalet View Lodge (10 forested acres, spa, Eureka Peak Brewing on-site, 5 min to Graeagle Meadows), Inn at Nakoma (42 rooms inside the Frank Lloyd Wright clubhouse, on the Dragon course), and Townhomes at Plumas Pines (2–4 BR vacation rentals steps from the 1st tee at Plumas Pines). GolfGraeagle bundles all 4 with guaranteed tee times at all 5 courses."}},
      { "@type":"Question","name":"Is there a hotel on a Graeagle golf course?","acceptedAnswer":{"@type":"Answer","text":"Yes. The Inn at Nakoma sits inside the Frank Lloyd Wright-designed clubhouse at Nakoma (The Dragon) — walk directly from your room to the 1st tee. 42 rooms, Frette linens, spa, pool, and the Fifty44 Restaurant on-site. The Townhomes at Plumas Pines are also on-course — steps from the 1st tee at Plumas Pines Golf Resort."}},
      { "@type":"Question","name":"What is the best hotel in Graeagle CA for a golf group?","acceptedAnswer":{"@type":"Answer","text":"For large groups (8–60), River Pines Resort offers the most flexible room mix — rooms, cottages, and vacation rentals with a pool, hot tub, and on-site dining. For a premium experience, Inn at Nakoma is the only golf lodge in the world inside a Frank Lloyd Wright clubhouse. Chalet View Lodge is best for groups wanting a spa and brewery on-site. GolfGraeagle provides a free quote comparing all options for your specific group."}},
      { "@type":"Question","name":"How much does Graeagle golf lodging cost?","acceptedAnswer":{"@type":"Answer","text":"GolfGraeagle stay-and-play packages start from $299 per golfer, including lodging and guaranteed tee times at all 5 Graeagle courses. Final pricing depends on property, group size, number of nights, and rounds played. Request a free custom quote for accurate pricing."}},
      { "@type":"Question","name":"What hotels are near Whitehawk Ranch golf course?","acceptedAnswer":{"@type":"Answer","text":"Chalet View Lodge is the closest hotel to Whitehawk Ranch — 8 minutes away. River Pines Resort is 10 minutes from Whitehawk Ranch. Townhomes at Plumas Pines are 12 minutes away. GolfGraeagle packages all properties with Whitehawk Ranch tee times."}},
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type":"ListItem","position":1,"name":"Home","item":siteConfig.url},
      {"@type":"ListItem","position":2,"name":"Lodging","item":`${siteConfig.url}/lodging/`},
      {"@type":"ListItem","position":3,"name":"Graeagle Golf Hotels","item":canonical},
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "TravelAgency",
    "@id": `${siteConfig.url}/#organization`,
    "name": "GolfGraeagle.com",
    "aggregateRating": {"@type":"AggregateRating","ratingValue":"4.8","reviewCount":"672","bestRating":"5"},
  },
];
---
<Base {title} {description} {schema} canonical={canonical}
  ogImage={`${siteConfig.url}/wp-images/nakoma-flw-lodge-exterior.webp`}
  bodyClass="light-page">
  <Nav />

  <!-- ══ HERO ══════════════════════════════════════════════════ -->
  <section style="position:relative;min-height:75vh;display:flex;align-items:flex-end;overflow:hidden;">
    <div style="position:absolute;inset:0;display:grid;grid-template-columns:1.2fr 1fr;gap:3px;">
      <img src="/wp-images/nakoma-flw-lodge-exterior.webp"
        alt="Inn at Nakoma — Frank Lloyd Wright golf lodge"
        style="width:100%;height:100%;object-fit:cover;" width="960" height="720"
        loading="eager" fetchpriority="high"/>
      <div style="display:grid;grid-template-rows:1fr 1fr;gap:3px;">
        <img src="/wp-images/ChaletView-02.webp" alt="Chalet View Lodge Graeagle"
          style="width:100%;height:100%;object-fit:cover;" width="480" height="360" loading="eager"/>
        <img src="/wp-images/DJI_0949-Edit.webp" alt="River Pines Resort aerial Graeagle"
          style="width:100%;height:100%;object-fit:cover;" width="480" height="360" loading="eager"/>
      </div>
    </div>
    <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(13,26,14,0.93) 0%,rgba(13,26,14,0.45) 55%,rgba(13,26,14,0.1) 100%);"></div>
    <div style="position:relative;z-index:2;padding:0 8% 64px;max-width:860px;">
      <p style="font-size:11px;color:#e8a850;text-transform:uppercase;letter-spacing:0.18em;font-weight:700;margin:0 0 18px;">Graeagle, California · Golf Hotels &amp; Lodging</p>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(36px,6vw,64px);color:#f5f0e8;font-weight:400;margin:0 0 20px;line-height:1.08;">Graeagle Golf Hotels<br/><em style="color:#e8a850;">Where every group belongs</em></h1>
      <p class="speakable" style="font-size:18px;color:rgba(245,240,232,0.7);max-width:600px;margin:0 0 12px;line-height:1.75;" data-speakable>4 properties for every type of golf group — from the Frank Lloyd Wright resort on The Dragon course to family-owned river cabins walking distance to Graeagle Meadows. GolfGraeagle bundles every property with guaranteed tee times at all 5 championship courses.</p>
      <p class="speakable" style="font-size:14px;color:rgba(245,240,232,0.45);max-width:580px;margin:0 0 32px;line-height:1.65;" data-speakable>Hotels near Graeagle golf courses include: River Pines Resort, Chalet View Lodge, Inn at Nakoma, and Townhomes at Plumas Pines — all within 25 minutes of every course. Stay-and-play packages from $299/golfer.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
        <a href="/request-a-quote/" class="btn-green-glow" style="font-size:15px;padding:15px 32px;">Get a Free Lodging Quote →</a>
        <a href="tel:+18885861157" style="display:flex;align-items:center;gap:8px;color:rgba(245,240,232,0.6);font-size:14px;text-decoration:none;padding:15px 20px;border:1px solid rgba(245,240,232,0.2);border-radius:10px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.15 3.4 2 2 0 0 1 3.12 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16z"/></svg>
          (888) 586-1157
        </a>
      </div>
    </div>
  </section>

  <!-- ══ TRUST BAR ═══════════════════════════════════════════ -->
  <div style="background:#f0ece3;border-bottom:1px solid rgba(28,18,8,0.08);padding:14px 8%;display:flex;gap:0;flex-wrap:wrap;">
    {[['4 Properties','Hotels, resorts & vacation rentals'],['All 5 Courses','Tee times bundled in every package'],['$299+/golfer','Stay-and-play packages'],['4.8 ★','672 verified reviews'],['24 hrs','Free custom quote turnaround']].map(([v,l]) => (
      <div style="flex:1;min-width:120px;text-align:center;padding:8px 12px;border-right:1px solid rgba(28,18,8,0.07);">
        <div style="font-family:'Playfair Display',serif;font-size:17px;color:#1a2e1a;font-weight:500;">{v}</div>
        <div style="font-size:11px;color:rgba(28,18,8,0.4);margin-top:2px;line-height:1.3;">{l}</div>
      </div>
    ))}
  </div>

  <!-- ══ QUICK MATCH ══════════════════════════════════════════ -->
  <section style="background:#fff;padding:48px 8% 32px;">
    <p style="font-size:11px;color:#a06c30;text-transform:uppercase;letter-spacing:0.14em;font-weight:700;margin:0 0 16px;">Find Your Match</p>
    <h2 style="font-family:'Playfair Display',serif;font-size:clamp(22px,3vw,32px);color:#1a2e1a;margin:0 0 24px;font-weight:400;">Which hotel fits your golf group?</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(220px,45vw),1fr));gap:12px;">
      {[
        { icon:'🌊', q:'Large group, need flexible rooms?',   a:'River Pines Resort — rooms, cottages, pool, hot tub, on-site Roadhouse. Walk to Graeagle Meadows.', href:'#river-pines' },
        { icon:'🌲', q:'Spa, brewery, forest privacy?',       a:'Chalet View Lodge — 10 acres, full spa, Eureka Peak Brewing on-site, 9-hole exec course.', href:'#chalet-view' },
        { icon:'🏛️', q:'Ultimate bucket-list experience?',    a:'Inn at Nakoma — the only Frank Lloyd Wright golf lodge in the world. On The Dragon course.', href:'#inn-nakoma' },
        { icon:'🏠', q:'Own space, kitchen, on-course?',     a:'Townhomes at Plumas Pines — 2–4 BR, full kitchens, steps from the 1st tee at Plumas Pines.', href:'#townhomes' },
      ].map(c => (
        <a href={c.href} style="display:flex;gap:14px;align-items:flex-start;padding:18px;background:rgba(28,18,8,0.03);border:1px solid rgba(28,18,8,0.07);border-radius:12px;text-decoration:none;transition:all 0.2s;scroll-behavior:smooth;" onmouseover="this.style.borderColor='rgba(232,168,80,0.35)';this.style.background='rgba(232,168,80,0.04)'" onmouseout="this.style.borderColor='rgba(28,18,8,0.07)';this.style.background='rgba(28,18,8,0.03)'">
          <span style="font-size:22px;flex-shrink:0;margin-top:1px;">{c.icon}</span>
          <div>
            <div style="font-size:13px;font-weight:600;color:#1a2e1a;margin-bottom:5px;">{c.q}</div>
            <div style="font-size:12px;color:rgba(28,18,8,0.5);line-height:1.55;">{c.a}</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ══ PROPERTY 1: RIVER PINES ═════════════════════════════ -->
  <section id="river-pines" style="padding:56px 8%;background:#faf8f5;scroll-margin-top:80px;">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
        <span style="background:#1a2e1a;color:#e8a850;font-size:10px;font-weight:700;padding:4px 12px;border-radius:100px;text-transform:uppercase;letter-spacing:0.1em;">Best for Groups of 4–60</span>
        <span style="font-size:12px;color:rgba(28,18,8,0.4);">Walk to Graeagle Meadows</span>
      </div>
      <h2 style="font-family:'Playfair Display',serif;font-size:clamp(26px,4vw,40px);color:#1a2e1a;margin:0 0 6px;font-weight:400;">River Pines Resort</h2>
      <p style="font-size:14px;color:#a06c30;font-weight:600;margin:0 0 24px;">Rooms · Cottages · Vacation Rentals · Pool · Hot Tub · On-Site Dining</p>
      <div class="gal-carousel-wrap" data-carousel style="margin-bottom:32px;">
        <button class="gal-arrow gal-arrow-prev" aria-label="Previous">&#8249;</button>
        <div class="gal-carousel" id="carousel-riverpines">
          {riverPines?.images?.slice(0,6).map((img:string, i:number) => (
            <button class="gallery-btn" data-src={img} data-idx={i} data-total={Math.min(riverPines.images.length,6)}
              style="border:none;padding:0;background:none;cursor:zoom-in;flex:0 0 calc(50% - 3px);aspect-ratio:16/9;border-radius:10px;overflow:hidden;display:block;">
              <img src={img} alt={`River Pines Resort Graeagle — photo ${i+1}`}
                loading={i===0?'eager':'lazy'} width="640" height="360"
                style="width:100%;height:100%;object-fit:cover;transition:transform 0.4s ease;"/>
            </button>
          ))}
        </div>
        <button class="gal-arrow gal-arrow-next" aria-label="Next">&#8250;</button>
      </div>
      <div style="display:grid;grid-template-columns:1fr 320px;gap:40px;align-items:start;" class="prop-grid">
        <div>
          <p style="font-size:16px;color:rgba(28,18,8,0.65);line-height:1.85;margin:0 0 24px;" class="speakable">{riverPines?.description}</p>
          <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:28px;">
            {riverPines?.highlights?.map((h:string) => (
              <div style="display:flex;gap:10px;align-items:flex-start;font-size:14px;color:rgba(28,18,8,0.6);line-height:1.5;">
                <span style="color:#e8a850;flex-shrink:0;margin-top:2px;font-size:12px;">✓</span>{h}
              </div>
            ))}
          </div>
          <div style="background:rgba(232,168,80,0.07);border:1px solid rgba(232,168,80,0.2);border-radius:12px;padding:16px 20px;margin-bottom:28px;">
            <p style="font-size:10px;color:#a06c30;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;margin:0 0 10px;">On-Site Dining</p>
            <a href="/portfolio/roadhouse-at-river-pines/" style="display:flex;align-items:center;justify-content:space-between;text-decoration:none;" onmouseover="this.style.opacity='0.75'" onmouseout="this.style.opacity='1'">
              <div>
                <div style="font-size:14px;font-weight:600;color:#1a2e1a;">The Roadhouse at River Pines</div>
                <div style="font-size:12px;color:rgba(28,18,8,0.45);margin-top:3px;">{roadhouse?.tagline}</div>
              </div>
              <span style="font-size:12px;color:#a06c30;flex-shrink:0;margin-left:12px;">View →</span>
            </a>
          </div>
          <div style="display:flex;gap:12px;flex-wrap:wrap;">
            <a href="/portfolio/river-pines-resort-graeagle-ca/" style="font-size:14px;font-weight:600;color:#1a2e1a;padding:11px 22px;border:1px solid rgba(28,18,8,0.15);border-radius:8px;text-decoration:none;">Full property details →</a>
            <a href="/request-a-quote/?lodging=river-pines-resort" class="btn-green-glow" style="font-size:14px;padding:11px 22px;">Book with Tee Times →</a>
          </div>
        </div>
        <div style="background:#fff;border:1px solid rgba(28,18,8,0.08);border-radius:14px;padding:20px 22px;position:sticky;top:90px;">
          <p style="font-size:10px;color:#a06c30;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;margin:0 0 14px;">Drive Times to Courses</p>
          {riverPineDrives.map(d => (
            <a href={`/portfolio/${d.slug}/`} style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid rgba(28,18,8,0.05);text-decoration:none;" onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">
              <span style="font-size:13px;color:#1a2e1a;font-weight:500;">{d.course}</span>
              <span style={`font-size:12px;font-weight:700;${d.time==='Walk'?'color:#1a7a40;':'color:rgba(28,18,8,0.45);'}`}>{d.time}</span>
            </a>
          ))}
          <a href="/request-a-quote/?lodging=river-pines-resort" class="btn-green-glow" style="display:block;text-align:center;font-size:13px;padding:11px;margin-top:16px;border-radius:8px;">Get Package Quote →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ PROPERTY 2: CHALET VIEW ══════════════════════════════ -->
  <section id="chalet-view" style="padding:56px 8%;background:#fff;scroll-margin-top:80px;">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
        <span style="background:#1a2e1a;color:#e8a850;font-size:10px;font-weight:700;padding:4px 12px;border-radius:100px;text-transform:uppercase;letter-spacing:0.1em;">Best Amenities</span>
        <span style="font-size:12px;color:rgba(28,18,8,0.4);">10 forested acres · Spa · On-site brewery</span>
      </div>
      <h2 style="font-family:'Playfair Display',serif;font-size:clamp(26px,4vw,40px);color:#1a2e1a;margin:0 0 6px;font-weight:400;">Chalet View Lodge</h2>
      <p style="font-size:14px;color:#a06c30;font-weight:600;margin:0 0 24px;">Lodge Rooms · Terrace Suites · Private Cabins · Spa · 9-Hole Exec Course</p>
      <div class="gal-carousel-wrap" data-carousel style="margin-bottom:32px;">
        <button class="gal-arrow gal-arrow-prev" aria-label="Previous">&#8249;</button>
        <div class="gal-carousel" id="carousel-chalet">
          {chaletView?.images?.slice(0,6).map((img:string, i:number) => (
            <button class="gallery-btn" data-src={img} data-idx={i} data-total={Math.min(chaletView.images.length,6)}
              style="border:none;padding:0;background:none;cursor:zoom-in;flex:0 0 calc(50% - 3px);aspect-ratio:16/9;border-radius:10px;overflow:hidden;display:block;">
              <img src={img} alt={`Chalet View Lodge Graeagle — photo ${i+1}`}
                loading={i===0?'eager':'lazy'} width="640" height="360"
                style="width:100%;height:100%;object-fit:cover;transition:transform 0.4s ease;"/>
            </button>
          ))}
        </div>
        <button class="gal-arrow gal-arrow-next" aria-label="Next">&#8250;</button>
      </div>
      <div style="display:grid;grid-template-columns:1fr 320px;gap:40px;align-items:start;" class="prop-grid">
        <div>
          <p style="font-size:16px;color:rgba(28,18,8,0.65);line-height:1.85;margin:0 0 24px;" class="speakable">{chaletView?.description}</p>
          <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:28px;">
            {chaletView?.highlights?.map((h:string) => (
              <div style="display:flex;gap:10px;align-items:flex-start;font-size:14px;color:rgba(28,18,8,0.6);line-height:1.5;">
                <span style="color:#e8a850;flex-shrink:0;margin-top:2px;font-size:12px;">✓</span>{h}
              </div>
            ))}
          </div>
          <div style="background:rgba(232,168,80,0.07);border:1px solid rgba(232,168,80,0.2);border-radius:12px;padding:16px 20px;margin-bottom:28px;">
            <p style="font-size:10px;color:#a06c30;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;margin:0 0 10px;">On-Site Dining &amp; Drinks</p>
