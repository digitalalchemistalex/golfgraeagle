---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import RelatedTrips from '../components/RelatedTrips.tsx';
import { fetchTripStats } from '../lib/tripStats';
const { minPrice, trips: allTrips } = await fetchTripStats();

// Social proof: real completed bachelor-size Graeagle trips (8-24 pax, 2+ nights, has whyItWorked)
const proofTrips = allTrips
  .filter((t: any) => t.groupSize >= 8 && t.groupSize <= 24 && t.nights >= 2 && t.pricePerPerson && t.whyItWorked)
  .sort((a: any, b: any) => a.pricePerPerson - b.pricePerPerson)
  .slice(0, 3);

const title = "Bachelor Party Golf Graeagle | Group Packages & Tee Times";
const description = "Bachelor party golf in Graeagle, CA — 5 courses, group tee times, lodging for 8–20, one planner handles everything. Packages from $299/golfer. Free quote in 24 hours.";

const faqSchema = {
  "@context":"https://schema.org","@type":"FAQPage",
  "mainEntity":[
    {"@type":"Question","name":"How many golfers can GolfGraeagle accommodate for a bachelor party?","acceptedAnswer":{"@type":"Answer","text":"GolfGraeagle handles bachelor party groups from 4 to 40+ golfers. Most bachelor groups run 8–16 players across 2–3 days. Consecutive tee time blocks are arranged so your whole group plays together."}},
    {"@type":"Question","name":"Which Graeagle course is best for a bachelor party golf trip?","acceptedAnswer":{"@type":"Answer","text":"Most bachelor parties save Grizzly Ranch (Golf Digest Top 100) or Nakoma Dragon (Golf World Top 75, Frank Lloyd Wright clubhouse) for the main event round. Whitehawk Ranch and Graeagle Meadows work well as warm-up rounds on day one."}},
    {"@type":"Question","name":"Where do bachelor golf groups stay in Graeagle?","acceptedAnswer":{"@type":"Answer","text":"The Townhomes at Plumas Pines are the most popular — 2–4 bedroom units so the group has their own space. River Pines Resort works well for groups that want hotel rooms and an on-site bar."}},
    {"@type":"Question","name":"How far in advance should I book a bachelor party golf trip to Graeagle?","acceptedAnswer":{"@type":"Answer","text":"Book 6–8 weeks ahead for summer weekends (June–August). September and October can often be arranged 3–4 weeks out. Submit a quote request and GolfGraeagle will confirm availability within 24 hours."}},
    {"@type":"Question","name":"How much does a bachelor party golf trip to Graeagle cost?","acceptedAnswer":{"@type":"Answer","text":"Real completed bachelor party packages range from $620 to $1,120 per person depending on number of nights, courses played, and lodging choice. Most groups of 12–16 pay $650–$875/person for a 2-night, 3-course package with lodging."}}
  ]
};

const breadcrumbSchema = {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
  {"@type":"ListItem","position":1,"name":"Home","item":"https://golfgraeagle.com/"},
  {"@type":"ListItem","position":2,"name":"Bachelor Party Golf Graeagle","item":"https://golfgraeagle.com/bachelor-party-golf-graeagle/"}
]};

const orgSchema = {"@context":"https://schema.org","@graph":[
  {"@type":["TravelAgency","Organization"],"@id":"https://golfgraeagle.com/#organization","name":"GolfGraeagle.com","url":"https://golfgraeagle.com",
    "aggregateRating":{"@type":"AggregateRating","ratingValue":"4.8","reviewCount":"672","bestRating":"5"}},
  {"@type":"WebPage","url":"https://golfgraeagle.com/bachelor-party-golf-graeagle/","name":title}
]};

const serviceSchema = {
  "@context":"https://schema.org","@type":"Service",
  "name":"Bachelor Party Golf Trips in Graeagle, California",
  "description":"Bachelor party golf trip planning in Graeagle, CA — group tee times, lodging for 8–20 golfers, and full itinerary coordination. 5 championship courses within 25 minutes.",
  "provider":{"@type":"TravelAgency","@id":"https://golfgraeagle.com/#organization"},
  "areaServed":{"@type":"Place","name":"Graeagle, California"},
  "serviceType":"Bachelor Party Golf Trip Planning"
};

const courses = [
  { name:'Grizzly Ranch', slug:'grizzly-ranch-golf-packages', accolade:'Golf Digest Top 100', img:'/wp-images/grizzly-ranch-hero.webp', alt:'Grizzly Ranch Golf Club — Golf Digest Top 100, bachelor party golf Graeagle', line:'The main event round. Semi-private, slope 140 — where the bet gets settled.' },
  { name:'Nakoma Dragon', slug:'nakoma-dragon-golf-packages', accolade:'Golf World Top 75', img:'/wp-images/nakoma-dragon-feather-river.webp', alt:'Nakoma Dragon Golf Course — Golf World Top 75, Frank Lloyd Wright clubhouse', line:'The Frank Lloyd Wright clubhouse. Slope 147. The round everyone talks about.' },
  { name:'Whitehawk Ranch', slug:'whitehawk-ranch-golf-packages', accolade:'Top 20 California', img:'/wp-images/whitehawk-hero.webp', alt:'Whitehawk Ranch Golf Course — Top 20 California, bachelor party golf', line:'Top 20 California. Meadow fairways and forested hillsides. Perfect opener.' },
];

const lodging = [
  { name:'Townhomes at Plumas Pines', slug:'the-townhomes-at-plumas-pines', img:'/wp-images/plumas-pines-hero.webp', alt:'Townhomes at Plumas Pines — bachelor party golf lodging Graeagle', tag:'Most Popular for Bachelor Groups', desc:'2–4 bedroom units. Full kitchens. Fairway views. Your own space — no hotel hallways.' },
  { name:'River Pines Resort', slug:'river-pines-resort-graeagle-ca', img:'/wp-images/DJI_0949-Edit.webp', alt:'River Pines Resort Graeagle — bachelor party golf lodging', tag:'On-Site Bar & Dining', desc:'The Roadhouse on-site. Pool, hot tub, rooms for groups of 8–60. Walk in after 18 holes.' },
];

const included = [
  { icon:'⛳', title:'Group tee times', body:'Consecutive blocks at all 5 courses. We deal directly with every pro shop so you don\'t.' },
  { icon:'🏘', title:'Lodging for the whole group', body:'Townhomes or resort rooms matched to your group size and budget. One booking, one invoice.' },
  { icon:'📋', title:'Day-by-day itinerary', body:'Courses sequenced by difficulty, drive times between venues, dining recommendations built in.' },
  { icon:'🍺', title:'Après-golf sorted', body:'The Brewing Lair, Mohawk Tavern, Grizzly Grill — we know which table to book and when.' },
];

const QUOTE_URL = '/request-a-quote/?groupType=bachelor-party&ref=bachelor-party-landing';
---

<Base
  title={title}
  description={description}
  ogType="website"
  schema={[orgSchema, faqSchema, breadcrumbSchema, serviceSchema]}
  canonical="https://golfgraeagle.com/bachelor-party-golf-graeagle/"
  ogImage="https://golfgraeagle.com/wp-images/2024-08-17-1.webp"
  bodyClass="light-page"
>
  <Nav />

  <!-- ═══ HERO ═══ -->
  <section class="bp-hero">
    <div class="bp-bg" style="background-image:url(/wp-images/2024-08-17-1.webp)"></div>
    <div class="bp-overlay"></div>
    <div class="bp-hero-inner">
      <p class="bp-eyebrow reveal-up">Bachelor Party Golf · Graeagle, California · 5 Championship Courses</p>
      <h1 class="bp-h1 reveal-up delay-1">The golf trip<br/><em>the groom deserves.</em></h1>
      <p class="bp-sub speakable reveal-up delay-2">Five championship courses within 25 minutes of each other. Golf Digest Top 100, Frank Lloyd Wright clubhouse, group tee times secured. One planner handles all of it — tee times, lodging, the whole itinerary.</p>
      <div class="bp-pills reveal-up delay-3">
        <span>From <strong>${minPrice}</strong>/golfer</span>
        <span>8–20+ golfers</span>
        <span>2–4 nights</span>
        <span>24hr quote</span>
      </div>
      <div class="bp-ctas reveal-up delay-4">
        <a href={QUOTE_URL} class="btn-green-glow bp-btn">Plan the Bachelor Trip →</a>
        <a href="/trips/" class="bp-ghost underline-draw">See real group pricing ↗</a>
      </div>
      <p class="bp-trust reveal-up delay-5">Free · No commitment · Response within 24 hours</p>
    </div>
    <div class="bp-floats reveal-fade delay-5">
      <div class="bp-float"><div class="bp-float-val">5</div><div class="bp-float-lbl">Courses</div></div>
      <div class="bp-float"><div class="bp-float-val">4.8★</div><div class="bp-float-lbl">Avg Rating</div></div>
      <div class="bp-float"><div class="bp-float-val">24hr</div><div class="bp-float-lbl">Quote</div></div>
    </div>
  </section>

  <!-- ═══ WHAT'S INCLUDED ═══ -->
  <section class="bp-section">
    <div class="bp-container">
      <div class="bp-header reveal-up">
        <span class="sec-label">One quote, everything handled</span>
        <h2 class="bp-h2">Everything in your<br/><em>bachelor golf package</em></h2>
      </div>
      <div class="bp-included">
        {included.map((item, i) => (
          <div class={`bp-inc-card glow-card reveal-scale delay-${i+1}`}>
            <div class="bp-inc-icon">{item.icon}</div>
            <div class="bp-inc-title">{item.title}</div>
            <p class="bp-inc-body">{item.body}</p>
          </div>
        ))}
      
      <!-- Dining cross-sell -->
      <div class="reveal" style="background:rgba(232,168,80,0.06);border:1px solid rgba(232,168,80,0.18);border-radius:14px;padding:24px 28px;margin-top:40px;">
        <p style="font-size:10px;color:#a06c30;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;margin:0 0 10px;">Group Dining — Coordinated by GolfGraeagle</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(180px,45vw),1fr));gap:10px;">
          {[
            {name:'Grizzly Grill', note:'Group dinner favourite — stone hearth, local game, exposed beams', slug:'grizzly-grill'},
            {name:'The Roadhouse', note:'On-site at River Pines — steaks, ribs, walk in after 18', slug:'roadhouse-at-river-pines'},
            {name:"Cuccia's", note:"#1 rated in Graeagle — handmade pizza, pasta, wine bar", slug:'cuccias'},
            {name:'Iron Door', note:'Historic steakhouse since 1961 — great for the big group dinner', slug:'iron-door'},
          ].map(d => (
            <a href={`/portfolio/${d.slug}/`} style="padding:12px 14px;background:#fff;border:1px solid rgba(28,18,8,0.07);border-radius:8px;text-decoration:none;display:block;" onmouseover="this.style.borderColor='rgba(232,168,80,0.35)'" onmouseout="this.style.borderColor='rgba(28,18,8,0.07)'">
              <div style="font-size:13px;font-weight:600;color:#1a2e1a;margin-bottom:4px;">{d.name}</div>
              <div style="font-size:11px;color:rgba(28,18,8,0.45);line-height:1.5;">{d.note}</div>
            </a>
          ))}
        </div>
        <p style="font-size:12px;color:rgba(28,18,8,0.4);margin:14px 0 0;">GolfGraeagle can coordinate group dining reservations alongside your tee times and lodging — <a href="/dining/" style="color:#a06c30;text-decoration:none;">browse all restaurants →</a></p>
      </div>
    </div>
    </div>
  </section>

  <!-- ═══ COURSES ═══ -->
  <section class="bp-section bp-dark">
    <div class="bp-container">
      <div class="bp-header reveal-up">
        <span class="sec-label" style="color:#e8a850">The championship lineup</span>
        <h2 class="bp-h2" style="color:#f5f0e8">The courses that make<br/><em>the trip legendary</em></h2>
      </div>
      <div class="bp-courses">
        {courses.map((c, i) => (
          <div class={`bp-course-card reveal-${i%2===0?'left':'right'} delay-${i+1}`}>
            <div class="bp-course-img-wrap">
              <img src={c.img} alt={c.alt} loading="lazy" class="bp-course-img"/>
              <div class="bp-course-fade"></div>
              <span class="bp-course-badge">{c.accolade}</span>
            </div>
            <div class="bp-course-body">
              <div class="bp-course-name">{c.name}</div>
              <p class="bp-course-line">{c.line}</p>
              <a href={`/portfolio/${c.slug}/`} class="bp-course-link underline-draw">Course details ↗</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ INLINE CTA ═══ -->
  <section class="bp-cta-inline">
    <div class="bp-container" style="text-align:center;max-width:600px">
      <p class="bp-cta-inline-line reveal-up">Ready to lock in tee times for the group?</p>
      <a href={QUOTE_URL} class="btn-green-glow bp-btn reveal-scale delay-1">Plan the Bachelor Trip →</a>
      <p class="bp-cta-inline-trust reveal-up delay-2">Free · No commitment · 24hr response</p>
    </div>
  </section>

  <!-- ═══ LODGING ═══ -->
  <section class="bp-section">
    <div class="bp-container">
      <div class="bp-header reveal-up">
        <span class="sec-label">Graeagle golf lodging for groups</span>
        <h2 class="bp-h2">Where the group<br/><em>stays</em></h2>
      </div>
      <div class="bp-lodging">
        {lodging.map((l, i) => (
          <div class={`bp-lodge-card glow-card reveal-${i===0?'left':'right'} delay-${i+1}`}>
            <div class="bp-lodge-img-wrap">
              <img src={l.img} alt={l.alt} loading="lazy" class="bp-lodge-img"/>
              <div class="bp-lodge-fade"></div>
              <span class="bp-lodge-tag">{l.tag}</span>
            </div>
            <div class="bp-lodge-body">
              <div class="bp-lodge-name">{l.name}</div>
              <p class="bp-lodge-desc">{l.desc}</p>
              <a href={`/portfolio/${l.slug}/`} class="bp-course-link underline-draw">View property ↗</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ SOCIAL PROOF: REAL TRIPS ═══ -->
  {proofTrips.length > 0 && (
  <section class="bp-section">
    <div class="bp-container">
      <div class="bp-header reveal-up">
        <span class="bp-label">Real completed trips</span>
        <h2 class="bp-h2">Groups like yours.<br/><em>Booked. Played. Loved it.</em></h2>
        <p class="bp-subhead">These aren't estimates — they're actual packages Mike built for real groups.</p>
      </div>
      <div class="bp-proof-grid">
        {proofTrips.map((t: any, i: number) => {
          const courseNames = (t.courses || []).map((c: string) => c.replace(/ Golf (Club|Course|Resort)$/i,'').replace(/ Club$| Course$/,''));
          return (
            <div class={`bp-proof-card reveal-up delay-${i+1}`}>
              <div class="bp-proof-top">
                <span class="bp-proof-pax">{t.groupSize} golfers</span>
                <span class="bp-proof-nights">{t.nights}N / {t.rounds}R</span>
                <span class="bp-proof-price">${t.pricePerPerson}/pp</span>
              </div>
              <div class="bp-proof-courses">
                {courseNames.slice(0,3).map((c: string, j: number) => (
                  <span class="bp-proof-course">{c}{j < Math.min(courseNames.length,3)-1 ? ' · ' : ''}</span>
                ))}
              </div>
              <p class="bp-proof-why">"{t.whyItWorked}"</p>
              <div class="bp-proof-mike">— <a href="/about/mike-eskuchen/" style="color:inherit;text-decoration:underline;text-underline-offset:3px;opacity:0.8;">Mike Eskuchen</a>, Golf Trip Specialist</div>
            </div>
          );
        })}
      </div>
      <div style="text-align:center;margin-top:40px">
        <a href={QUOTE_URL} class="btn-green-glow bp-btn reveal-scale">Build a Trip Like This →</a>
      </div>
    </div>
  </section>
  )}

  <!-- ═══ MIKE CTA ═══ -->
  <!-- Mobile-only CTA between lodging and Mike -->
  <section class="bp-cta-inline bp-mobile-only">
    <div class="bp-container" style="text-align:center;max-width:600px">
      <p class="bp-cta-inline-line reveal-up">Group size sorted. Courses picked. Ready?</p>
      <a href={QUOTE_URL} class="btn-green-glow bp-btn reveal-scale delay-1">Plan the Bachelor Trip →</a>
      <p class="bp-cta-inline-trust reveal-up delay-2">Free · No commitment · 24hr response</p>
    </div>
  </section>

  <section class="bp-section bp-dark">
    <div class="bp-container bp-mike-wrap">
      <div class="bp-mike-text reveal-left">
        <span class="bp-label" style="color:#e8a850">Your Graeagle golf specialist</span>
        <h2 class="bp-h2" style="color:#f5f0e8;margin-top:10px">Tell Mike about<br/><em>your group.</em></h2>
        <p class="bp-mike-body">20+ years booking golf trips in Graeagle. He knows which courses to sequence, which lodging fits your group size, and how to get tee times at Grizzly Ranch and Nakoma when everyone else can't. Submit a quote request — he responds within 24 hours.</p>
        <a href={QUOTE_URL} class="btn-green-glow bp-btn" style="margin-top:28px;display:inline-block">Get Free Quote →</a>
        <p style="font-size:12px;color:rgba(245,240,232,.3);margin-top:12px;">Free · No commitment · 24hr response</p>
      </div>
      <div class="bp-mike-img reveal-right delay-2">
        <img src="/mike-eskuchen.jpg" alt="Mike Eskuchen — Graeagle Golf Trip Specialist, bachelor party golf planner" loading="lazy"/>
        <div class="bp-mike-badge">
          <div class="bp-mike-name">Mike Eskuchen</div>
          <div class="bp-mike-title">Golf Trip Specialist · 20+ years</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="bp-section">
    <div class="bp-container" style="max-width:760px">
      <div class="bp-header reveal-up">
        <span class="sec-label">Bachelor party golf — common questions</span>
        <h2 class="bp-h2">Planning questions,<br/><em>answered</em></h2>
      </div>
      <div class="bp-faqs">
        {faqSchema.mainEntity.map((q: any, i: number) => (
          <details class={`bp-faq reveal-up delay-${i+1}`}>
            <summary class="bp-faq-q">
              {q.name}
              <span class="bp-faq-icon">+</span>
            </summary>
            <p class="bp-faq-a">{q.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FINAL CTA ═══ -->
  <section class="bp-cta-final bp-dark">
    <div class="bp-cta-glow"></div>
    <div class="bp-container" style="text-align:center;max-width:620px;position:relative;z-index:1">
      <h2 class="bp-cta-h2 reveal-up">One submission.<br/><em>We handle the rest.</em></h2>
      <p class="bp-cta-sub reveal-up delay-1">Tell us your group size, dates, and which courses you want. Mike builds a full bachelor party golf package — tee times, lodging, itinerary — and sends it back within 24 hours.</p>
      <div class="reveal-scale delay-2">
        <a href={QUOTE_URL} class="btn-green-glow bp-btn">Plan the Bachelor Trip →</a>
        <p style="font-size:12px;color:rgba(245,240,232,.28);margin-top:14px;">Groups 8–20+ · All 5 courses · 24hr quote · 4.8★</p>
      </div>
    </div>
  </section>

  <div style="max-width:860px;margin:0 auto;padding:32px clamp(20px,6%,80px) 0;display:flex;flex-wrap:wrap;gap:12px 24px;">
    <a href="/blog/large-group-golf-graeagle/" style="font-size:14px;color:#1a7a40;text-decoration:underline;">Planning large-group golf in Graeagle →</a>
    <a href="/summer-golf-graeagle/" style="font-size:14px;color:#1a7a40;text-decoration:underline;">Summer golf in Graeagle →</a>
  </div>
  <RelatedTrips client:load slug="bachelor-party" type="course" showAll={true} max={3} />
  <Footer />
</Base>

<style>
:root{--bp-gold:#e8a850;--bp-green:#1a7a40;--bp-dark:#0d1a0e;--bp-text:#1c1208;--bp-muted:rgba(28,18,8,0.52);--bp-border:rgba(28,18,8,0.08);--bp-r:20px}
.bp-container{max-width:1140px;margin:0 auto;padding:0 clamp(20px,6%,80px)}
.bp-section{padding:clamp(72px,9vw,120px) 0;background:var(--page-bg,#f8f5f0)}
.bp-dark{background:var(--bp-dark)!important}
.bp-header{text-align:center;margin-bottom:clamp(40px,5vw,68px)}
.bp-h2{font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,50px);font-weight:500;color:var(--bp-text);line-height:1.1;margin:8px 0 0}
.bp-h2 em{font-style:italic;color:var(--bp-green)}

/* HERO */
.bp-hero{position:relative;min-height:92vh;display:flex;align-items:flex-end;overflow:hidden}
.bp-bg{position:absolute;inset:0;background-size:cover;background-position:center 25%;transform:scale(1.07);animation:bpZoom 10s ease forwards}
@keyframes bpZoom{to{transform:scale(1)}}
.bp-overlay{position:absolute;inset:0;background:linear-gradient(160deg,rgba(13,26,14,.1) 0%,rgba(13,26,14,.55) 50%,rgba(13,26,14,.97) 100%)}
.bp-hero-inner{position:relative;z-index:2;padding:0 clamp(24px,8%,120px) clamp(60px,8vw,100px);max-width:820px}
.bp-eyebrow{font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:rgba(232,168,80,.82);margin:0 0 18px}
.bp-h1{font-family:'Playfair Display',serif;font-size:clamp(46px,7.5vw,92px);font-weight:500;color:#f5f0e8;line-height:.98;margin:0 0 18px}
.bp-h1 em{font-style:italic;color:var(--bp-gold)}
.bp-sub{font-size:clamp(16px,2vw,21px);color:rgba(245,240,232,.62);line-height:1.55;margin:0 0 26px}
.bp-pills{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px}
.bp-pills span{font-size:12px;font-weight:600;color:rgba(245,240,232,.8);padding:6px 15px;background:rgba(255,255,255,.1);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.18);border-radius:100px}
.bp-pills strong{color:var(--bp-gold)}
.bp-ctas{display:flex;gap:20px;align-items:center;flex-wrap:wrap;margin-bottom:16px}
.bp-btn{display:inline-block;padding:15px 36px;border-radius:100px;font-size:15px;font-weight:700;text-decoration:none}
.bp-ghost{font-size:14px;font-weight:600;color:rgba(232,168,80,.9);text-decoration:none}
.bp-trust{font-size:12px;color:rgba(245,240,232,.35);margin:0}
.bp-floats{position:absolute;right:clamp(24px,5%,72px);bottom:clamp(56px,8vw,90px);display:flex;flex-direction:column;gap:10px;z-index:3}
.bp-float{background:rgba(255,255,255,.1);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.2);border-radius:16px;padding:14px 22px;text-align:center;min-width:116px}
.bp-float-val{font-family:'Playfair Display',serif;font-size:26px;color:var(--bp-gold);font-weight:400;line-height:1}
.bp-float-lbl{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.14em;color:rgba(245,240,232,.45);margin-top:5px}

/* INCLUDED */
.bp-included{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(240px,45vw),1fr));gap:20px}
.bp-inc-card{border-radius:var(--bp-r);padding:28px 24px;border:1px solid var(--bp-border);background:#fff;box-shadow:0 2px 12px rgba(0,0,0,.04);transition:all .35s}
.bp-inc-card:hover{transform:translateY(-5px);box-shadow:0 20px 48px rgba(0,0,0,.09);border-color:rgba(232,168,80,.3)}
.bp-inc-icon{font-size:32px;margin-bottom:12px}
.bp-inc-title{font-size:15px;font-weight:700;color:var(--bp-text);margin-bottom:8px}
.bp-inc-body{font-size:13px;color:var(--bp-muted);line-height:1.75;margin:0}

/* COURSES */
.bp-courses{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.bp-course-card{border-radius:var(--bp-r);overflow:hidden;background:rgba(255,255,255,.06);border:1px solid rgba(245,240,232,.08);transition:all .35s}
.bp-course-card:hover{transform:translateY(-5px);box-shadow:0 24px 56px rgba(0,0,0,.4)}
.bp-course-img-wrap{position:relative;height:200px;overflow:hidden}
.bp-course-img{width:100%;height:100%;object-fit:cover;transition:transform 6s ease}
.bp-course-card:hover .bp-course-img{transform:scale(1.06)}
.bp-course-fade{position:absolute;inset:0;background:linear-gradient(to top,rgba(13,26,14,.9) 0%,transparent 55%)}
.bp-course-badge{position:absolute;top:12px;left:12px;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;background:rgba(232,168,80,.92);color:#0d1a0e;padding:4px 10px;border-radius:100px}
.bp-course-body{padding:18px 20px 22px}
.bp-course-name{font-family:'Playfair Display',serif;font-size:17px;color:#f5f0e8;margin-bottom:6px}
.bp-course-line{font-size:13px;color:rgba(245,240,232,.6);line-height:1.65;margin:0 0 14px}
.bp-course-link{font-size:12px;font-weight:600;color:var(--bp-gold);text-decoration:none}

/* INLINE CTA */
.bp-cta-inline{padding:clamp(48px,6vw,72px) 0;background:rgba(26,122,64,.06);border-top:1px solid rgba(26,122,64,.1);border-bottom:1px solid rgba(26,122,64,.1)}
.bp-cta-inline-line{font-size:18px;font-weight:600;color:var(--bp-text);margin:0 0 20px}
.bp-cta-inline-trust{font-size:12px;color:var(--bp-muted);margin:14px 0 0}

/* LODGING */
.bp-lodging{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.bp-lodge-card{border-radius:var(--bp-r);overflow:hidden;border:1px solid var(--bp-border);background:#fff;box-shadow:0 2px 12px rgba(0,0,0,.04);transition:all .35s}
.bp-lodge-card:hover{transform:translateY(-5px);box-shadow:0 20px 48px rgba(0,0,0,.1);border-color:rgba(232,168,80,.3)}
.bp-lodge-img-wrap{position:relative;height:220px;overflow:hidden}
.bp-lodge-img{width:100%;height:100%;object-fit:cover;transition:transform 6s ease}
.bp-lodge-card:hover .bp-lodge-img{transform:scale(1.05)}
.bp-lodge-fade{position:absolute;inset:0;background:linear-gradient(to top,rgba(13,26,14,.7) 0%,transparent 55%)}
.bp-lodge-tag{position:absolute;top:12px;left:12px;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;background:rgba(26,122,64,.9);color:#fff;padding:4px 10px;border-radius:100px}
.bp-lodge-body{padding:20px 22px 24px}
.bp-lodge-name{font-family:'Playfair Display',serif;font-size:17px;color:var(--bp-text);margin-bottom:8px}
.bp-lodge-desc{font-size:13px;color:var(--bp-muted);line-height:1.7;margin:0 0 14px}

/* SOCIAL PROOF */
.bp-proof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:48px}
.bp-proof-card{background:rgba(255,255,255,.04);border:1px solid rgba(232,168,80,.15);border-radius:18px;padding:28px 24px;display:flex;flex-direction:column;gap:14px}
.bp-proof-top{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.bp-proof-pax{background:rgba(232,168,80,.15);color:#e8a850;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;padding:4px 10px;border-radius:20px}
.bp-proof-nights{font-size:13px;color:rgba(245,240,232,.5);font-weight:600}
.bp-proof-price{margin-left:auto;font-family:'Playfair Display',serif;font-size:20px;color:#f5f0e8;font-weight:400}
.bp-proof-courses{font-size:13px;color:rgba(245,240,232,.65);line-height:1.5}
.bp-proof-why{font-size:14px;color:rgba(245,240,232,.8);line-height:1.65;font-style:italic;flex:1}
.bp-proof-mike{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:rgba(232,168,80,.6)}

/* MIKE */
.bp-mike-wrap{display:grid;grid-template-columns:1fr 420px;gap:72px;align-items:center}
.bp-mike-body{font-size:15px;color:rgba(245,240,232,.72);line-height:1.8;margin:16px 0 0}
.bp-mike-img{position:relative;border-radius:22px;overflow:hidden;box-shadow:0 32px 80px rgba(0,0,0,.45)}
.bp-mike-img img{width:100%;height:480px;object-fit:cover;object-position:top;display:block}
.bp-mike-badge{position:absolute;bottom:20px;left:20px;right:20px;background:rgba(13,26,14,.88);backdrop-filter:blur(14px);border:1px solid rgba(232,168,80,.22);border-radius:14px;padding:14px 18px}
.bp-mike-name{font-family:'Playfair Display',serif;font-size:18px;color:#f5f0e8;font-weight:400;margin-bottom:4px}
.bp-mike-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:rgba(232,168,80,.8)}

/* FAQ */
.bp-faqs{display:flex;flex-direction:column}
.bp-faq{border-bottom:1px solid var(--bp-border)}
.bp-faq[open]{background:rgba(232,168,80,.03);border-radius:12px;border-color:rgba(232,168,80,.22)}
.bp-faq-q{font-size:15px;font-weight:600;color:var(--bp-text);padding:20px 0;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px}
.bp-faq-q::-webkit-details-marker{display:none}
.bp-faq[open] .bp-faq-q{color:var(--bp-green)}
.bp-faq-icon{font-size:24px;color:var(--bp-gold);flex-shrink:0;transition:transform .3s}
.bp-faq[open] .bp-faq-icon{transform:rotate(45deg)}
.bp-faq-a{font-size:14px;color:var(--bp-muted);line-height:1.82;padding:0 0 20px;margin:0}

/* FINAL CTA */
.bp-cta-final{padding:clamp(80px,10vw,132px) 0;position:relative;overflow:hidden}
.bp-cta-glow{position:absolute;width:720px;height:720px;border-radius:50%;background:radial-gradient(circle,rgba(26,122,64,.18) 0%,transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none}
.bp-cta-h2{font-family:'Playfair Display',serif;font-size:clamp(30px,5.5vw,56px);color:#f5f0e8;font-weight:500;line-height:1.15;margin:0 0 18px}
.bp-cta-h2 em{color:var(--bp-gold);font-style:italic}
.bp-cta-sub{font-size:16px;color:rgba(245,240,232,.76);line-height:1.75;margin:0 0 36px}

/* MOBILE */
@media(max-width:900px){
  .bp-hero{min-height:100svh}
  .bp-floats{display:none}
  .bp-courses{grid-template-columns:1fr}
  .bp-lodging{grid-template-columns:1fr}
  .bp-proof-grid{grid-template-columns:1fr}
  .bp-mike-wrap{grid-template-columns:1fr}
  .bp-mike-img{display:none}
  /* Mobile hero: H1 then CTA immediately — sub and pills move below */
  .bp-hero-inner{display:flex;flex-direction:column}
  .bp-eyebrow{order:1}
  .bp-h1{order:2}
  .bp-ctas{order:3;margin-bottom:12px}
  .bp-trust{order:4;margin-bottom:16px}
  .bp-sub{order:5;font-size:15px;margin-bottom:16px}
  .bp-pills{order:6;margin-bottom:0}
  /* Tighten section padding on mobile */
  .bp-section{padding:clamp(48px,8vw,72px) 0}
  .bp-cta-inline{padding:clamp(36px,5vw,56px) 0}
}
/* Mobile-only elements */
.bp-mobile-only{display:none}
@media(max-width:900px){.bp-mobile-only{display:block}}
@media(max-width:540px){
  .bp-included{grid-template-columns:1fr 1fr}
}
</style>
