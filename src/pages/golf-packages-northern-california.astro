---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import RelatedTrips from '../components/RelatedTrips.tsx';
import { fetchTripStats } from '../lib/tripStats';
const { minPrice, trips: allTrips } = await fetchTripStats();

const proofTrips = allTrips
  .filter((t: any) => t.pricePerPerson && t.whyItWorked)
  .sort((a: any, b: any) => a.pricePerPerson - b.pricePerPerson)
  .slice(0, 3);

const title = "Golf Packages Northern California | Sierra Nevada";
const description = "The best golf packages in Northern California are in Graeagle — Golf Digest Top 100, Frank Lloyd Wright clubhouse, 5 courses within 25 minutes. From $299/golfer.";
const ogImage = "/wp-images/graeagle-meadows-aerial.jpg";

const faqSchema = {
  "@context":"https://schema.org","@type":"FAQPage",
  "mainEntity":[
    {"@type":"Question","name":"Where is the best golf in Northern California?","acceptedAnswer":{"@type":"Answer","text":"Graeagle in Plumas County is widely considered the best multi-course golf destination in Northern California. The region has five championship courses within 25 minutes: Grizzly Ranch (Golf Digest Top 100 Greatest Public Courses in the US), Nakoma Dragon (Golf World Top 75, the only Frank Lloyd Wright-designed golf clubhouse), Whitehawk Ranch (Top 20 Golf Courses in California), Plumas Pines, and Graeagle Meadows."}},
    {"@type":"Question","name":"How far is Graeagle from Sacramento for a golf trip?","acceptedAnswer":{"@type":"Answer","text":"Graeagle is approximately 2.5 hours northeast of Sacramento via Highway 70 through the Feather River Canyon. It is 3.5–4 hours from San Francisco and about 1 hour west of Reno, Nevada. Most Northern California golfers come from Sacramento, the Bay Area, and Reno."}},
    {"@type":"Question","name":"What golf courses are in Northern California mountains?","acceptedAnswer":{"@type":"Answer","text":"The best mountain golf courses in Northern California are concentrated in the Graeagle area of Plumas County: Grizzly Ranch (par 72, 7,411 yards, slope 140, Golf Digest Top 100), Nakoma Dragon (par 72, 7,015 yards, slope 147, Golf World Top 75), Whitehawk Ranch (par 71, 6,983 yards, slope 132, Top 20 California), Plumas Pines (par 72, 6,504 yards, slope 132), and Graeagle Meadows (par 72, 6,759 yards, slope 120, designed by Ellis Van Gorder in 1968)."}},
    {"@type":"Question","name":"What is the best golf course near Sacramento?","acceptedAnswer":{"@type":"Answer","text":"For a day trip, Dry Creek Ranch and Woodbridge Golf & Country Club are within an hour of Sacramento. For a proper golf destination trip, Graeagle (2.5 hours northeast) is the strongest option: Golf Digest Top 100 at Grizzly Ranch, Golf World Top 75 at Nakoma Dragon, and three other championship courses — all within 25 minutes of each other."}},
    {"@type":"Question","name":"Can GolfGraeagle book tee times for a large group in Northern California?","acceptedAnswer":{"@type":"Answer","text":"Yes. GolfGraeagle builds packages for groups from 2 to 200+ golfers across all five Graeagle courses. Group tee sheet blocks, lodging coordination for up to 100+ guests, and custom multi-day itineraries are all included in a free 24-hour quote."}},
  ]
};

const breadcrumbSchema = {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
  {"@type":"ListItem","position":1,"name":"Home","item":"https://golfgraeagle.com/"},
  {"@type":"ListItem","position":2,"name":"Golf Packages Northern California","item":"https://golfgraeagle.com/golf-packages-northern-california/"}
]};

const serviceSchema = {
  "@context":"https://schema.org","@type":"Service",
  "name":"Golf Packages — Northern California",
  "description":"Custom golf packages in Northern California's Sierra Nevada mountains — Graeagle, Plumas County. 5 championship courses, mountain lodging, guaranteed tee times. From $299/golfer.",
  "provider":{"@type":"TravelAgency","@id":"https://golfgraeagle.com/#organization"},
  "areaServed":{"@type":"Place","name":"Northern California"},
  "serviceType":"Golf Package"
};

const origins = [
  { city:'Sacramento', drive:'~2.5 hrs', via:'Hwy 70 through Feather River Canyon', note:'Most popular origin. Morning departure → afternoon round at Graeagle Meadows.' },
  { city:'San Francisco / Bay Area', drive:'~3.5–4 hrs', via:'I-80 to Truckee or Hwy 70 from Sacramento', note:'Fly into SMF + rent a car, or drive I-80 to US-395 cutoff. Best for 3-night trips.' },
  { city:'Reno, NV', drive:'~1 hr', via:'US-395 South to Hwy 89', note:'Closest major city. Easy long-weekend golf trip from Reno or Northern Nevada.' },
  { city:'Chico / Redding', drive:'~2–2.5 hrs', via:'Hwy 70 South or I-5 to Hwy 70', note:'Northern California gateway. Natural fit for multi-day trips combining Graeagle and Mt. Shasta area.' },
];

const courses = [
  { name:'Grizzly Ranch', slug:'grizzly-ranch-golf-packages', accolade:'Golf Digest Top 100', img:'/wp-images/grizzly-ranch-hero.webp', alt:'Grizzly Ranch Golf Club — Golf Digest Top 100 Northern California golf packages', par:72, yards:'7,411', slope:140, designer:'Bob Cupp', year:2005 },
  { name:'Nakoma Dragon', slug:'nakoma-dragon-golf-packages', accolade:'Golf World Top 75', img:'/wp-images/nakoma-dragon-feather-river.webp', alt:'Nakoma Dragon Golf Course — Frank Lloyd Wright Northern California', par:72, yards:'7,015', slope:147, designer:'Robin Nelson & Neil Haworth', year:1998 },
  { name:'Whitehawk Ranch', slug:'whitehawk-ranch-golf-packages', accolade:'Top 20 California', img:'/wp-images/whitehawk-hero.webp', alt:'Whitehawk Ranch Golf Course — Top 20 California golf packages', par:71, yards:'6,983', slope:132, designer:'Dick Bailey', year:1996 },
  { name:'Plumas Pines', slug:'plumas-pines-golf-packages', accolade:'Top 5 Value Sierra Nevada', img:'/wp-images/plumas-pines-hero.webp', alt:'Plumas Pines Golf Resort — Northern California golf packages', par:72, yards:'6,504', slope:132, designer:'Homer Flint', year:1980 },
  { name:'Graeagle Meadows', slug:'graeagle-meadows-golf-packages', accolade:'Sierra Nevada Classic', img:'/wp-images/graeagle-meadows-aerial.jpg', alt:'Graeagle Meadows Golf Course — Northern California golf packages mountain', par:72, yards:'6,759', slope:120, designer:'Ellis Van Gorder', year:1968 },
];

const QUOTE_URL = '/request-a-quote/?groupType=norCal&ref=norcal-packages-landing';
---

<Base
  title={title}
  description={description}
  ogImage={ogImage}
  schema={[faqSchema, breadcrumbSchema, serviceSchema]}
>
  <Nav />

  <!-- ═══ HERO ═══ -->
  <section class="nc-hero">
    <div class="nc-bg" style="background-image:url('/wp-images/graeagle-meadows-aerial.jpg')"></div>
    <div class="nc-overlay"></div>
    <div class="nc-hero-inner">
      <p class="nc-eyebrow">Northern California · Sierra Nevada · Plumas County</p>
      <h1 class="nc-h1">Golf packages in<br/><em>Northern California</em><br/>worth the drive.</h1>
      <p class="nc-sub">Two nationally-ranked courses. A Frank Lloyd Wright clubhouse. Five championship tracks within 25 minutes of each other. Graeagle is 2.5 hours from Sacramento and still one of the least-crowded golf destinations in California.</p>
      <div class="nc-pills">
        <span><strong>Golf Digest</strong> Top 100</span>
        <span><strong>Golf World</strong> Top 75</span>
        <span>From <strong>$299</strong>/golfer</span>
        <span>2.5 hrs from Sacramento</span>
      </div>
      <div class="nc-ctas">
        <a href={QUOTE_URL} class="btn-green-glow nc-btn">Get a Northern California Golf Quote →</a>
        <a href="/all-golf-courses/" class="nc-ghost">See all 5 courses ↓</a>
      </div>
      <p class="nc-trust">Free · No commitment · 24hr response · 4.8★ verified</p>
    </div>
    <div class="nc-floats">
      <div class="nc-float"><div class="nc-float-val">5</div><div class="nc-float-lbl">Championship Courses</div></div>
      <div class="nc-float"><div class="nc-float-val">25 min</div><div class="nc-float-lbl">Between All Courses</div></div>
      <div class="nc-float"><div class="nc-float-val">$299+</div><div class="nc-float-lbl">Per Golfer</div></div>
    </div>
  </section>

  <!-- ═══ DRIVE TIMES ═══ -->
  <section class="nc-section">
    <div class="nc-container">
      <div class="nc-header reveal-up">
        <span class="sec-label">How to get to Graeagle, Northern California</span>
        <h2 class="nc-h2">Closer than you think<br/><em>from anywhere in NorCal</em></h2>
      </div>
      <div class="nc-origins">
        {origins.map((o, i) => (
          <div class={`nc-origin-card reveal-up delay-${i+1}`}>
            <div class="nc-origin-city">{o.city}</div>
            <div class="nc-origin-drive">{o.drive}</div>
            <div class="nc-origin-via">via {o.via}</div>
            <p class="nc-origin-note">{o.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ COURSES ═══ -->
  <section class="nc-section nc-alt">
    <div class="nc-container">
      <div class="nc-header reveal-up">
        <span class="sec-label">Northern California's best mountain golf courses</span>
        <h2 class="nc-h2">The Graeagle lineup —<br/><em>all bookable in one package</em></h2>
      </div>
      <div class="nc-courses">
        {courses.map((c, i) => (
          <div class={`nc-course-card glow-card reveal-up delay-${i+1}`}>
            <div class="nc-course-img-wrap">
              <img src={c.img} alt={c.alt} loading="lazy" class="nc-course-img"/>
              <div class="nc-course-fade"></div>
              <span class="nc-course-badge">{c.accolade}</span>
            </div>
            <div class="nc-course-body">
              <div class="nc-course-name">{c.name}</div>
              <div class="nc-course-specs">Par {c.par} · {c.yards} yds · Slope {c.slope}</div>
              <div class="nc-course-design">{c.designer}, {c.year}</div>
              <a href={`/portfolio/${c.slug}/`} class="nc-course-link underline-draw">View packages ↗</a>
            </div>
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:48px">
        <a href={QUOTE_URL} class="btn-green-glow nc-btn reveal-scale">Build My NorCal Golf Package →</a>
      </div>
    </div>
  </section>


  <!-- ═══ COURSE COMPARISON TABLE ═══ -->
  <section class="nc-section nc-ALT">
    <div class="nc-container">
      <div class="nc-header reveal-up">
        <span class="sec-label">Compare all 5 Graeagle golf courses</span>
        <h2 class="nc-h2">Pick your courses.<br/><em>We book the rest.</em></h2>
      </div>
      <div class="nc-table-wrap reveal-up delay-1">
        <table class="nc-table">
          <thead>
            <tr>
              <th>Course</th>
              <th>Par / Yards</th>
              <th>Slope</th>
              <th>Difficulty</th>
              <th>Best for</th>
              <th>Price tier</th>
            </tr>
          </thead>
          <tbody>
            <tr><td><strong><a href="/portfolio/grizzly-ranch-golf-packages/" style="color:#1a7a40;text-decoration:none;">Grizzly Ranch</a></strong><br/><span style="font-size:11px;color:rgba(28,18,8,0.45);">Golf Digest Top 100</span></td><td>72 / 7,411</td><td>140</td><td>Very Hard</td><td>Low handicap</td><td>$$$$</td></tr>
            <tr><td><strong><a href="/portfolio/nakoma-dragon-golf-packages/" style="color:#1a7a40;text-decoration:none;">Nakoma Dragon</a></strong><br/><span style="font-size:11px;color:rgba(28,18,8,0.45);">Golf World Top 75 · FLW clubhouse</span></td><td>72 / 7,015</td><td>147</td><td>Hardest</td><td>Low handicap</td><td>$$$$</td></tr>
            <tr><td><strong><a href="/portfolio/whitehawk-ranch-golf-packages/" style="color:#1a7a40;text-decoration:none;">Whitehawk Ranch</a></strong><br/><span style="font-size:11px;color:rgba(28,18,8,0.45);">Top 20 California</span></td><td>71 / 6,983</td><td>132</td><td>Challenging</td><td>Mid–low handicap</td><td>$$$</td></tr>
            <tr><td><strong><a href="/portfolio/plumas-pines-golf-packages/" style="color:#1a7a40;text-decoration:none;">Plumas Pines</a></strong><br/><span style="font-size:11px;color:rgba(28,18,8,0.45);">Top 5 Best Value Sierra Nevada</span></td><td>72 / 6,504</td><td>132</td><td>Moderate</td><td>All levels</td><td>$$</td></tr>
            <tr><td><strong><a href="/portfolio/graeagle-meadows-golf-packages/" style="color:#1a7a40;text-decoration:none;">Graeagle Meadows</a></strong><br/><span style="font-size:11px;color:rgba(28,18,8,0.45);">Sierra Nevada Classic since 1968</span></td><td>72 / 6,759</td><td>120</td><td>Moderate</td><td>All levels, seniors</td><td>$$</td></tr>
          </tbody>
        </table>
      </div>
      <div style="text-align:center;margin-top:36px;">
        <a href="/all-golf-courses/" style="font-size:14px;color:#1a7a40;text-decoration:underline;">Full course guide with photos and details →</a>
      </div>
    </div>
  </section>

  <!-- ═══ INLINE CTA ═══ -->
  <section class="nc-cta-inline">
    <div class="nc-container" style="text-align:center;max-width:600px">
      <p class="nc-cta-line reveal-up">Know your dates and group size?</p>
      <a href={QUOTE_URL} class="btn-green-glow nc-btn reveal-scale delay-1">Get a Free Golf Package Quote →</a>
      <p class="nc-cta-trust reveal-up delay-2">Free · No commitment · 24hr response</p>
    </div>
  </section>

  <!-- ═══ WHY GRAEAGLE ═══ -->
  <section class="nc-section nc-dark">
    <div class="nc-container">
      <div class="nc-header reveal-up">
        <span class="sec-label" style="color:#e8a850">Why Graeagle outperforms other Northern California golf destinations</span>
        <h2 class="nc-h2" style="color:#f5f0e8">The strongest golf package<br/><em>in Northern California</em></h2>
      </div>
      <div class="nc-why-grid">
        {[
          { icon:'🏆', h:'Two nationally-ranked courses in one valley', p:'Grizzly Ranch is on the Golf Digest Top 100 Greatest Public Courses in the US. Nakoma Dragon debuted on Golf World\'s Top 75. No other Northern California destination outside Pebble Beach concentrates ranked courses this way.' },
          { icon:'📍', h:'All 5 courses within a 25-minute radius', p:'Sacramento Delta courses are spread across I-5 corridors. Tahoe courses are separated by mountain driving. In Graeagle, all five championship courses are in a single mountain valley — zero commute between rounds.' },
          { icon:'🏡', h:'Stay inside the courses', p:'The Inn at Nakoma is built inside the Frank Lloyd Wright-designed Nakoma Dragon clubhouse. The Townhomes at Plumas Pines are adjacent to the first tee at Plumas Pines. These are Northern California\'s only true golf resort lodging options.' },
          { icon:'💰', h:'Golf Digest Top 100 value without Pebble Beach prices', p:'Grizzly Ranch is a Golf Digest Top 100 course. It doesn\'t charge Golf Digest Top 100 prices. Graeagle as a whole runs well below comparable destination golf in Monterey or Palm Springs.' },
        ].map((w, i) => (
          <div class={`nc-why-card reveal-up delay-${i+1}`}>
            <div class="nc-why-icon">{w.icon}</div>
            <h3 class="nc-why-h">{w.h}</h3>
            <p class="nc-why-p">{w.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ SOCIAL PROOF ═══ -->
  {proofTrips.length > 0 && (
  <section class="nc-section">
    <div class="nc-container">
      <div class="nc-header reveal-up">
        <span class="sec-label">Real Northern California golf packages — completed trips</span>
        <h2 class="nc-h2">Actual packages. Actual prices.<br/><em>Actual groups.</em></h2>
      </div>
      <div class="nc-proof-grid">
        {proofTrips.map((t: any, i: number) => {
          const courseNames = (t.courses || []).map((c: string) => c.replace(/ Golf (Club|Course|Resort)$/i,'').replace(/ Club$| Course$/,''));
          return (
            <div class={`nc-proof-card reveal-up delay-${i+1}`}>
              <div class="nc-proof-top">
                <span class="nc-proof-pax">{t.groupSize} golfers</span>
                <span class="nc-proof-nights">{t.nights}N / {t.rounds}R</span>
                <span class="nc-proof-price">${t.pricePerPerson}/pp</span>
              </div>
              <div class="nc-proof-courses">
                {courseNames.slice(0,3).map((c: string, j: number) => (
                  <span>{c}{j < Math.min(courseNames.length,3)-1 ? ' · ' : ''}</span>
                ))}
              </div>
              <p class="nc-proof-why">"{t.whyItWorked}"</p>
              <div class="nc-proof-mike">— <a href="/about/mike-eskuchen/" style="color:inherit;text-decoration:underline;text-underline-offset:3px;opacity:0.8;">Mike Eskuchen</a>, Golf Trip Specialist</div>
            </div>
          );
        })}
      </div>
      <div style="text-align:center;margin-top:40px">
        <a href={QUOTE_URL} class="btn-green-glow nc-btn reveal-scale">Get My NorCal Golf Quote →</a>
      </div>
    </div>
  </section>
  )}

  <!-- ═══ FAQ ═══ -->
  <section class="nc-section nc-alt">
    <div class="nc-container" style="max-width:760px">
      <div class="nc-header reveal-up">
        <span class="sec-label">Northern California golf packages — planning questions</span>
        <h2 class="nc-h2">Common questions,<br/><em>answered</em></h2>
      </div>
      <div class="nc-faqs">
        {faqSchema.mainEntity.map((q: any, i: number) => (
          <details class={`nc-faq reveal-up delay-${i+1}`}>
            <summary class="nc-faq-q">
              {q.name}
              <span class="nc-faq-icon">+</span>
            </summary>
            <p class="nc-faq-a">{q.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FINAL CTA ═══ -->
  <section class="nc-cta-final nc-dark">
    <div class="nc-cta-glow"></div>
    <div class="nc-container" style="text-align:center;max-width:620px;position:relative;z-index:1">
      <h2 class="nc-cta-h2 reveal-up">Northern California's best golf package<br/><em>starts with one call.</em></h2>
      <p class="nc-cta-sub reveal-up delay-1">Tell Mike your dates, group size, and which courses you want. He builds a complete Northern California golf package — tee times at all 5 Graeagle courses, mountain lodging, full itinerary — and sends it back within 24 hours.</p>
      <div class="reveal-scale delay-2">
        <a href={QUOTE_URL} class="btn-green-glow nc-btn">Plan My Northern California Golf Trip →</a>
        <p style="font-size:12px;color:rgba(245,240,232,.28);margin-top:14px;">2.5 hrs from Sacramento · 5 courses · 24hr quote · Free</p>
      </div>
    </div>
  </section>


  <!-- ═══ DINING XSELL ═══ -->
  <section class="nc-section" style="padding-top:0;padding-bottom:clamp(48px,6vw,72px);">
    <div class="nc-container" style="max-width:860px;">
      <div style="background:rgba(232,168,80,0.06);border:1px solid rgba(232,168,80,0.18);border-radius:14px;padding:24px 28px;">
        <p style="font-size:10px;color:#a06c30;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;margin:0 0 10px;">Group Dining — Coordinated by GolfGraeagle</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(180px,45vw),1fr));gap:10px;">
          {[
            {name:'Grizzly Grill', note:'Group dinner favourite — stone hearth, local game, exposed beams', slug:'grizzly-grill'},
            {name:'The Roadhouse', note:'On-site at River Pines — steaks, ribs, walk in after 18', slug:'roadhouse-at-river-pines'},
            {name:"Cuccia's", note:"#1 rated in Graeagle — handmade pizza, pasta, wine bar", slug:'cuccias'},
            {name:'Iron Door', note:'Historic steakhouse since 1961 — great for the big group dinner', slug:'iron-door'},
          ].map(d => (
            <a href={`/portfolio/${d.slug}/`} style="padding:12px 14px;background:#fff;border:1px solid rgba(28,18,8,0.07);border-radius:8px;text-decoration:none;display:block;" onmouseover="this.style.borderColor='rgba(232,168,80,0.35)'" onmouseout="this.style.borderColor='rgba(28,18,8,0.07)'">
              <div style="font-size:13px;font-weight:600;color:#1a2e1a;margin-bottom:4px;">{d.name}</div>
              <div style="font-size:11px;color:rgba(28,18,8,0.45);line-height:1.5;">{d.note}</div>
            </a>
          ))}
        </div>
        <p style="font-size:12px;color:rgba(28,18,8,0.4);margin:14px 0 0;">GolfGraeagle can coordinate group dining reservations alongside your tee times and lodging — <a href="/dining/" style="color:#a06c30;text-decoration:none;">browse all restaurants →</a></p>
      </div>
    </div>
  </section>

  <div style="max-width:860px;margin:0 auto;padding:32px clamp(20px,6%,80px) 0;display:flex;flex-wrap:wrap;gap:12px 24px;">
    <a href="/graeagle-golf-vacation/" style="font-size:14px;color:#1a7a40;text-decoration:underline;">Plan a Graeagle golf vacation →</a>
    <a href="/stay-and-play-golf-california/" style="font-size:14px;color:#1a7a40;text-decoration:underline;">Stay and play golf California →</a>
    <a href="/golf-trip-from-sacramento/" style="font-size:14px;color:#1a7a40;text-decoration:underline;">Golf trip from Sacramento →</a>
    <a href="/all-golf-courses/" style="font-size:14px;color:#1a7a40;text-decoration:underline;">All 5 Graeagle courses →</a>
  </div>
  <RelatedTrips client:load slug="norcal" type="course" showAll={true} max={3} />
  <Footer />
</Base>

<style>
:root{--nc-gold:#e8a850;--nc-green:#1a7a40;--nc-dark:#0d1a0e;--nc-text:#1c1208;--nc-muted:rgba(28,18,8,0.52);--nc-border:rgba(28,18,8,0.08);--nc-r:20px}
.nc-container{max-width:1140px;margin:0 auto;padding:0 clamp(20px,6%,80px)}
.nc-section{padding:clamp(72px,9vw,120px) 0;background:var(--page-bg,#f8f5f0)}
.nc-alt{background:#fff!important}
.nc-dark{background:var(--nc-dark)!important}
.nc-header{text-align:center;margin-bottom:clamp(40px,5vw,68px)}
.nc-h2{font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,50px);font-weight:500;color:var(--nc-text);line-height:1.1;margin:8px 0 0}
.nc-h2 em{font-style:italic;color:var(--nc-green)}
/* HERO */
.nc-hero{position:relative;min-height:92vh;display:flex;align-items:flex-end;overflow:hidden}
.nc-bg{position:absolute;inset:0;background-size:cover;background-position:center 30%;transform:scale(1.07);animation:ncZoom 10s ease forwards}
@keyframes ncZoom{to{transform:scale(1)}}
.nc-overlay{position:absolute;inset:0;background:linear-gradient(160deg,rgba(13,26,14,.05) 0%,rgba(13,26,14,.45) 40%,rgba(13,26,14,.96) 100%)}
.nc-hero-inner{position:relative;z-index:2;padding:0 clamp(24px,8%,120px) clamp(60px,8vw,100px);max-width:820px}
.nc-eyebrow{font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:rgba(232,168,80,.82);margin:0 0 18px}
.nc-h1{font-family:'Playfair Display',serif;font-size:clamp(42px,7vw,88px);font-weight:500;color:#f5f0e8;line-height:.98;margin:0 0 18px}
.nc-h1 em{font-style:italic;color:var(--nc-gold)}
.nc-sub{font-size:clamp(16px,2vw,21px);color:rgba(245,240,232,.62);line-height:1.55;margin:0 0 26px}
.nc-pills{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px}
.nc-pills span{font-size:12px;font-weight:600;color:rgba(245,240,232,.8);padding:6px 15px;background:rgba(255,255,255,.1);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.18);border-radius:100px}
.nc-pills strong{color:var(--nc-gold)}
