---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import RelatedTrips from '../components/RelatedTrips.tsx';
import { fetchTripStats } from '../lib/tripStats';
const { minPrice, trips: allTrips } = await fetchTripStats();

// Social proof: real completed 2-3 night Graeagle weekend trips with commentary
const proofTrips = allTrips
  .filter((t: any) => t.nights >= 2 && t.nights <= 3 && t.pricePerPerson && t.whyItWorked)
  .sort((a: any, b: any) => a.pricePerPerson - b.pricePerPerson)
  .slice(0, 3);

const title = "Graeagle Golf Weekend Packages | 2 & 3-Night Stay & Play";
const description = "Graeagle golf weekend packages — 2 or 3 nights, 2–5 championship courses, lodging and tee times bundled. From $379/golfer. Free custom itinerary in 24 hours.";

const faqSchema = {
  "@context":"https://schema.org","@type":"FAQPage",
  "mainEntity":[
    {"@type":"Question","name":"How many courses can you play on a Graeagle golf weekend?","acceptedAnswer":{"@type":"Answer","text":"On a 2-night weekend you can comfortably play 3 courses — one round Friday afternoon, one Saturday, one Sunday morning before heading home. A 3-night stay allows 4 courses. All 5 Graeagle courses are within 25 minutes of each other, so logistics are simple."}},
    {"@type":"Question","name":"How much does a Graeagle golf weekend cost per person?","acceptedAnswer":{"@type":"Answer","text":"Real completed weekend packages range from $620 to $875 per person for a 2-night, 3-course stay-and-play with lodging. Smaller groups of 2–4 golfers pay slightly more per person. Groups of 8+ typically get better per-person rates."}},
    {"@type":"Question","name":"When is the best weekend to golf in Graeagle?","acceptedAnswer":{"@type":"Answer","text":"June, September, and early October are the best weekends. June has long days and fresh course conditions. September and October bring fewer crowds, fall colors, and cooler mornings. Summer weekends (July–August) need 6–8 weeks advance booking."}},
    {"@type":"Question","name":"Which courses should I play on a Graeagle golf weekend?","acceptedAnswer":{"@type":"Answer","text":"Most first-timers start at Graeagle Meadows or Plumas Pines as the opener, play Whitehawk Ranch or Grizzly Ranch as the main round, and save Nakoma Dragon for the final morning. GolfGraeagle sequences courses by difficulty and drive time so your weekend flows naturally."}},
    {"@type":"Question","name":"Can I book a Graeagle golf weekend for just 2 golfers?","acceptedAnswer":{"@type":"Answer","text":"Yes. GolfGraeagle builds packages for groups from 2 to 200+ golfers. Smaller groups of 2–4 golfers can get single tee times at all 5 courses. Lodging options include the Inn at Nakoma and River Pines Resort, both suited to small groups."}},
  ]
};

const breadcrumbSchema = {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
  {"@type":"ListItem","position":1,"name":"Home","item":"https://golfgraeagle.com/"},
  {"@type":"ListItem","position":2,"name":"Graeagle Golf Weekend Packages","item":"https://golfgraeagle.com/graeagle-golf-weekend-packages/"}
]};

const orgSchema = {"@context":"https://schema.org","@graph":[
  {"@type":["TravelAgency","Organization"],"@id":"https://golfgraeagle.com/#organization","name":"GolfGraeagle.com","url":"https://golfgraeagle.com",
    "aggregateRating":{"@type":"AggregateRating","ratingValue":"4.8","reviewCount":"672","bestRating":"5"}},
  {"@type":"WebPage","url":"https://golfgraeagle.com/graeagle-golf-weekend-packages/","name":title}
]};

const serviceSchema = {
  "@context":"https://schema.org","@type":"Service",
  "name":"Graeagle Golf Weekend Packages",
  "description":"Stay-and-play golf weekend packages in Graeagle, CA — 2 or 3 nights, tee times at all 5 championship courses, lodging bundled. From $379/golfer.",
  "provider":{"@type":"TravelAgency","@id":"https://golfgraeagle.com/#organization"},
  "areaServed":{"@type":"Place","name":"Graeagle, California"},
  "serviceType":"Golf Weekend Package"
};

const courses = [
  { name:'Grizzly Ranch', slug:'grizzly-ranch-golf-packages', accolade:'Golf Digest Top 100', img:'/wp-images/grizzly-ranch-hero.webp', alt:'Grizzly Ranch Golf Club — Golf Digest Top 100, Graeagle golf weekend', line:'The anchor round. Book this first — it sets the standard for the whole weekend.' },
  { name:'Whitehawk Ranch', slug:'whitehawk-ranch-golf-packages', accolade:'Top 20 California', img:'/wp-images/whitehawk-hero.webp', alt:'Whitehawk Ranch Golf Course — Graeagle golf weekend package', line:'Top 20 California. Meadow fairways, mountain backdrops. Day one opener.' },
  { name:'Nakoma Dragon', slug:'nakoma-dragon-golf-packages', accolade:'Golf World Top 75', img:'/wp-images/nakoma-dragon-feather-river.webp', alt:'Nakoma Dragon Golf Course — Frank Lloyd Wright, Graeagle golf weekend', line:'The Frank Lloyd Wright clubhouse. Save it for the last morning — the best send-off.' },
  { name:'Graeagle Meadows', slug:'graeagle-meadows-golf-packages', accolade:'Sierra Nevada Classic', img:'/wp-images/graeagle-meadows-aerial.jpg', alt:'Graeagle Meadows Golf Course — Graeagle golf weekend', line:'The most accessible course in the valley. Perfect for mixed groups.' },
  { name:'Plumas Pines', slug:'plumas-pines-golf-packages', accolade:'Top 5 Best Value Sierra Nevada', img:'/wp-images/plumas-pines-hero.webp', alt:'Plumas Pines Golf Resort — Graeagle golf weekend lodging on course', line:'On-course lodging available. Tight pines, small greens — tests placement.' },
];

const itineraries = [
  { label:'2 nights', nights:'Fri–Sun', rounds:'3 courses', tag:'Most Popular', desc:'Friday: Check in, Graeagle Meadows afternoon round, dinner at Grizzly Grill. Saturday: Grizzly Ranch (the big one). Sunday: Whitehawk Ranch, drive home.' },
  { label:'3 nights', nights:'Thu–Sun', rounds:'4 courses', tag:'Best Value', desc:'Add Nakoma Dragon on Saturday morning. 4 championship courses, 3 nights, one legendary weekend.' },
];

const lodging = [
  { name:'Townhomes at Plumas Pines', slug:'the-townhomes-at-plumas-pines', img:'/wp-images/plumas-pines-hero.webp', alt:'Townhomes at Plumas Pines — Graeagle golf weekend lodging', tag:'Steps from the 1st Tee', desc:'2–4 bedroom units on the Plumas Pines course. Full kitchens. Best for groups of 4–16.' },
  { name:'Inn at Nakoma', slug:'the-inn-at-nakoma-clio-ca', img:'/wp-images/nakoma-flw-lodge-exterior.webp', alt:'Inn at Nakoma — Frank Lloyd Wright golf weekend lodging Graeagle', tag:'Most Unique Stay', desc:'42 rooms inside the Frank Lloyd Wright clubhouse. The Dragon course outside your window.' },
];

const included = [
  { icon:'⛳', title:'Tee times at all 5 courses', body:'Single tee times or group blocks — we deal directly with every pro shop. No calling around.' },
  { icon:'🏘', title:'Lodging matched to your group', body:'2 golfers or 20, hotel rooms or townhomes — matched to your size and budget.' },
  { icon:'📋', title:'Day-by-day itinerary', body:'Courses in the right order, drive times between venues, dining recommendations built in.' },
  { icon:'⚡', title:'Free quote in 24 hours', body:'Tell us your dates, group size, and which courses you want. Mike sends a full proposal back fast.' },
];

const QUOTE_URL = '/request-a-quote/?groupType=weekend&ref=weekend-landing';
---

<Base
  title={title}
  description={description}
  ogType="website"
  schema={[orgSchema, faqSchema, breadcrumbSchema, serviceSchema]}
  canonical="https://golfgraeagle.com/graeagle-golf-weekend-packages/"
  ogImage="https://golfgraeagle.com/wp-images/graeagle-meadows-aerial.jpg"
  bodyClass="light-page"
>
  <Nav />

  <!-- ═══ HERO ═══ -->
  <section class="wk-hero">
    <div class="wk-bg" style="background-image:url(/wp-images/graeagle-meadows-aerial.jpg)"></div>
    <div class="wk-overlay"></div>
    <div class="wk-hero-inner">
      <p class="wk-eyebrow reveal-up">Graeagle Golf Weekend · Sierra Nevada, California · 5 Courses</p>
      <h1 class="wk-h1 reveal-up delay-1">2 nights.<br/><em>3 courses. Sorted.</em></h1>
      <p class="wk-sub speakable reveal-up delay-2">Five championship courses within 25 minutes of each other. Golf Digest Top 100, Frank Lloyd Wright clubhouse, tee times and lodging bundled. GolfGraeagle builds the itinerary — you show up and play.</p>
      <div class="wk-pills reveal-up delay-3">
        <span>From <strong>${minPrice}</strong>/golfer</span>
        <span>2–20+ golfers</span>
        <span>2 or 3 nights</span>
        <span>24hr quote</span>
      </div>
      <div class="wk-ctas reveal-up delay-4">
        <a href={QUOTE_URL} class="btn-green-glow wk-btn">Plan My Golf Weekend →</a>
        <a href="/trips/" class="wk-ghost underline-draw">See real weekend pricing ↗</a>
      </div>
      <p class="wk-trust reveal-up delay-5">Free · No commitment · Response within 24 hours</p>
    </div>
    <div class="wk-floats reveal-fade delay-5">
      <div class="wk-float"><div class="wk-float-val">5</div><div class="wk-float-lbl">Courses</div></div>
      <div class="wk-float"><div class="wk-float-val">25 min</div><div class="wk-float-lbl">Between courses</div></div>
      <div class="wk-float"><div class="wk-float-val">4.8★</div><div class="wk-float-lbl">Avg Rating</div></div>
    </div>
  </section>

  <!-- ═══ ITINERARY OPTIONS ═══ -->
  <section class="wk-section">
    <div class="wk-container">
      <div class="wk-header reveal-up">
        <span class="sec-label">Real Graeagle golf weekend itineraries</span>
        <h2 class="wk-h2">Pick your weekend<br/><em>format</em></h2>
      </div>
      <div class="wk-itins">
        {itineraries.map((itin, i) => (
          <div class={`wk-itin glow-card reveal-scale delay-${i+1}${itin.tag==='Most Popular'?' wk-itin-hot':''}`}>
            {itin.tag==='Most Popular' && <div class="wk-hot-tag">Most Popular</div>}
            <div class="wk-itin-label">{itin.label}</div>
            <div class="wk-itin-nights">{itin.nights}</div>
            <div class="wk-itin-rounds">{itin.rounds}</div>
            <p class="wk-itin-desc">{itin.desc}</p>
            <a href={QUOTE_URL} class="wk-itin-link underline-draw">Get this package →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ WHAT'S INCLUDED ═══ -->
  <section class="wk-section wk-dark">
    <div class="wk-container">
      <div class="wk-header reveal-up">
        <span class="sec-label" style="color:#e8a850">One quote, everything handled</span>
        <h2 class="wk-h2" style="color:#f5f0e8">What's in every<br/><em>weekend package</em></h2>
      </div>
      <div class="wk-included">
        {included.map((item, i) => (
          <div class={`wk-inc-card reveal-scale delay-${i+1}`}>
            <div class="wk-inc-icon">{item.icon}</div>
            <div class="wk-inc-title">{item.title}</div>
            <p class="wk-inc-body">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ COURSES ═══ -->
  <section class="wk-section">
    <div class="wk-container">
      <div class="wk-header reveal-up">
        <span class="sec-label">All 5 Graeagle courses available</span>
        <h2 class="wk-h2">Play any combination.<br/><em>We sequence them right.</em></h2>
      </div>
      <div class="wk-courses">
        {courses.map((c, i) => (
          <div class={`wk-course-card reveal-scale delay-${i+1}`}>
            <div class="wk-course-img-wrap">
              <img src={c.img} alt={c.alt} loading="lazy" class="wk-course-img"/>
              <div class="wk-course-fade"></div>
              <span class="wk-course-badge">{c.accolade}</span>
            </div>
            <div class="wk-course-body">
              <div class="wk-course-name">{c.name}</div>
              <p class="wk-course-line">{c.line}</p>
              <a href={`/portfolio/${c.slug}/`} class="wk-course-link underline-draw">Course details ↗</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ INLINE CTA ═══ -->
  <section class="wk-cta-inline">
    <div class="wk-container" style="text-align:center;max-width:600px">
      <p class="wk-cta-inline-line reveal-up">Know which courses you want? Let's build the weekend.</p>
      <a href={QUOTE_URL} class="btn-green-glow wk-btn reveal-scale delay-1">Plan My Golf Weekend →</a>
      <p class="wk-cta-inline-trust reveal-up delay-2">Free · No commitment · 24hr response</p>
    </div>
  </section>

  <!-- ═══ LODGING ═══ -->
  <section class="wk-section">
    <div class="wk-container">
      <div class="wk-header reveal-up">
        <span class="sec-label">Golf weekend lodging — Graeagle</span>
        <h2 class="wk-h2">Where the weekend<br/><em>stays</em></h2>
      </div>
      <div class="wk-lodging">
        {lodging.map((l, i) => (
          <div class={`wk-lodge-card glow-card reveal-${i===0?'left':'right'} delay-${i+1}`}>
            <div class="wk-lodge-img-wrap">
              <img src={l.img} alt={l.alt} loading="lazy" class="wk-lodge-img"/>
              <div class="wk-lodge-fade"></div>
              <span class="wk-lodge-tag">{l.tag}</span>
            </div>
            <div class="wk-lodge-body">
              <div class="wk-lodge-name">{l.name}</div>
              <p class="wk-lodge-desc">{l.desc}</p>
              <a href={`/portfolio/${l.slug}/`} class="wk-course-link underline-draw">View property ↗</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mobile-only CTA -->
  <section class="wk-cta-inline wk-mobile-only">
    <div class="wk-container" style="text-align:center;max-width:600px">
      <p class="wk-cta-inline-line reveal-up">Ready to lock in the weekend?</p>
      <a href={QUOTE_URL} class="btn-green-glow wk-btn reveal-scale delay-1">Plan My Golf Weekend →</a>
      <p class="wk-cta-inline-trust reveal-up delay-2">Free · No commitment · 24hr response</p>
    </div>
  </section>

  <!-- ═══ SOCIAL PROOF: REAL TRIPS ═══ -->
  {proofTrips.length > 0 && (
  <section class="wk-section">
    <div class="wk-container">
      <div class="wk-header reveal-up">
        <span class="wk-label">Real completed weekend trips</span>
        <h2 class="wk-h2">These trips happened.<br/><em>Yours can too.</em></h2>
        <p class="wk-subhead">Actual packages Mike built for groups that came, played, and came back the next year.</p>
      </div>
      <div class="wk-proof-grid">
        {proofTrips.map((t: any, i: number) => {
          const courseNames = (t.courses || []).map((c: string) => c.replace(/ Golf (Club|Course|Resort)$/i,'').replace(/ Club$| Course$/,''));
          return (
            <div class={`wk-proof-card reveal-up delay-${i+1}`}>
              <div class="wk-proof-top">
                <span class="wk-proof-pax">{t.groupSize} golfers</span>
                <span class="wk-proof-nights">{t.nights}N / {t.rounds}R</span>
                <span class="wk-proof-price">${t.pricePerPerson}/pp</span>
              </div>
              <div class="wk-proof-courses">
                {courseNames.slice(0,3).map((c: string, j: number) => (
                  <span class="wk-proof-course">{c}{j < Math.min(courseNames.length,3)-1 ? ' · ' : ''}</span>
                ))}
              </div>
              <p class="wk-proof-why">"{t.whyItWorked}"</p>
              <div class="wk-proof-mike">— <a href="/about/mike-eskuchen/" style="color:inherit;text-decoration:underline;text-underline-offset:3px;opacity:0.8;">Mike Eskuchen</a>, Golf Trip Specialist</div>
            </div>
          );
        })}
      </div>
      <div style="text-align:center;margin-top:40px">
        <a href={QUOTE_URL} class="btn-green-glow wk-btn reveal-scale">Plan a Weekend Like This →</a>
      </div>
    </div>
  </section>
  )}

  <!-- ═══ MIKE CTA ═══ -->
  <section class="wk-section wk-dark">
    <div class="wk-container wk-mike-wrap">
      <div class="wk-mike-text reveal-left">
        <span class="sec-label" style="color:#e8a850">Your Graeagle golf specialist</span>
        <h2 class="wk-h2" style="color:#f5f0e8;margin-top:10px">Tell Mike your dates<br/><em>and he builds it.</em></h2>
        <p class="wk-mike-body">20+ years building Graeagle golf weekends — from first-timers playing Graeagle Meadows to regulars who've done all 5 courses and want a new combination. Tell him your dates, group size, and budget. He sends a full itinerary back within 24 hours.</p>
        <a href={QUOTE_URL} class="btn-green-glow wk-btn" style="margin-top:28px;display:inline-block">Plan My Golf Weekend →</a>
        <p style="font-size:12px;color:rgba(245,240,232,.3);margin-top:12px;">Free · No commitment · 24hr response</p>
      </div>
      <div class="wk-mike-img reveal-right delay-2">
        <img src="https://nv-for-hd-v1757363743.websitepro-cdn.com/wp-content/uploads/2026/01/skoogen-head-shot-1.png" alt="Mike Eskuchen — Graeagle Golf Weekend Specialist" loading="lazy"/>
        <div class="wk-mike-badge">
          <div class="wk-mike-name">Mike Eskuchen</div>
          <div class="wk-mike-title">Golf Trip Specialist · 20+ years</div>
        </div>
      
      <!-- Dining cross-sell -->
      <div class="reveal" style="background:rgba(232,168,80,0.06);border:1px solid rgba(232,168,80,0.18);border-radius:14px;padding:24px 28px;margin-top:40px;">
        <p style="font-size:10px;color:#a06c30;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;margin:0 0 10px;">Group Dining — Coordinated by GolfGraeagle</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(180px,45vw),1fr));gap:10px;">
          {[
            {name:'Grizzly Grill', note:'Group dinner favourite — stone hearth, local game, exposed beams', slug:'grizzly-grill'},
            {name:'The Roadhouse', note:'On-site at River Pines — steaks, ribs, walk in after 18', slug:'roadhouse-at-river-pines'},
            {name:"Cuccia's", note:"#1 rated in Graeagle — handmade pizza, pasta, wine bar", slug:'cuccias'},
            {name:'Iron Door', note:'Historic steakhouse since 1961 — great for the big group dinner', slug:'iron-door'},
          ].map(d => (
            <a href={`/portfolio/${d.slug}/`} style="padding:12px 14px;background:#fff;border:1px solid rgba(28,18,8,0.07);border-radius:8px;text-decoration:none;display:block;" onmouseover="this.style.borderColor='rgba(232,168,80,0.35)'" onmouseout="this.style.borderColor='rgba(28,18,8,0.07)'">
              <div style="font-size:13px;font-weight:600;color:#1a2e1a;margin-bottom:4px;">{d.name}</div>
              <div style="font-size:11px;color:rgba(28,18,8,0.45);line-height:1.5;">{d.note}</div>
            </a>
          ))}
        </div>
        <p style="font-size:12px;color:rgba(28,18,8,0.4);margin:14px 0 0;">GolfGraeagle can coordinate group dining reservations alongside your tee times and lodging — <a href="/dining/" style="color:#a06c30;text-decoration:none;">browse all restaurants →</a></p>
      </div>
    </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="wk-section">
    <div class="wk-container" style="max-width:760px">
      <div class="wk-header reveal-up">
        <span class="sec-label">Graeagle golf weekends — common questions</span>
        <h2 class="wk-h2">Planning questions,<br/><em>answered</em></h2>
      </div>
      <div class="wk-faqs">
        {faqSchema.mainEntity.map((q: any, i: number) => (
          <details class={`wk-faq reveal-up delay-${i+1}`}>
            <summary class="wk-faq-q">
              {q.name}
              <span class="wk-faq-icon">+</span>
            </summary>
            <p class="wk-faq-a">{q.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FINAL CTA ═══ -->
  <section class="wk-cta-final wk-dark">
    <div class="wk-cta-glow"></div>
    <div class="wk-container" style="text-align:center;max-width:620px;position:relative;z-index:1">
      <h2 class="wk-cta-h2 reveal-up">Tell us your dates.<br/><em>We'll build the weekend.</em></h2>
      <p class="wk-cta-sub reveal-up delay-1">Group size, dates, which courses you want. Mike builds a full stay-and-play weekend package — tee times, lodging, itinerary — and sends it back within 24 hours. Free, no commitment.</p>
      <div class="reveal-scale delay-2">
        <a href={QUOTE_URL} class="btn-green-glow wk-btn">Plan My Golf Weekend →</a>
      <p style="margin-top:14px;text-align:center;"><a href="/golf-packages/" style="font-size:13px;color:rgba(28,18,8,0.35);text-decoration:none;">Browse all Graeagle golf packages →</a></p>
        <p style="font-size:12px;color:rgba(245,240,232,.28);margin-top:14px;">2–20+ golfers · All 5 courses · 24hr quote · 4.8★</p>
      </div>
    </div>
  </section>

  <div style="max-width:860px;margin:0 auto;padding:32px clamp(20px,6%,80px) 0;display:flex;flex-wrap:wrap;gap:12px 24px;">
    <a href="/summer-golf-graeagle/" style="font-size:14px;color:#1a7a40;text-decoration:underline;">Summer golf in Graeagle →</a>
    <a href="/blog/large-group-golf-graeagle/" style="font-size:14px;color:#1a7a40;text-decoration:underline;">Planning large-group golf in Graeagle →</a>
  </div>
  <RelatedTrips client:load slug="weekend" type="course" showAll={true} max={3} />
  <Footer />
</Base>

<style>
:root{--wk-gold:#e8a850;--wk-green:#1a7a40;--wk-dark:#0d1a0e;--wk-text:#1c1208;--wk-muted:rgba(28,18,8,0.52);--wk-border:rgba(28,18,8,0.08);--wk-r:20px}
.wk-container{max-width:1140px;margin:0 auto;padding:0 clamp(20px,6%,80px)}
.wk-section{padding:clamp(72px,9vw,120px) 0;background:var(--page-bg,#f8f5f0)}
.wk-dark{background:var(--wk-dark)!important}
.wk-header{text-align:center;margin-bottom:clamp(40px,5vw,68px)}
.wk-h2{font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,50px);font-weight:500;color:var(--wk-text);line-height:1.1;margin:8px 0 0}
.wk-h2 em{font-style:italic;color:var(--wk-green)}
/* HERO */
.wk-hero{position:relative;min-height:92vh;display:flex;align-items:flex-end;overflow:hidden}
.wk-bg{position:absolute;inset:0;background-size:cover;background-position:center 40%;transform:scale(1.07);animation:wkZoom 10s ease forwards}
@keyframes wkZoom{to{transform:scale(1)}}
.wk-overlay{position:absolute;inset:0;background:linear-gradient(160deg,rgba(13,26,14,.05) 0%,rgba(13,26,14,.45) 40%,rgba(13,26,14,.96) 100%)}
.wk-hero-inner{position:relative;z-index:2;padding:0 clamp(24px,8%,120px) clamp(60px,8vw,100px);max-width:820px}
.wk-eyebrow{font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:rgba(232,168,80,.82);margin:0 0 18px}
.wk-h1{font-family:'Playfair Display',serif;font-size:clamp(46px,7.5vw,92px);font-weight:500;color:#f5f0e8;line-height:.98;margin:0 0 18px}
.wk-h1 em{font-style:italic;color:var(--wk-gold)}
.wk-sub{font-size:clamp(16px,2vw,21px);color:rgba(245,240,232,.62);line-height:1.55;margin:0 0 26px}
.wk-pills{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px}
