---
export const prerender = true;
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';

const PAGE_URL = 'https://golfgraeagle.com/corporate/bay-area/';

const courses = [
  {
    slug: 'grizzly-ranch',
    name: 'Grizzly Ranch Golf Club',
    par: 72, yds: '7,411', slope: 140,
    accolade: 'Golf Digest Top 100 — closest to the Bay Area',
    portfolioSlug: 'grizzly-ranch-golf-packages',
    badge: 'TOP 100',
    photo: '/wp-images/grizzly-ranch-.webp',
    why: 'The anchor course for every Bay Area group. Not on GolfNow. Not on Tee Off. Only bookable through us.',
    detail: 'Bob Cupp design · 4,800 ft elevation · 7,411 yds from tips · 11 mi east of Graeagle',
    note: 'Most Bay Area groups play this Friday — first full day, peak energy.',
  },
  {
    slug: 'nakoma-dragon',
    name: 'Nakoma — The Dragon',
    par: 72, yds: '7,015', slope: 147,
    accolade: 'Frank Lloyd Wright clubhouse · Golf World Top 75',
    portfolioSlug: 'nakoma-dragon-golf-packages',
    badge: 'FLW CLUBHOUSE',
    photo: '/wp-images/nakoma-dragon-18-hole.jpg',
    why: 'The only Frank Lloyd Wright–designed golf clubhouse in existence. Saturday night dinner at Fifty44 is the highlight of the trip.',
    detail: 'Robin Nelson & Neil Haworth design · Slope 147 · Fifty44 Restaurant on-site · 42-room inn + spa',
    note: 'Pairs with lodging at the Inn at Nakoma — 5-min walk from clubhouse.',
  },
  {
    slug: 'whitehawk-ranch',
    name: 'Whitehawk Ranch',
    par: 71, yds: '6,983', slope: 132,
    accolade: 'Top 20 Golf Courses in California',
    portfolioSlug: 'whitehawk-ranch-golf-packages',
    badge: 'TOP 20 CA',
    photo: '/wp-images/whitehawk-popup-home.webp',
    why: 'Championship layout through old-growth Sierra pines. Perfect Sunday closer — dramatic and memorable, finished by noon.',
    detail: 'Dick Bailey design · 1996 · Sierra Nevada forest setting · Clio CA',
    note: 'Sunday tee times allow departure by 1pm — Bay Area by 5pm.',
  },
  {
    slug: 'plumas-pines',
    name: 'Plumas Pines Golf Resort',
    par: 72, yds: '6,504', slope: 132,
    accolade: 'Top 5 Best Value — Sierra Nevada',
    portfolioSlug: 'plumas-pines-golf-packages',
    badge: 'BEST VALUE',
    photo: '/wp-images/plumas-pines-hero.webp',
    why: 'Best value in the region. Ideal for mixed-handicap corporate groups — challenging enough for low-handicappers, welcoming for casual players.',
    detail: 'Homer Flint design · 1980 · Adjacent to Townhomes at Plumas Pines · Feather River views',
    note: 'Group-friendly layout — 4-hour round times typical.',
  },
  {
    slug: 'graeagle-meadows',
    name: 'Graeagle Meadows',
    par: 72, yds: '6,759', slope: 120,
    accolade: 'Est. 1968 · All Skill Levels · Village Course',
    portfolioSlug: 'graeagle-meadows-golf-packages',
    badge: 'ALL LEVELS',
    photo: '/wp-images/graeagle-meadows-hero.webp',
    why: 'The village course — walkable, relaxed, great for arrival-day warm-up rounds or mixed groups where some players are newer to the game.',
    detail: 'Ellis Van Gorder design · 1968 · Walking-friendly · Adjacent to Graeagle village shops & dining',
    note: 'Common choice for Thursday evening arrival round.',
  },
];

const cities = [
  { name: 'San Francisco', drive: '3.5h', via: 'I-80 E → Hwy 89 N', note: 'Leave FiDi at 6am, tee off at 10am' },
  { name: 'San Jose',      drive: '3.5h', via: 'I-680 N → I-80 E → Hwy 89 N', note: 'South Bay corridor — same drive time as SF' },
  { name: 'Oakland',       drive: '3.5h', via: 'I-80 E → Hwy 89 N', note: 'Bay Bridge → straight shot east' },
  { name: 'Palo Alto',     drive: '3.75h', via: 'US-101 N → I-80 E → Hwy 89 N', note: 'Stanford / Sand Hill Road companies' },
  { name: 'Sacramento',    drive: '2h',   via: 'I-80 E → Hwy 89 N', note: 'Closest major market — day-trip possible' },
];

const faqs = [
  {
    q: 'How far is Graeagle from San Francisco for a corporate golf retreat?',
    a: 'Graeagle is approximately 3.5 hours from San Francisco via I-80 East to Highway 89 North. No flights, no airports, no TSA. Your group drives up together Thursday evening or Friday morning, plays two rounds over the weekend, and returns Sunday. It is the closest Golf Digest Top 100 course to the Bay Area.',
  },
  {
    q: 'What makes Graeagle the best corporate golf destination for Bay Area companies?',
    a: 'Graeagle has five championship courses including Golf Digest Top 100 Grizzly Ranch and the Nakoma Dragon — whose clubhouse was designed by Frank Lloyd Wright. Green fees are 40–60% lower than comparable Tahoe courses, there is no city traffic, and the altitude (4,400 ft) gives every golfer an extra 10–15 yards of carry. One operator handles everything under one contract.',
  },
  {
    q: 'Can we book Grizzly Ranch for a private corporate group from the Bay Area?',
    a: 'Yes. Grizzly Ranch is not accessible through standard online booking channels. GolfGraeagle.com holds a direct operator relationship and can secure priority tee times for corporate groups. This is one of the main reasons Bay Area companies use us — Grizzly Ranch cannot be booked on GolfNow or Tee Off.',
  },
  {
    q: 'What is the typical itinerary for a Bay Area corporate golf trip to Graeagle?',
    a: 'Most Bay Area groups arrive Thursday evening and stay at The Inn at Nakoma or Townhomes at Plumas Pines. Friday: Grizzly Ranch (Golf Digest Top 100). Saturday: Nakoma — The Dragon, dinner at Fifty44 Restaurant. Sunday: Whitehawk Ranch, depart by 3pm, back in the Bay Area by 7pm. Custom itineraries available for 2-night or 4-night programs.',
  },
  {
    q: 'How does GolfGraeagle.com manage a corporate group from the Bay Area?',
    a: 'Through TripsCaddie, our proprietary group management portal. Each attendee receives a personal invitation, registers themselves, pays their share, and receives tee times and itinerary automatically. Your EA or event coordinator sets it up once. We have managed 19+ Graeagle group programs this way — no spreadsheets, no payment chasing, no group texts.',
  },
  {
    q: 'Is Graeagle better than Tahoe for a Bay Area corporate golf trip?',
    a: 'For most corporate groups, yes. Tahoe courses are 5–6 hours from the South Bay, green fees are 40–60% higher, and tee times at top courses are restricted or unavailable to groups. Graeagle is 3.5 hours from San Francisco, has a Golf Digest Top 100 course (Grizzly Ranch) and a Frank Lloyd Wright clubhouse (Nakoma), and GolfGraeagle.com handles everything under one contract.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://golfgraeagle.com/' },
    { '@type': 'ListItem', position: 2, name: 'Corporate Golf Graeagle', item: 'https://golfgraeagle.com/corporate/' },
    { '@type': 'ListItem', position: 3, name: 'Bay Area Corporate Golf', item: PAGE_URL },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': ['Service', 'Product'],
  name: 'Bay Area Corporate Golf Retreat — Graeagle, California',
  description: 'Corporate and executive golf retreats for Bay Area companies. Graeagle is 3.5 hours from San Francisco — Golf Digest Top 100 Grizzly Ranch, Nakoma (Frank Lloyd Wright), and 3 more courses. One contract, one deposit. Groups 8–400. Powered by TripsCaddie.',
  provider: { '@id': 'https://golfgraeagle.com/#organization' },
  serviceType: 'Corporate Golf Event Planning',
  areaServed: [
    { '@type': 'City', name: 'San Francisco', containedInPlace: { '@type': 'State', name: 'California' } },
    { '@type': 'City', name: 'San Jose',      containedInPlace: { '@type': 'State', name: 'California' } },
    { '@type': 'City', name: 'Oakland',       containedInPlace: { '@type': 'State', name: 'California' } },
    { '@type': 'City', name: 'Palo Alto',     containedInPlace: { '@type': 'State', name: 'California' } },
    { '@type': 'Place', name: 'San Francisco Bay Area, California' },
    { '@type': 'Place', name: 'Silicon Valley, California' },
  ],
  url: PAGE_URL,
  brand: { '@type': 'Brand', name: 'GolfGraeagle.com' },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: 4.8, bestRating: 5, worstRating: 1, ratingCount: 672,
  },
  offers: {
    '@type': 'Offer',
    name: 'Bay Area Corporate Golf Retreat — Custom Quote',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: 'https://golfgraeagle.com/request-a-quote/',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Bay Area Corporate Golf Retreat — Graeagle, CA (3.5h from SF)',
  description: 'Corporate golf retreats for Bay Area companies, 3.5 hours from San Francisco. Golf Digest Top 100 Grizzly Ranch + Frank Lloyd Wright Nakoma. Groups 8–400. GolfGraeagle.com.',
  url: PAGE_URL,
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.speakable-intro', 'h1'] },
  breadcrumb: breadcrumbSchema,
};

const allSchemas = [webPageSchema, serviceSchema, faqSchema, breadcrumbSchema];
---

<Base
  title="Bay Area Corporate Golf Retreat — Graeagle, CA 3.5h from SF | GolfGraeagle.com"
  description="Corporate golf retreats for Bay Area companies. Graeagle is 3.5 hours from San Francisco — Golf Digest Top 100 Grizzly Ranch, Nakoma (Frank Lloyd Wright clubhouse), and 3 more courses. Groups 8–400. One contract. Free proposal."
  canonical={PAGE_URL}
  ogImage="/wp-images/grizzly-ranch-hero.webp"
  ogType="website"
  schema={allSchemas}
>
  <Nav />

  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-h1">
    <div class="hero__inner">
      <p class="eyebrow-light">Bay Area Corporate Golf · 3.5 Hours from San Francisco</p>
      <h1 id="hero-h1" class="hero__h1 speakable-intro">
        Corporate Golf Retreat<br>3.5 Hours from<br>San Francisco
      </h1>
      <p class="hero__sub speakable-intro">
        Golf Digest Top 100. Frank Lloyd Wright clubhouse. No flights.
        No airports. Your Bay Area group drives east on I-80 and plays
        the best course within a day's reach — under one contract.
      </p>
      <div class="hero__btns">
        <a href="/request-a-quote/?from=corporate-bay-area&placement=hero" class="btn-gold">Request Group Proposal</a>
        <a href="#drive-times" class="btn-ghost">Drive Times from Your City</a>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="trust-bar">
    <div class="trust-bar__inner">
      <div class="ti"><strong>3.5h from SF</strong><span>I-80 E → Hwy 89 N</span></div>
      <div class="ti"><strong>Golf Digest Top 100</strong><span>Grizzly Ranch</span></div>
      <div class="ti"><strong>★ 4.8 / 5</strong><span>672 reviews</span></div>
      <div class="ti"><strong>Groups 8–400</strong></div>
      <div class="ti"><strong>No flights needed</strong></div>
      <div class="ti"><strong>(888) 586-1157</strong></div>
    </div>
  </div>

  <!-- DRIVE TIMES -->
  <section class="drive-section" id="drive-times" aria-labelledby="drive-h2">
    <div class="drive-section__inner">
      <p class="eyebrow">Drive Times</p>
      <h2 id="drive-h2" class="section-title">No Flights. No Airports.<br>Just Drive East.</h2>
      <p class="section-body">
        Graeagle sits in Plumas County at 4,400 ft elevation — a straight shot
        east on I-80, then north on Highway 89. Most Bay Area groups leave Thursday
        evening or early Friday and tee off by 10am.
      </p>
      <div class="drive-grid">
        {cities.map(c => (
          <div class="drive-card">
            <div class="drive-card__city">{c.name}</div>
            <div class="drive-card__time">{c.drive}</div>
            <div class="drive-card__via">{c.via}</div>
            <div class="drive-card__note">{c.note}</div>
          </div>
        ))}
      </div>
      <p class="drive-note">
        All drive times are approximate via Google Maps in normal traffic conditions.
        Thursday evening departures avoid Friday morning Bay Area congestion entirely.
      </p>
    </div>
  </section>

  <!-- VS ALTERNATIVES -->
  <section class="vs-section" aria-labelledby="vs-h2">
    <div class="vs-section__inner">
      <p class="eyebrow">Why Graeagle vs. Alternatives</p>
      <h2 id="vs-h2" class="section-title">The Bay Area Golf Retreat<br>Comparison Your CFO Wants</h2>
      <div class="vs-table-wrap">
        <table class="vs-table">
          <thead>
            <tr>
              <th>Destination</th>
              <th>Drive from SF</th>
              <th>Top Course</th>
              <th>Green Fee (top course)</th>
              <th>One Operator?</th>
            </tr>
          </thead>
          <tbody>
            <tr class="vs-row--winner">
              <td><strong>Graeagle</strong></td>
              <td>3.5h</td>
              <td>Grizzly Ranch (Golf Digest Top 100)</td>
              <td>$120–$180</td>
              <td><span class="check">✓ GolfGraeagle.com</span></td>
            </tr>
            <tr>
              <td>Monterey / Pebble Beach</td>
              <td>2h</td>
              <td>Pebble Beach Golf Links®</td>
              <td>$595–$625</td>
              <td>Fragmented</td>
            </tr>
            <tr>
              <td>North Lake Tahoe / Truckee</td>
              <td>3.5h</td>
              <td>Old Greenwood (Tom Fazio)</td>
              <td>$200–$275</td>
              <td>Fragmented</td>
            </tr>
            <tr>
              <td>South Lake Tahoe</td>
              <td>4–5h from South Bay</td>
              <td>Edgewood Tahoe</td>
              <td>$265–$350</td>
              <td>Fragmented</td>
            </tr>
            <tr>
              <td>Napa / Sonoma</td>
              <td>1.5h</td>
              <td>No championship course</td>
              <td>—</td>
              <td>—</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="vs-note">Green fees are approximate public/group rates for illustrative comparison. Graeagle rates vary by course and season.</p>
    </div>
  </section>

  <!-- COURSES -->
  <section class="courses-section" id="courses" aria-labelledby="courses-h2">
    <div class="courses-section__inner">
      <p class="eyebrow">5 Championship Courses</p>
      <h2 id="courses-h2" class="section-title">The Closest Golf Digest Top 100<br>to San Francisco</h2>
      <p class="section-body">
        Grizzly Ranch is not on GolfNow or Tee Off — GolfGraeagle.com holds a direct
        operator relationship. That priority group access is the main reason Bay Area
        planners use us over booking individually.
      </p>
    </div>
    <div class="course-carousel-wrap">
      <div class="course-carousel" id="courseCarousel">
        {courses.map((c, i) => (
          <article class="cc" aria-label={c.name}>
            <a href={`/portfolio/${c.portfolioSlug}/`} class="cc__photo-link" tabindex="-1" aria-hidden="true">
              <div class="cc__photo" style={`background-image:url('${c.photo}')`}>
                <span class="cc__badge">{c.badge}</span>
              </div>
            </a>
            <div class="cc__body">
              <div class="cc__meta">
                <span class="cc__num">0{i+1}</span>
                <div class="cc__stats">
                  <span>Par {c.par}</span><span>{c.yds} yds</span><span>Slope {c.slope}</span>
                </div>
              </div>
              <h3 class="cc__name"><a href={`/portfolio/${c.portfolioSlug}/`}>{c.name}</a></h3>
              <p class="cc__accolade">{c.accolade}</p>
              <p class="cc__why">{c.why}</p>
              <p class="cc__detail">{c.detail}</p>
              <p class="cc__note"><span class="cc__note-icon">→</span> {c.note}</p>
              <a href={`/portfolio/${c.portfolioSlug}/`} class="cc__cta">Course Details</a>
            </div>
          </article>
        ))}
      </div>
      <div class="cc__nav" aria-label="Course navigation">
        <button class="cc__prev" id="ccPrev" aria-label="Previous course">‹</button>
        <div class="cc__dots" id="ccDots">
          {courses.map((_, i) => (
            <button class={`cc__dot${i===0?' cc__dot--active':''}`} data-idx={i} aria-label={`Course ${i+1}`}></button>
          ))}
        </div>
        <button class="cc__next" id="ccNext" aria-label="Next course">›</button>
      </div>
    </div>
    <div class="courses-section__cta">
      <a href="/request-a-quote/?from=corporate-bay-area&placement=courses" class="btn-gold">Get All 5 Courses in One Quote</a>
    </div>
  </section>

  <script>
  (function(){
    const carousel = document.getElementById('courseCarousel');
    const dots = document.querySelectorAll('.cc__dot');
    const prev = document.getElementById('ccPrev');
    const next = document.getElementById('ccNext');
    if(!carousel) return;
    let cur = 0;
    const total = dots.length;
    function go(n){
      cur = (n + total) % total;
      const card = carousel.querySelectorAll('.cc')[cur];
      if(card) card.scrollIntoView({behavior:'smooth', block:'nearest', inline:'center'});
      dots.forEach((d,i)=>d.classList.toggle('cc__dot--active', i===cur));
    }
    prev && prev.addEventListener('click',()=>go(cur-1));
    next && next.addEventListener('click',()=>go(cur+1));
    dots.forEach((d,i)=>d.addEventListener('click',()=>go(i)));
    const obs = new IntersectionObserver(entries=>{
      entries.forEach(e=>{
        if(e.isIntersecting){
          const idx = Array.from(carousel.querySelectorAll('.cc')).indexOf(e.target);
          if(idx>=0){cur=idx;dots.forEach((d,i)=>d.classList.toggle('cc__dot--active',i===cur));}
        }
      });
    },{root:carousel,threshold:0.6});
    carousel.querySelectorAll('.cc').forEach(c=>obs.observe(c));
  })();
  </script>

  <!-- SAMPLE ITINERARY -->
  <section class="itin-section" aria-labelledby="itin-h2">
    <div class="itin-section__inner">
      <p class="eyebrow">Sample Program</p>
      <h2 id="itin-h2" class="section-title">3-Night Bay Area Executive Golf Itinerary</h2>
      <p class="section-body">Most Bay Area companies do Thursday–Sunday. No flights booked, no Monday absences.</p>
      <div class="itin-grid">
        <div class="itin-day">
          <div class="itin-day__label">Thu</div>
          <div class="itin-day__content">
            <strong>Depart after work</strong>
            <span>3.5h drive from SF. Arrive Graeagle by 9pm. Check into Inn at Nakoma. Dinner at Fifty44.</span>
          </div>
        </div>
        <div class="itin-day">
          <div class="itin-day__label">Fri</div>
          <div class="itin-day__content">
            <strong>Grizzly Ranch</strong>
            <span>Golf Digest Top 100. 10am shotgun. Lunch at the clubhouse. Afternoon free. Dinner in Graeagle village.</span>
          </div>
        </div>
        <div class="itin-day">
          <div class="itin-day__label">Sat</div>
          <div class="itin-day__content">
            <strong>Nakoma — The Dragon</strong>
            <span>8am tee time on the Frank Lloyd Wright course. Spa afternoon. Group dinner at Fifty44.</span>
          </div>
        </div>
        <div class="itin-day">
          <div class="itin-day__label">Sun</div>
          <div class="itin-day__content">
            <strong>Whitehawk Ranch + depart</strong>
            <span>Top 20 California course. 7am shotgun. Finish by noon. Back in the Bay Area by 4pm.</span>
          </div>
        </div>
      </div>
      <div class="itin-cta">
        <a href="/request-a-quote/?from=corporate-bay-area&placement=itinerary" class="btn-gold">Get a Custom Itinerary</a>
      </div>
    </div>
  </section>

  <!-- TRIPSCADDIE -->
  <section class="caddie-section" aria-labelledby="caddie-h2">
    <div class="caddie-section__inner">
      <p class="eyebrow eyebrow--light">Group Management</p>
      <h2 id="caddie-h2" class="section-title section-title--light">No Spreadsheets. No Venmo Requests.<br>No Group Texts.</h2>
      <p class="section-body section-body--light">
        Bay Area companies run on systems. TripsCaddie is ours. Each attendee
        self-registers, pays their share, and receives their tee time automatically.
        Your EA sets it up once. We have managed 19+ Graeagle group programs
        this way — no other operator in the region has this.
      </p>
      <div class="caddie-proof">
        <div class="cp-item"><span class="cp-n">19+</span><span class="cp-l">Managed Graeagle Group Programs</span></div>
        <div class="cp-item"><span class="cp-n">4.8★</span><span class="cp-l">Group Experience Rating</span></div>
        <div class="cp-item"><span class="cp-n">1</span><span class="cp-l">Contract · 1 Deposit · All Courses + Lodging</span></div>
        <div class="cp-item"><span class="cp-n">24h</span><span class="cp-l">Quote turnaround</span></div>
      </div>
      <div style="margin-top:28px">
        <a href="/request-a-quote/?from=corporate-bay-area&placement=caddie" class="btn-gold">Request Bay Area Group Proposal</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section" aria-labelledby="faq-h2">
    <div class="faq-section__inner">
      <h2 id="faq-h2" class="section-title">Bay Area Corporate Golf FAQs</h2>
      <dl class="faq-list">
        {faqs.map((f, i) => (
          <div class="faq-item" id={`faq-${i}`}>
            <dt class="faq-q">{f.q}</dt>
            <dd class="faq-a">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta" aria-labelledby="cta-h2">
    <div class="final-cta__inner">
      <h2 id="cta-h2" class="final-cta__title">Plan Your Bay Area Group's Next Retreat</h2>
      <p class="final-cta__sub">Tell us your dates, group size, and home city. We'll build a custom itinerary with confirmed tee times within 24 hours.</p>
      <a href="/request-a-quote/?from=corporate-bay-area&placement=footer-cta" class="btn-gold btn-gold--lg">Request a Free Proposal</a>
      <p class="final-cta__phone">Or call <a href="tel:+18885861157">(888) 586-1157</a> — we answer.</p>
    </div>
  </section>

  <Footer />
</Base>

<style>
.hero {
  min-height: 520px;
  display: flex;
  align-items: center;
  background: linear-gradient(155deg, #0a1a0a 0%, #1a2e1a 38%, #2a4a1a 62%, #152514 80%, #060c06 100%);
  position: relative; overflow: hidden;
}
.hero::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(to right, rgba(0,0,0,.45) 0%, rgba(0,0,0,.1) 55%, transparent 100%);
}
.hero__inner {
  position: relative; z-index: 1;
  padding: 80px 40px;
  max-width: 640px;
  margin-left: max(40px, calc(50vw - 560px));
}
@media (max-width: 700px) { .hero__inner { padding: 60px 20px; margin-left: 0; max-width: 100%; } }
.eyebrow-light { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: rgba(184,130,10,.8); margin-bottom: 14px; }
.hero__h1 {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(36px, 5vw, 56px);
  font-weight: 700; color: #fff; line-height: 1.08;
  text-shadow: 0 2px 24px rgba(0,0,0,.5); margin-bottom: 18px;
}
