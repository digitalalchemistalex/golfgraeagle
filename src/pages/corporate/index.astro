---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { siteConfig } from '../../data/content.js';

const PAGE_URL = 'https://golfgraeagle.com/corporate/';

const courses = [
  { slug: 'grizzly-ranch',    name: 'Grizzly Ranch Golf Club',    par: 72, yds: '7,411', slope: 140, accolade: 'Golf Digest Top 100', badge: 'FLAGSHIP', portfolioSlug: 'grizzly-ranch-golf-packages' },
  { slug: 'nakoma-dragon',    name: 'Nakoma — The Dragon',        par: 72, yds: '7,015', slope: 147, accolade: 'Frank Lloyd Wright Clubhouse · Golf World Top 75', badge: 'MOST UNIQUE', portfolioSlug: 'nakoma-dragon-golf-packages' },
  { slug: 'whitehawk-ranch',  name: 'Whitehawk Ranch',            par: 71, yds: '6,983', slope: 132, accolade: 'Top 20 California', badge: 'EXECUTIVE FAVORITE', portfolioSlug: 'whitehawk-ranch-golf-packages' },
  { slug: 'plumas-pines',     name: 'Plumas Pines Golf Resort',   par: 72, yds: '6,504', slope: 132, accolade: 'Top 5 Best Value Sierra Nevada', badge: 'GREAT VALUE', portfolioSlug: 'plumas-pines-golf-packages' },
  { slug: 'graeagle-meadows', name: 'Graeagle Meadows',           par: 72, yds: '6,759', slope: 120, accolade: 'Est. 1968 · All Skill Levels', badge: 'ALL LEVELS', portfolioSlug: 'graeagle-meadows-golf-packages' },
];

const faqs = [
  {
    q: 'Who manages corporate golf groups in Graeagle, California?',
    a: 'GolfGraeagle.com is the dedicated group golf operator for the Graeagle region, managing executive and corporate golf retreats at all 5 championship courses since 2004. We handle tee times, lodging, transportation, and group logistics under one contract. Call (888) 586-1157 for a custom group proposal.',
  },
  {
    q: 'How far is Graeagle from the San Francisco Bay Area?',
    a: 'Graeagle is approximately 3.5 hours from San Francisco and 2 hours from Sacramento — no flights, no airport transfers. Your group drives up together, plays Golf Digest Top 100 Grizzly Ranch the next morning, and returns rested. It is the closest Golf Digest Top 100 course to the Bay Area.',
  },
  {
    q: 'What is the minimum group size for a corporate golf outing in Graeagle?',
    a: 'We manage corporate groups from 8 to 400 players. Smaller executive groups (8–20) typically stay at The Inn at Nakoma for a private lodge experience, while larger groups (50+) use Townhomes at Plumas Pines or a combination of lodging properties. All arrangements are under one contract.',
  },
  {
    q: 'Can our corporate group access Grizzly Ranch — it appears semi-private?',
    a: "Yes. Grizzly Ranch is not accessible through standard online booking channels. GolfGraeagle.com holds a direct operator relationship with Grizzly Ranch management and can book corporate groups with priority access. This is one of the primary reasons Fortune 500 planners work with us rather than booking independently.",
  },
  {
    q: 'What does TripsCaddie do for our corporate golf group?',
    a: 'TripsCaddie is our proprietary attendee management portal. Each player receives a personal invitation link, registers themselves, pays their share directly, and receives their tee time and itinerary automatically. No spreadsheets, no manual payment collection, no group text threads. Your EA sets it up once. We have managed 19+ Graeagle group programs through TripsCaddie with a 4.8-star group experience rating.',
  },
  {
    q: 'What lodging is available for a corporate group in Graeagle?',
    a: 'The most popular executive option is The Inn at Nakoma — 42 rooms directly on The Dragon course, with the Frank Lloyd Wright-designed clubhouse, Fifty44 Restaurant, spa, and heated pool. For larger groups or multiple price tiers, we combine the Inn at Nakoma with Townhomes at Plumas Pines (2–4BR units, full kitchens, on the course). River Pines Resort and Chalet View Lodge are available for budget-conscious or mixed groups.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://golfgraeagle.com/' },
    { '@type': 'ListItem', position: 2, name: 'Corporate Golf Graeagle', item: PAGE_URL },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': ['Service', 'Product'],
  name: 'Graeagle Corporate Golf Retreat Planning',
  description: 'Full-service corporate and executive golf retreat operator for the Graeagle, California region. Groups of 8 to 400. Tee times at all 5 championship courses including Golf Digest Top 100 Grizzly Ranch and Nakoma (Frank Lloyd Wright clubhouse). One contract, one deposit. Powered by TripsCaddie group management.',
  provider: { '@id': 'https://golfgraeagle.com/#organization' },
  serviceType: 'Corporate Golf Event Planning',
  areaServed: [
    { '@type': 'City', 'name': 'San Francisco', containedInPlace: { '@type': 'State', name: 'California' } },
    { '@type': 'City', 'name': 'Sacramento', containedInPlace: { '@type': 'State', name: 'California' } },
    { '@type': 'City', 'name': 'San Jose', containedInPlace: { '@type': 'State', name: 'California' } },
    { '@type': 'Place', 'name': 'Bay Area, California' },
    { '@type': 'Place', 'name': 'Graeagle, California' },
  ],
  url: PAGE_URL,
  brand: { '@type': 'Brand', name: 'GolfGraeagle.com' },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: 4.8,
    bestRating: 5,
    worstRating: 1,
    ratingCount: 672,
  },
  offers: {
    '@type': 'Offer',
    name: 'Corporate Golf Retreat — Custom Quote',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: 'https://golfgraeagle.com/request-a-quote/',
  },
  potentialAction: {
    '@type': 'ReserveAction',
    target: { '@type': 'EntryPoint', urlTemplate: 'https://golfgraeagle.com/request-a-quote/' },
    name: 'Request Corporate Golf Proposal',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const courseSchemas = courses.map(c => ({
  '@context': 'https://schema.org',
  '@type': 'GolfCourse',
  name: c.name,
  description: `${c.name} is a ${c.par}-par, ${c.yds}-yard championship golf course in the Graeagle, California region of the Sierra Nevada. ${c.accolade}.`,
  url: `https://golfgraeagle.com/portfolio/${c.portfolioSlug}/`,
  address: { '@type': 'PostalAddress', addressLocality: 'Graeagle', addressRegion: 'CA', addressCountry: 'US' },
  isAccessibleForFree: false,
}));

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Corporate Golf Retreats in Graeagle, California — Groups 8–400',
  description: 'Executive and corporate golf retreat operator for Graeagle, CA. Golf Digest Top 100 Grizzly Ranch, Nakoma (Frank Lloyd Wright), and 3 more courses. Groups 8–400. One contract. Powered by TripsCaddie.',
  url: PAGE_URL,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.speakable-intro', 'h1'],
  },
  breadcrumb: breadcrumbSchema,
};

const allSchemas = [webPageSchema, serviceSchema, faqSchema, breadcrumbSchema, ...courseSchemas];
---

<Base
  title="Corporate Golf Retreats Graeagle, CA — Groups 8–400 | GolfGraeagle.com"
  description="Executive and corporate golf retreat operator for Graeagle, California. Golf Digest Top 100 Grizzly Ranch, Nakoma (Frank Lloyd Wright clubhouse), and 3 more courses. Groups 8–400, one contract. 3.5 hours from the Bay Area. Free proposal."
  canonical={PAGE_URL}
  ogImage="/wp-images/grizzly-ranch-hero.webp"
  ogType="website"
  schema={allSchemas}
>
  <Nav />

  <!-- HERO -->
  <section class="corp-hero" aria-labelledby="corp-h1">
    <div class="corp-hero__inner">
      <p class="corp-hero__eyebrow">Corporate &amp; Executive Golf · Graeagle, California</p>
      <h1 id="corp-h1" class="corp-hero__h1 speakable-intro">
        Executive Golf Retreats<br>Graeagle, California
      </h1>
      <p class="corp-hero__sub speakable-intro">
        Golf Digest Top 100. Frank Lloyd Wright clubhouse. Five championship courses
        3.5 hours from San Francisco — under one contract, one deposit. Groups of 8 to 400.
        Powered by TripsCaddie.
      </p>
      <div class="corp-hero__btns">
        <a href="/request-a-quote/?from=corporate&placement=hero" class="btn-gold">
          Request Group Proposal
        </a>
        <a href="#courses" class="btn-ghost">View All 5 Courses</a>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="trust-bar" aria-label="Trust signals">
    <div class="trust-bar__inner">
      <div class="ti"><strong>★ 4.8</strong><span>672 verified reviews</span></div>
      <div class="ti"><strong>Operating since 2004</strong><span>20+ years</span></div>
      <div class="ti"><strong>5 Courses</strong><span>One contract</span></div>
      <div class="ti"><strong>Groups 8–400</strong></div>
      <div class="ti"><strong>3.5h from SF</strong><span>No flights needed</span></div>
      <div class="ti"><strong>(888) 586-1157</strong></div>
    </div>
  </div>

  <!-- WHY GRAEAGLE FOR CORPORATE -->
  <section class="why-section">
    <div class="why-section__inner">
      <p class="eyebrow">Why Graeagle</p>
      <h2 class="section-title">The Corporate Golf Retreat<br>The Bay Area Keeps Missing</h2>
      <p class="section-body">
        No other destination within a day's drive of San Francisco combines a Golf Digest Top 100
        course, a Frank Lloyd Wright clubhouse, and a private lodge experience — under one
        operator who handles everything. Your EA does not chase payment from 30 golfers.
        Your CFO does not approve 6 separate vendor invoices. One contract. One deposit.
      </p>
      <div class="why-grid">
        <div class="why-card">
          <div class="why-card__icon">✗</div>
          <div>
            <strong>Monterey / Pebble Beach</strong>
            <span>Elite — but $800+/round green fees and 6-hour drives from most of the Bay Area</span>
          </div>
        </div>
        <div class="why-card">
          <div class="why-card__icon">✗</div>
          <div>
            <strong>Napa / Sonoma</strong>
            <span>No championship golf within the region — courses are filler, not the reason</span>
          </div>
        </div>
        <div class="why-card">
          <div class="why-card__icon">✗</div>
          <div>
            <strong>Tahoe / Truckee</strong>
            <span>Premium pricing, scattered courses, 5h+ from South Bay</span>
          </div>
        </div>
        <div class="why-card why-card--yes">
          <div class="why-card__icon">✓</div>
          <div>
            <strong>Graeagle</strong>
            <span>Golf Digest Top 100 · Frank Lloyd Wright clubhouse · 3.5h from SF · One operator for everything</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COURSES -->
  <section class="courses-section" id="courses" aria-labelledby="courses-h2">
    <div class="courses-section__inner">
      <p class="eyebrow">5 Championship Courses</p>
      <h2 id="courses-h2" class="section-title">The Only Golf Digest Top 100 Course<br>3.5 Hours from San Francisco</h2>
      <p class="section-body">
        We hold direct operator relationships with all 5 Graeagle courses — including
        Grizzly Ranch, which is not accessible through standard public booking channels.
        Priority access for your corporate group is one of the core reasons planners use us.
      </p>
      <div class="course-grid">
        {courses.map(c => (
          <a href={`/portfolio/${c.portfolioSlug}/`} class="course-card" aria-label={`${c.name} — ${c.accolade}`}>
            <div class={`course-card__photo course-card__photo--${c.slug}`}>
              <span class="course-card__badge">{c.badge}</span>
              <h3 class="course-card__name">{c.name}</h3>
            </div>
            <div class="course-card__body">
              <div class="course-card__stats">
                <span>Par {c.par}</span>
                <span>{c.yds} yds</span>
                <span>Slope {c.slope}</span>
              </div>
              <p class="course-card__accolade">{c.accolade}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- TRIPSCADDIE -->
  <section class="caddie-section" aria-labelledby="caddie-h2">
    <div class="caddie-section__inner">
      <p class="eyebrow eyebrow--light">Group Management</p>
      <h2 id="caddie-h2" class="section-title section-title--light">Powered by TripsCaddie</h2>
      <p class="section-body section-body--light">
        Fortune 500 procurement teams approve vendors who demonstrate operational proof.
        TripsCaddie is ours. Each attendee self-registers and pays their share. Individual
        T&amp;E folios. Live group dashboard. Tee sheet auto-built. Itinerary distributed
        automatically. We have managed 19+ Graeagle group programs through TripsCaddie — no
        other operator in the region has this.
      </p>
      <div class="caddie-portal">
        <div class="caddie-portal__header">
          <span class="caddie-portal__logo">TripsCaddie</span>
          <span class="caddie-portal__sub">Executive Group Portal · Golf Graeagle</span>
          <span class="caddie-portal__badge">19+ managed trips · 4.8★</span>
        </div>
        <div class="caddie-portal__stats">
          <div class="cst"><span class="cst__n">19+</span><span class="cst__l">Managed Graeagle Trips</span></div>
          <div class="cst"><span class="cst__n">5</span><span class="cst__l">Courses Available</span></div>
          <div class="cst"><span class="cst__n">4.8★</span><span class="cst__l">672 Group Reviews</span></div>
          <div class="cst"><span class="cst__n">1</span><span class="cst__l">Contract · 1 Deposit</span></div>
        </div>
        <div class="caddie-portal__proof">
          <div class="proof-item">
            <strong>Individual folios</strong>
            <span>Each attendee pays their own share directly — no coordinator collecting cash or Venmo</span>
          </div>
          <div class="proof-item">
            <strong>Tee sheet auto-built</strong>
            <span>Group registration data feeds directly into tee times — no manual re-entry</span>
          </div>
          <div class="proof-item">
            <strong>Live dashboard</strong>
            <span>Group coordinator sees real-time registration status, payment confirmation, and itinerary delivery</span>
          </div>
          <div class="proof-item">
            <strong>Fortune 500 references</strong>
            <span>Track record of managed groups available on request — including group size, courses played, and coordinator contact</span>
          </div>
        </div>
        <div class="caddie-portal__cta">
          <a href="/request-a-quote/?from=corporate&placement=caddie" class="btn-gold">
            Request Corporate Proposal
          </a>
          <span class="caddie-portal__note">Custom quote · Groups 8–400 · Response within 24 hours</span>
        </div>
      </div>
    </div>
  </section>

  <!-- LODGING -->
  <section class="lodging-section" aria-labelledby="lodging-h2">
    <div class="lodging-section__inner">
      <p class="eyebrow">Executive Lodging</p>
      <h2 id="lodging-h2" class="section-title">Stay on the Course.<br>Wake Up Ready to Play.</h2>
      <p class="section-body">
        The Inn at Nakoma puts your entire leadership team in a Frank Lloyd Wright-designed lodge,
        steps from The Dragon tee box. For mixed-size groups, we combine lodging properties
        to match every budget tier — all confirmed under one contract.
      </p>
      <div class="lodge-grid">
        <div class="lodge-card lodge-card--featured">
          <a href="/portfolio/the-inn-at-nakoma-clio-ca/" class="lodge-card__img lodge-card__img--nakoma" aria-label="The Inn at Nakoma">
            <span class="lodge-card__tag">EXECUTIVE PICK</span>
          </a>
          <div class="lodge-card__body">
            <h3 class="lodge-card__name"><a href="/portfolio/the-inn-at-nakoma-clio-ca/">The Inn at Nakoma</a></h3>
            <p class="lodge-card__desc">42 rooms directly on The Dragon course. Frank Lloyd Wright clubhouse. Fifty44 Restaurant + spa + heated pool. The definitive Graeagle executive lodge.</p>
            <ul class="lodge-card__features">
              <li>On-site: The Dragon (Slope 147)</li>
              <li>Fifty44 Restaurant · Middle Fork Bistro</li>
              <li>Spa · Heated pool · Dog-friendly</li>
              <li>Groups block entire property</li>
            </ul>
          </div>
        </div>
        <div class="lodge-card">
          <a href="/portfolio/the-townhomes-at-plumas-pines/" class="lodge-card__img lodge-card__img--townhomes" aria-label="Townhomes at Plumas Pines">
            <span class="lodge-card__tag">LARGE GROUPS</span>
          </a>
          <div class="lodge-card__body">
            <h3 class="lodge-card__name"><a href="/portfolio/the-townhomes-at-plumas-pines/">Townhomes at Plumas Pines</a></h3>
            <p class="lodge-card__desc">2–4 bedroom units adjacent to Plumas Pines Golf Resort. Full kitchens, pools, tennis. Ideal for groups who want a shared-house dynamic.</p>
          </div>
        </div>
        <div class="lodge-card">
          <a href="/portfolio/river-pines-resort-graeagle-ca/" class="lodge-card__img lodge-card__img--river-pines" aria-label="River Pines Resort">
            <span class="lodge-card__tag">FULL RESORT</span>
          </a>
          <div class="lodge-card__body">
            <h3 class="lodge-card__name"><a href="/portfolio/river-pines-resort-graeagle-ca/">River Pines Resort</a></h3>
            <p class="lodge-card__desc">Family-owned 40+ years. Cabins, suites, and rooms. On-site Roadhouse restaurant. Pool and hot tub. Walkable to Graeagle Meadows.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section" aria-labelledby="faq-h2">
    <div class="faq-section__inner">
      <h2 id="faq-h2" class="section-title">Corporate Golf FAQs — Graeagle</h2>
      <dl class="faq-list">
        {faqs.map((f, i) => (
          <div class="faq-item" id={`faq-${i}`}>
            <dt class="faq-q">{f.q}</dt>
            <dd class="faq-a">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta" aria-labelledby="cta-h2">
    <div class="final-cta__inner">
      <h2 id="cta-h2" class="final-cta__title">Ready to Plan Your Corporate Retreat?</h2>
      <p class="final-cta__sub">Tell us your dates, group size, and preferred courses. We'll have a custom proposal back within 24 hours — tee times confirmed, lodging matched, full itinerary included.</p>
      <a href="/request-a-quote/?from=corporate&placement=footer-cta" class="btn-gold btn-gold--lg">
        Request a Free Proposal
      </a>
      <p class="final-cta__phone">Or call <a href="tel:+18885861157">(888) 586-1157</a> — we answer.</p>
    </div>
  </section>

  <Footer />
</Base>

<style>
/* ── HERO ── */
.corp-hero {
  min-height: 520px;
  display: flex;
  align-items: center;
  background: linear-gradient(155deg, #0a1a0a 0%, #1a2e1a 38%, #2a4a1a 62%, #152514 80%, #060c06 100%);
  position: relative;
  overflow: hidden;
}
.corp-hero::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to right, rgba(0,0,0,.45) 0%, rgba(0,0,0,.1) 55%, transparent 100%);
}
.corp-hero__inner {
  position: relative;
  z-index: 1;
  max-width: 1200px;
  margin: 0 auto;
  padding: 80px 40px;
  max-width: 640px;
  margin-left: max(40px, calc(50vw - 560px));
}
@media (max-width: 700px) {
  .corp-hero__inner { padding: 60px 20px; margin-left: 0; max-width: 100%; }
}
.corp-hero__eyebrow {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: rgba(184,130,10,.8);
  margin-bottom: 14px;
}
.corp-hero__h1 {
  font-family: 'Cormorant Garamond', 'Georgia', serif;
  font-size: clamp(36px, 5vw, 58px);
  font-weight: 700;
  color: #fff;
  line-height: 1.08;
  text-shadow: 0 2px 24px rgba(0,0,0,.5);
  margin-bottom: 18px;
}
.corp-hero__sub {
  font-size: 15px;
  color: rgba(255,255,255,.85);
  line-height: 1.65;
  margin-bottom: 28px;
  text-shadow: 0 1px 8px rgba(0,0,0,.3);
  max-width: 540px;
}
.corp-hero__btns {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

/* ── BUTTONS ── */
.btn-gold {
  display: inline-block;
  padding: 13px 30px;
  background: #b8820a;
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  border-radius: 3px;
  text-decoration: none;
  letter-spacing: .03em;
  transition: background .15s;
}
.btn-gold:hover { background: #9a6c08; }
.btn-gold--lg { padding: 15px 40px; font-size: 15px; }
.btn-ghost {
  display: inline-block;
  padding: 12px 24px;
  background: rgba(255,255,255,.1);
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  border-radius: 3px;
  text-decoration: none;
  border: 1px solid rgba(255,255,255,.3);
  backdrop-filter: blur(4px);
  transition: background .15s;
}
.btn-ghost:hover { background: rgba(255,255,255,.18); }

/* ── TRUST BAR ── */
.trust-bar {
  background: #f5f0e8;
  border-bottom: 1px solid #d8ccb0;
  overflow-x: auto;
  scrollbar-width: none;
}
.trust-bar::-webkit-scrollbar { display: none; }
.trust-bar__inner {
  display: flex;
  align-items: stretch;
  min-width: max-content;
}
.ti {
  padding: 12px 22px;
  display: flex;
  align-items: center;
  gap: 7px;
  border-right: 1px solid #d8ccb0;
  white-space: nowrap;
  font-size: 13px;
}
.ti:last-child { border-right: none; }
.ti strong { color: #1a2e1a; font-weight: 700; }
.ti span { color: #8a6a20; font-size: 11px; }

/* ── SHARED SECTION LAYOUT ── */
.why-section__inner,
.courses-section__inner,
.caddie-section__inner,
.lodging-section__inner,
.faq-section__inner,
.final-cta__inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 64px 40px;
}
@media (max-width: 700px) {
  .why-section__inner,
  .courses-section__inner,
  .caddie-section__inner,
  .lodging-section__inner,
  .faq-section__inner,
  .final-cta__inner { padding: 48px 20px; }
}

.eyebrow {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #8a6a20;
  margin-bottom: 10px;
}
.eyebrow--light { color: rgba(184,130,10,.75); }

.section-title {
  font-family: 'Cormorant Garamond', 'Georgia', serif;
  font-size: clamp(26px, 3.5vw, 38px);
  font-weight: 600;
  color: #0f180f;
  line-height: 1.15;
  margin-bottom: 14px;
}
.section-title--light { color: rgba(245,240,232,.95); }

.section-body {
  font-size: 15px;
  color: #404830;
  line-height: 1.72;
  max-width: 640px;
  margin-bottom: 40px;
}
.section-body--light { color: rgba(245,240,232,.75); }

/* ── WHY GRID ── */
.why-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}
@media (max-width: 640px) { .why-grid { grid-template-columns: 1fr; } }
.why-card {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 16px 18px;
  background: #fff;
