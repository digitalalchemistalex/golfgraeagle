            const info = resolveCourse(c);
            return (
              <a href={`/portfolio/${info.slug}/`} style={`display:flex;justify-content:space-between;align-items:center;text-decoration:none;padding:8px 0;${i < courses.length-1?'border-bottom:1px solid rgba(28,18,8,0.06);':''}`} onmouseover="this.style.opacity='.7'" onmouseout="this.style.opacity='1'">
