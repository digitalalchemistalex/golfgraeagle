                  <div style="position:absolute;top:10px;left:12px;"><span style="font-size:9px;font-weight:700;text-transform:uppercase;background:rgba(232,168,80,0.92);color:#1c1208;padding:3px 8px;border-radius:100px;">{t.vibe}</span></div>
                </div>
                <div style="padding:16px 18px 20px;flex:1;">
                  <div style="font-size:15px;font-weight:700;color:#1a2e1a;margin-bottom:6px;line-height:1.3;">{t.groupName}</div>
                  <div style="font-size:12px;color:rgba(28,18,8,0.45);margin-bottom:12px;line-height:1.5;">{t.groupSize} golfers · {t.nights}N/{t.rounds}R · {tShorts}</div>
                  <div style="font-size:20px;font-weight:800;color:#1a2e1a;">${t.pricePerPerson.toLocaleString()}<span style="font-size:12px;font-weight:400;color:rgba(28,18,8,0.4);"> /pp</span></div>
                </div>
              </a>
            );
          })}
        </div>
        <div style="margin-top:28px;">
          <a href="/trips/" style="font-size:13px;color:#a06c30;font-weight:700;text-decoration:none;">Browse all Graeagle packages →</a>
        </div>
      </div>
    </section>
  )}

  <!-- ══ DINING CROSS-SELL ════════════════════════════════════════════════ -->
  <section style="background:#fff;padding:clamp(48px,6vw,72px) clamp(20px,8%,120px);">
