        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(300px,100%),1fr));gap:20px;">
          {similarTrips.map((t: any) => {
            const tc = t.courses || [];
            const heroI = resolveCourse(tc[0] || '').img;
            const tShorts = tc.map(cleanCourseName).slice(0,3).join(', ');
            return (
              <a href={`/trips/${t.slug}/`} style="display:flex;flex-direction:column;background:#fff;border-radius:14px;overflow:hidden;text-decoration:none;border:1px solid rgba(28,18,8,0.07);box-shadow:0 2px 12px rgba(0,0,0,0.04);transition:box-shadow .25s,transform .25s;" onmouseover="this.style.boxShadow='0 8px 32px rgba(0,0,0,0.1)';this.style.transform='translateY(-3px)'" onmouseout="this.style.boxShadow='0 2px 12px rgba(0,0,0,0.04)';this.style.transform='translateY(0)'">
