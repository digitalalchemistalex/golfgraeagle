          <a href="/request-a-quote/" style="font-size:12px;color:#e8a850;font-weight:700;text-decoration:none;">Get a custom quote →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ SIMILAR TRIPS ══════════════════════════════════════════════════════ -->
  {similarTrips.length > 0 && (
    <section style="background:#f5f2ec;padding:clamp(48px,7vw,80px) clamp(20px,8%,120px);">
      <div style="max-width:1100px;margin:0 auto;">
