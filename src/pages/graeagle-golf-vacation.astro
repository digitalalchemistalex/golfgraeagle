---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import RelatedTrips from '../components/RelatedTrips.tsx';
import { fetchTripStats } from '../lib/tripStats';
const { minPrice, trips: allTrips } = await fetchTripStats();

const proofTrips = allTrips
  .filter((t: any) => t.nights >= 3 && t.pricePerPerson && t.whyItWorked)
  .sort((a: any, b: any) => a.pricePerPerson - b.pricePerPerson)
  .slice(0, 3);

const title = "Graeagle Golf Vacation Packages | Stay & Play the Sierra Nevada";
const description = "Plan a Graeagle golf vacation — 5 championship courses, mountain lodging, and custom tee times in Plumas County, California. From $299/golfer. Free 24-hour quote.";
const ogImage = "/wp-images/grizzly-ranch-hero.webp";

const faqSchema = {
  "@context":"https://schema.org","@type":"FAQPage",
  "mainEntity":[
    {"@type":"Question","name":"Where is Graeagle, California?","acceptedAnswer":{"@type":"Answer","text":"Graeagle is a small mountain community in Plumas County, California, located in the Sierra Nevada mountains. It sits approximately 2.5 hours northeast of Sacramento, 3.5–4 hours from San Francisco, and 1 hour west of Reno, Nevada. The closest major ski resort is Plumas Ski in Johnsville, about 15 minutes away."}},
    {"@type":"Question","name":"How many golf courses are in Graeagle?","acceptedAnswer":{"@type":"Answer","text":"There are five championship golf courses in the Graeagle area: Graeagle Meadows (par 72, Ellis Van Gorder), Whitehawk Ranch (par 71, Top 20 California), Plumas Pines (par 72, Homer Flint), Grizzly Ranch (par 72, Golf Digest Top 100), and Nakoma — The Dragon (par 72, Frank Lloyd Wright clubhouse, Golf World Top 75). All five courses are within 5–25 minutes of each other."}},
    {"@type":"Question","name":"When is the best time to take a Graeagle golf vacation?","acceptedAnswer":{"@type":"Answer","text":"The best months for a Graeagle golf vacation are June through October. June offers fresh course conditions and long days. September and early October bring fall colors, cooler temperatures, and less crowded tee sheets. Courses typically open in April and close by late November, depending on snowfall. Summer weekends (July–August) book 6–8 weeks in advance."}},
    {"@type":"Question","name":"What is the best golf course for a Graeagle vacation?","acceptedAnswer":{"@type":"Answer","text":"The answer depends on skill level. Grizzly Ranch (Golf Digest Top 100, slope 140, 7,411 yards) is the signature destination round. Nakoma Dragon (slope 147, the only Frank Lloyd Wright-designed golf clubhouse) is the most unique experience. For mixed-ability groups, Graeagle Meadows (slope 120) and Plumas Pines (par 72, top value Sierra Nevada) are the most accessible. GolfGraeagle sequences courses across your stay based on difficulty and group ability."}},
    {"@type":"Question","name":"What does a Graeagle golf vacation cost per person?","acceptedAnswer":{"@type":"Answer","text":"Stay-and-play Graeagle golf vacation packages start at $299 per golfer. Full multi-night packages with lodging typically range from $620 to $1,705 per person depending on group size, number of nights, courses played, and lodging choice. Larger groups generally get better per-person rates. GolfGraeagle provides a free custom quote within 24 hours."}},
    {"@type":"Question","name":"Is Graeagle close to Lake Tahoe?","acceptedAnswer":{"@type":"Answer","text":"Graeagle is approximately 1.5 hours from North Lake Tahoe and about 1 hour from Truckee. It is not part of the Tahoe basin but offers similar Sierra Nevada mountain scenery with five championship golf courses that Tahoe cannot match at comparable price points."}},
  ]
};

const breadcrumbSchema = {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
  {"@type":"ListItem","position":1,"name":"Home","item":"https://golfgraeagle.com/"},
  {"@type":"ListItem","position":2,"name":"Graeagle Golf Vacation","item":"https://golfgraeagle.com/graeagle-golf-vacation/"}
]};

const serviceSchema = {
  "@context":"https://schema.org","@type":"Service",
  "name":"Graeagle Golf Vacation Packages",
  "description":"Custom stay-and-play golf vacation packages in Graeagle, California — tee times at 5 championship courses, mountain lodging, and day-by-day itineraries. From $299/golfer.",
  "provider":{"@type":"TravelAgency","@id":"https://golfgraeagle.com/#organization"},
  "areaServed":{"@type":"Place","name":"Graeagle, California"},
  "serviceType":"Golf Vacation Package"
};

const courses = [
  { name:'Grizzly Ranch', slug:'grizzly-ranch-golf-packages', accolade:'Golf Digest Top 100', img:'/wp-images/grizzly-ranch-hero.webp', alt:'Grizzly Ranch Golf Club — Golf Digest Top 100 Graeagle golf vacation', par:72, yards:'7,411', slope:140, line:'The destination round. Golf Digest Top 100. 7,411 yards from the tips at 4,800–5,400 ft elevation.' },
  { name:'Nakoma Dragon', slug:'nakoma-dragon-golf-packages', accolade:'Golf World Top 75', img:'/wp-images/nakoma-dragon-feather-river.webp', alt:'Nakoma Dragon Golf Course — Frank Lloyd Wright clubhouse Graeagle', par:72, yards:'7,015', slope:147, line:'Golf World Top 75. The only Frank Lloyd Wright-designed golf clubhouse in the world.' },
  { name:'Whitehawk Ranch', slug:'whitehawk-ranch-golf-packages', accolade:'Top 20 California', img:'/wp-images/whitehawk-hero.webp', alt:'Whitehawk Ranch Golf Course — Top 20 California Graeagle golf vacation', par:71, yards:'6,983', slope:132, line:'Top 20 golf courses in California. 12 meadow holes, 6 forested hillsides, Sulphur Creek in play.' },
  { name:'Graeagle Meadows', slug:'graeagle-meadows-golf-packages', accolade:'Sierra Nevada Classic', img:'/wp-images/graeagle-meadows-aerial.jpg', alt:'Graeagle Meadows Golf Course — Graeagle golf vacation mountain views', par:72, yards:'6,759', slope:120, line:'The original Graeagle course. Open since 1968. Mountain views, accessible to all skill levels.' },
  { name:'Plumas Pines', slug:'plumas-pines-golf-packages', accolade:'Top 5 Best Value Sierra Nevada', img:'/wp-images/plumas-pines-hero.webp', alt:'Plumas Pines Golf Resort — Graeagle golf vacation stay and play', par:72, yards:'6,504', slope:132, line:'Top 5 best-value courses in the Sierra Nevada. On-course lodging at adjacent Townhomes.' },
];

const lodging = [
  { name:'Inn at Nakoma', slug:'the-inn-at-nakoma-clio-ca', img:'/wp-images/nakoma-flw-lodge-exterior.webp', alt:'Inn at Nakoma — Frank Lloyd Wright golf vacation lodging Graeagle', tag:'Most Unique Stay', desc:'42 rooms inside the Frank Lloyd Wright-designed clubhouse. Frette linens, spa, heated pool, 2 hot tubs. The Dragon course starts outside your door.' },
  { name:'Townhomes at Plumas Pines', slug:'the-townhomes-at-plumas-pines', img:'/wp-images/plumas-pines-hero.webp', alt:'Townhomes at Plumas Pines — Graeagle golf vacation group lodging', tag:'Best for Groups', desc:'2–4 bedroom vacation rentals adjacent to Plumas Pines Golf Course. Full kitchens, private pools, tennis. Best for groups of 4–16 wanting full-house independence.' },
  { name:'River Pines Resort', slug:'river-pines-resort-graeagle-ca', img:'/wp-images/river-pines.webp', alt:'River Pines Resort — Graeagle golf vacation lodging cabins', tag:'Family-Owned 40+ Years', desc:'Cabins, suites, and rooms at a family-owned resort. Pool, hot tub, Roadhouse Restaurant on-site. Walking distance from Graeagle Meadows Golf Course.' },
  { name:'Chalet View Lodge', slug:'chalet-view-lodge-graeagle-ca', img:'/wp-images/chalet-view-lodge.webp', alt:'Chalet View Lodge — Graeagle golf vacation spa lodging', tag:'Spa & Brewery On-Site', desc:'10 forested acres with spa, 9-hole executive course, seasonal pool, and Eureka Peak Brewing Company on-site. Private mountain setting.' },
];

const included = [
  { icon:'⛳', title:'Tee times at all 5 courses', body:'We deal directly with every pro shop. Guaranteed access — no calling around, no rejections.' },
  { icon:'🏔', title:'Mountain lodging matched to your group', body:'Cabins, resort rooms, townhomes, or the Frank Lloyd Wright inn — matched to your group size and budget.' },
  { icon:'📋', title:'Day-by-day vacation itinerary', body:'Courses sequenced by difficulty, drive times mapped, dining recommendations built in.' },
  { icon:'⚡', title:'Free custom quote in 24 hours', body:'Tell us your dates, group size, and which courses you want. Mike sends a full proposal back fast.' },
];

const QUOTE_URL = '/request-a-quote/?groupType=vacation&ref=vacation-landing';
---

<Base
  title={title}
  description={description}
  ogImage={ogImage}
  schema={[faqSchema, breadcrumbSchema, serviceSchema]}
>
  <Nav />

  <!-- ═══ HERO ═══ -->
  <section class="gv-hero">
    <div class="gv-bg" style="background-image:url('/wp-images/grizzly-ranch-hero.webp')"></div>
    <div class="gv-overlay"></div>
    <div class="gv-hero-inner">
      <p class="gv-eyebrow">Graeagle, California · Sierra Nevada Mountains</p>
      <h1 class="gv-h1">The Sierra Nevada<br/><em>golf vacation</em><br/>you keep putting off.</h1>
      <p class="gv-sub">5 championship courses within 25 minutes of each other. Mountain lodging, clean air, and tee times no one else can guarantee. Graeagle is Northern California's best-kept golf secret — and GolfGraeagle builds the whole trip for you.</p>
      <div class="gv-pills">
        <span><strong>5</strong> championship courses</span>
        <span>From <strong>$299</strong>/golfer</span>
        <span><strong>Golf Digest</strong> Top 100 access</span>
        <span><strong>Frank Lloyd Wright</strong> clubhouse</span>
      </div>
      <div class="gv-ctas">
        <a href={QUOTE_URL} class="btn-green-glow gv-btn">Plan My Graeagle Vacation →</a>
        <a href="/all-golf-courses/" class="gv-ghost">See all 5 courses ↓</a>
      </div>
      <p class="gv-trust">Free · No commitment · 24hr response · 4.8★ from 672 verified trips</p>
    </div>
    <div class="gv-floats">
      <div class="gv-float"><div class="gv-float-val">5</div><div class="gv-float-lbl">Championship Courses</div></div>
      <div class="gv-float"><div class="gv-float-val">$299+</div><div class="gv-float-lbl">Per Golfer</div></div>
      <div class="gv-float"><div class="gv-float-val">4.8★</div><div class="gv-float-lbl">Verified Reviews</div></div>
    </div>
  </section>

  <!-- ═══ WHY GRAEAGLE ═══ -->
  <section class="gv-section">
    <div class="gv-container">
      <div class="gv-header reveal-up">
        <span class="sec-label">Why Graeagle for your golf vacation</span>
        <h2 class="gv-h2">Five courses. One valley.<br/><em>No driving between destinations.</em></h2>
        <p class="gv-subhead">Graeagle sits in a mountain valley in Plumas County, CA. All five courses are within 5–25 minutes. No commuting across a metro area, no interstate golf. Wake up, play, eat, sleep, repeat.</p>
      </div>
      <div class="gv-why-grid">
        {[
          { icon:'🏔', h:'Elevation golf at 3,500–5,400 ft', p:'Ball flies 5–8% farther in the mountain air. Every course plays differently than sea level — add 10–15 yards to every club and re-learn distances.' },
          { icon:'🌲', h:'Zero crowds compared to Pebble or Tahoe', p:'Graeagle is not on the tourist radar the way Monterey or Incline Village are. Tee sheets have room. Courses are in good condition. Rates reflect value, not hype.' },
          { icon:'🏆', h:'Golf Digest Top 100 and Golf World Top 75', p:'Grizzly Ranch (Golf Digest Top 100 Greatest Public Courses in the US) and Nakoma Dragon (Golf World Top 75 at debut) belong to a short list of destinations this far off the beaten path with nationally-ranked courses.' },
          { icon:'🏡', h:'Stay on or next to the courses', p:'The Inn at Nakoma is inside the Frank Lloyd Wright clubhouse. The Townhomes at Plumas Pines are adjacent to the first tee. River Pines Resort is walking distance from Graeagle Meadows. Sleep where you play.' },
        ].map((w, i) => (
          <div class={`gv-why-card reveal-up delay-${i+1}`}>
            <div class="gv-why-icon">{w.icon}</div>
            <h3 class="gv-why-h">{w.h}</h3>
            <p class="gv-why-p">{w.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ COURSES ═══ -->
  <section class="gv-section gv-alt">
    <div class="gv-container">
      <div class="gv-header reveal-up">
        <span class="sec-label">5 courses — all bookable through GolfGraeagle</span>
        <h2 class="gv-h2">The Graeagle golf vacation<br/><em>lineup</em></h2>
      </div>
      <div class="gv-courses">
        {courses.map((c, i) => (
          <div class={`gv-course-card glow-card reveal-up delay-${i+1}`}>
            <div class="gv-course-img-wrap">
              <img src={c.img} alt={c.alt} loading="lazy" class="gv-course-img"/>
              <div class="gv-course-fade"></div>
              <span class="gv-course-badge">{c.accolade}</span>
            </div>
            <div class="gv-course-body">
              <div class="gv-course-name">{c.name}</div>
              <div class="gv-course-specs">Par {c.par} · {c.yards} yds · Slope {c.slope}</div>
              <p class="gv-course-line">{c.line}</p>
              <a href={`/portfolio/${c.slug}/`} class="gv-course-link underline-draw">View packages ↗</a>
            </div>
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:48px">
        <a href={QUOTE_URL} class="btn-green-glow gv-btn reveal-scale">Build My Golf Vacation →</a>
      </div>
    </div>
  </section>


  <!-- ═══ COURSE COMPARISON TABLE ═══ -->
  <section class="gv-section gv-ALT">
    <div class="gv-container">
      <div class="gv-header reveal-up">
        <span class="sec-label">Compare all 5 Graeagle golf courses</span>
        <h2 class="gv-h2">Pick your courses.<br/><em>We book the rest.</em></h2>
      </div>
      <div class="gv-table-wrap reveal-up delay-1">
        <table class="gv-table">
          <thead>
            <tr>
              <th>Course</th>
              <th>Par / Yards</th>
              <th>Slope</th>
              <th>Difficulty</th>
              <th>Best for</th>
              <th>Price tier</th>
            </tr>
          </thead>
          <tbody>
            <tr><td><strong><a href="/portfolio/grizzly-ranch-golf-packages/" style="color:#1a7a40;text-decoration:none;">Grizzly Ranch</a></strong><br/><span style="font-size:11px;color:rgba(28,18,8,0.45);">Golf Digest Top 100</span></td><td>72 / 7,411</td><td>140</td><td>Very Hard</td><td>Low handicap</td><td>$$$$</td></tr>
            <tr><td><strong><a href="/portfolio/nakoma-dragon-golf-packages/" style="color:#1a7a40;text-decoration:none;">Nakoma Dragon</a></strong><br/><span style="font-size:11px;color:rgba(28,18,8,0.45);">Golf World Top 75 · FLW clubhouse</span></td><td>72 / 7,015</td><td>147</td><td>Hardest</td><td>Low handicap</td><td>$$$$</td></tr>
            <tr><td><strong><a href="/portfolio/whitehawk-ranch-golf-packages/" style="color:#1a7a40;text-decoration:none;">Whitehawk Ranch</a></strong><br/><span style="font-size:11px;color:rgba(28,18,8,0.45);">Top 20 California</span></td><td>71 / 6,983</td><td>132</td><td>Challenging</td><td>Mid–low handicap</td><td>$$$</td></tr>
            <tr><td><strong><a href="/portfolio/plumas-pines-golf-packages/" style="color:#1a7a40;text-decoration:none;">Plumas Pines</a></strong><br/><span style="font-size:11px;color:rgba(28,18,8,0.45);">Top 5 Best Value Sierra Nevada</span></td><td>72 / 6,504</td><td>132</td><td>Moderate</td><td>All levels</td><td>$$</td></tr>
            <tr><td><strong><a href="/portfolio/graeagle-meadows-golf-packages/" style="color:#1a7a40;text-decoration:none;">Graeagle Meadows</a></strong><br/><span style="font-size:11px;color:rgba(28,18,8,0.45);">Sierra Nevada Classic since 1968</span></td><td>72 / 6,759</td><td>120</td><td>Moderate</td><td>All levels, seniors</td><td>$$</td></tr>
          </tbody>
        </table>
      </div>
      <div style="text-align:center;margin-top:36px;">
        <a href="/all-golf-courses/" style="font-size:14px;color:#1a7a40;text-decoration:underline;">Full course guide with photos and details →</a>
      </div>
    </div>
  </section>

  <!-- ═══ INLINE CTA ═══ -->
  <section class="gv-cta-inline">
    <div class="gv-container" style="text-align:center;max-width:600px">
      <p class="gv-cta-inline-line reveal-up">Already know which courses you want?</p>
      <a href={QUOTE_URL} class="btn-green-glow gv-btn reveal-scale delay-1">Get a Free Vacation Quote →</a>
      <p class="gv-cta-inline-trust reveal-up delay-2">Free · No commitment · 24hr response</p>
    </div>
  </section>

  <!-- ═══ LODGING ═══ -->
  <section class="gv-section">
    <div class="gv-container">
      <div class="gv-header reveal-up">
        <span class="sec-label">Golf vacation lodging — Graeagle, CA</span>
        <h2 class="gv-h2">Stay on the course.<br/><em>Wake up ready.</em></h2>
        <p class="gv-subhead">Every lodging option in Graeagle is within 15 minutes of all five courses. GolfGraeagle matches your group size and budget to the right property.</p>
      </div>
      <div class="gv-lodging">
        {lodging.map((l, i) => (
          <div class={`gv-lodge-card glow-card reveal-up delay-${i+1}`}>
            <div class="gv-lodge-img-wrap">
              <img src={l.img} alt={l.alt} loading="lazy" class="gv-lodge-img"/>
              <div class="gv-lodge-fade"></div>
              <span class="gv-lodge-tag">{l.tag}</span>
            </div>
            <div class="gv-lodge-body">
              <div class="gv-lodge-name">{l.name}</div>
              <p class="gv-lodge-desc">{l.desc}</p>
              <a href={`/portfolio/${l.slug}/`} class="gv-course-link underline-draw">View property ↗</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ WHAT'S INCLUDED ═══ -->
  <section class="gv-section gv-dark">
    <div class="gv-container">
      <div class="gv-header reveal-up">
        <span class="sec-label" style="color:#e8a850">What GolfGraeagle handles</span>
        <h2 class="gv-h2" style="color:#f5f0e8">One call. Complete<br/><em>vacation package.</em></h2>
      </div>
      <div class="gv-included">
        {included.map((item, i) => (
          <div class={`gv-inc-card reveal-up delay-${i+1}`}>
            <div class="gv-inc-icon">{item.icon}</div>
            <div class="gv-inc-title">{item.title}</div>
            <p class="gv-inc-body">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ SOCIAL PROOF ═══ -->
  {proofTrips.length > 0 && (
  <section class="gv-section">
    <div class="gv-container">
      <div class="gv-header reveal-up">
        <span class="sec-label">Real completed Graeagle golf vacations</span>
        <h2 class="gv-h2">These trips happened.<br/><em>Yours can too.</em></h2>
      </div>
      <div class="gv-proof-grid">
        {proofTrips.map((t: any, i: number) => {
          const courseNames = (t.courses || []).map((c: string) => c.replace(/ Golf (Club|Course|Resort)$/i,'').replace(/ Club$| Course$/,''));
          return (
            <div class={`gv-proof-card reveal-up delay-${i+1}`}>
              <div class="gv-proof-top">
                <span class="gv-proof-pax">{t.groupSize} golfers</span>
                <span class="gv-proof-nights">{t.nights}N / {t.rounds}R</span>
                <span class="gv-proof-price">${t.pricePerPerson}/pp</span>
              </div>
              <div class="gv-proof-courses">
                {courseNames.slice(0,3).map((c: string, j: number) => (
                  <span>{c}{j < Math.min(courseNames.length,3)-1 ? ' · ' : ''}</span>
                ))}
              </div>
              <p class="gv-proof-why">"{t.whyItWorked}"</p>
              <div class="gv-proof-mike">— <a href="/about/mike-eskuchen/" style="color:inherit;text-decoration:underline;text-underline-offset:3px;opacity:0.8;">Mike Eskuchen</a>, Golf Trip Specialist</div>
            </div>
          );
        })}
      </div>
      <div style="text-align:center;margin-top:40px">
        <a href={QUOTE_URL} class="btn-green-glow gv-btn reveal-scale">Plan a Vacation Like This →</a>
      </div>
    </div>
  </section>
  )}

  <!-- ═══ MIKE ═══ -->
  <section class="gv-section gv-dark">
    <div class="gv-container gv-mike-wrap">
      <div class="gv-mike-text reveal-left">
        <span class="sec-label" style="color:#e8a850">Your Graeagle golf vacation specialist</span>
        <h2 class="gv-h2" style="color:#f5f0e8;margin-top:10px">Tell Mike your dates<br/><em>and he builds it.</em></h2>
        <p class="gv-mike-body">20+ years planning golf vacations in Graeagle and the High Sierra — from first-timers who've never heard of Grizzly Ranch to regulars who've played all five courses and want a new combination. Tell Mike your dates, group size, and budget. He sends a full vacation itinerary — tee times, lodging, dining — within 24 hours.</p>
        <a href={QUOTE_URL} class="btn-green-glow gv-btn" style="margin-top:28px;display:inline-block">Plan My Golf Vacation →</a>
        <p style="font-size:12px;color:rgba(245,240,232,.3);margin-top:12px;">Free · No commitment · 24hr response</p>
      </div>
      <div class="gv-mike-img reveal-right delay-2">
        <img src="https://nv-for-hd-v1757363743.websitepro-cdn.com/wp-content/uploads/2026/01/skoogen-head-shot-1.png" alt="Mike Eskuchen — Graeagle Golf Vacation Specialist" loading="lazy"/>
        <div class="gv-mike-badge">
          <div class="gv-mike-name">Mike Eskuchen</div>
          <div class="gv-mike-title">Golf Trip Specialist · 20+ years</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="gv-section">
    <div class="gv-container" style="max-width:760px">
      <div class="gv-header reveal-up">
        <span class="sec-label">Graeagle golf vacation — planning questions</span>
        <h2 class="gv-h2">Common questions,<br/><em>answered</em></h2>
      </div>
      <div class="gv-faqs">
        {faqSchema.mainEntity.map((q: any, i: number) => (
          <details class={`gv-faq reveal-up delay-${i+1}`}>
            <summary class="gv-faq-q">
              {q.name}
              <span class="gv-faq-icon">+</span>
            </summary>
            <p class="gv-faq-a">{q.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FINAL CTA ═══ -->
  <section class="gv-cta-final gv-dark">
    <div class="gv-cta-glow"></div>
    <div class="gv-container" style="text-align:center;max-width:620px;position:relative;z-index:1">
      <h2 class="gv-cta-h2 reveal-up">Tell us your dates.<br/><em>We build the vacation.</em></h2>
      <p class="gv-cta-sub reveal-up delay-1">Group size, dates, which courses you want. Mike builds a complete Graeagle golf vacation — tee times at all 5 courses, mountain lodging, full itinerary — and sends it back within 24 hours. Free, no commitment.</p>
      <div class="reveal-scale delay-2">
        <a href={QUOTE_URL} class="btn-green-glow gv-btn">Plan My Graeagle Golf Vacation →</a>
        <p style="font-size:12px;color:rgba(245,240,232,.28);margin-top:14px;">2–200+ golfers · All 5 courses · 24hr quote · 4.8★</p>
      </div>
    </div>
  </section>


  <!-- ═══ DINING XSELL ═══ -->
  <section class="gv-section" style="padding-top:0;padding-bottom:clamp(48px,6vw,72px);">
    <div class="gv-container" style="max-width:860px;">
      <div style="background:rgba(232,168,80,0.06);border:1px solid rgba(232,168,80,0.18);border-radius:14px;padding:24px 28px;">
