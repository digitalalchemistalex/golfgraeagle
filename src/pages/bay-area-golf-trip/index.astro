</style>

<script>
const wrap = document.getElementById('courseCarousel');
if (wrap) {
  const track = wrap.querySelector('.course-carousel');
  const dots = wrap.querySelectorAll('.cc__dot');
  const total = dots.length;
  let cur = 0;

  function go(i) {
    cur = (i + total) % total;
    track.scrollTo({ left: cur * track.offsetWidth, behavior: 'smooth' });
    dots.forEach((d, idx) => d.classList.toggle('active', idx === cur));
  }

  document.getElementById('ccPrev')?.addEventListener('click', () => go(cur - 1));
  document.getElementById('ccNext')?.addEventListener('click', () => go(cur + 1));
  dots.forEach((d, i) => d.addEventListener('click', () => go(i)));

  let sx = 0;
  track.addEventListener('pointerdown', e => { sx = e.clientX; });
  track.addEventListener('pointerup', e => {
    const dx = e.clientX - sx;
    if (Math.abs(dx) > 40) go(cur + (dx < 0 ? 1 : -1));
  });

  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const i = +e.target.dataset.index;
        if (!isNaN(i)) { cur = i; dots.forEach((d, idx) => d.classList.toggle('active', idx === i)); }
      }
    });
  }, { root: track, threshold: 0.6 });
  wrap.querySelectorAll('.cc').forEach(el => obs.observe(el));
}
</script>
