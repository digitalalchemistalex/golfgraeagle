---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { siteConfig, lodging, courses, dining } from '../data/content.js';

const title = "Graeagle Vacation Rentals & Cabins | Golf Group Lodging";
const description = "Graeagle vacation rentals for golf groups — Townhomes at Plumas Pines (2–4BR, full kitchens, on-course) and River Pines cabins (Feather River, pool, hot tub). Stay-and-play packages with tee times from $299/golfer.";
const canonical = `${siteConfig.url}/graeagle-vacation-rentals/`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Graeagle Vacation Rentals and Cabins for Golf Groups",
    "description": "Vacation rental properties for golf groups in Graeagle, California",
    "numberOfItems": 3,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Townhomes at Plumas Pines", "url": `${siteConfig.url}/portfolio/the-townhomes-at-plumas-pines/` },
      { "@type": "ListItem", "position": 2, "name": "River Pines Resort", "url": `${siteConfig.url}/portfolio/river-pines-resort-graeagle-ca/` },
      { "@type": "ListItem", "position": 3, "name": "Chalet View Lodge", "url": `${siteConfig.url}/portfolio/chalet-view-lodge-graeagle-ca/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Are there vacation rentals in Graeagle CA?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The Townhomes at Plumas Pines are the premier vacation rental for golf groups — 2–4 bedroom units with full kitchens, private decks, and fairway views, steps from Plumas Pines Golf Resort. River Pines Resort has cabins and cottages along the Feather River, and Chalet View Lodge offers private cabin suites on 10 forested acres." } },
      { "@type": "Question", "name": "What are the best vacation rentals near Graeagle golf courses?", "acceptedAnswer": { "@type": "Answer", "text": "The Townhomes at Plumas Pines are the best on-course rental — steps from the 1st tee at Plumas Pines Golf Resort, with drive times of 10–22 minutes to all other Graeagle courses. River Pines Resort cabins are walking distance to Graeagle Meadows Golf Course." } },
      { "@type": "Question", "name": "Are there vacation rentals with full kitchens near Graeagle?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The Townhomes at Plumas Pines have full kitchens, making them the only self-catering golf lodging in Graeagle. 2–4 bedroom units sleep 4–8 per townhome. Groups of 8–20 can rent adjacent units and coordinate as a single block." } },
      { "@type": "Question", "name": "How much do Graeagle vacation rentals cost for a golf group?", "acceptedAnswer": { "@type": "Answer", "text": "Stay-and-play packages including vacation rental lodging and tee times at all 5 Graeagle courses start from $299 per golfer. Final pricing depends on property, nights, group size, and rounds. GolfGraeagle provides a free custom quote within 24 hours." } },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteConfig.url },
      { "@type": "ListItem", "position": 2, "name": "Lodging", "item": `${siteConfig.url}/lodging/` },
      { "@type": "ListItem", "position": 3, "name": "Vacation Rentals & Cabins", "item": canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "TravelAgency",
    "@id": `${siteConfig.url}/#organization`,
    "name": "GolfGraeagle.com",
    "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.8", "reviewCount": "672", "bestRating": "5" },
  },
];

// Pull real data from content.js
const townhomes = lodging.find((l: any) => l.slug === 'townhomes-at-plumas-pines');
const riverPines = lodging.find((l: any) => l.slug === 'river-pines-resort');
const chaletView = lodging.find((l: any) => l.slug === 'chalet-view-lodge');
const innNakoma  = lodging.find((l: any) => l.slug === 'inn-at-nakoma');

// On-site dining cross-sells
const longboards = dining.find((d: any) => d.slug === 'longboards');
const roadhouse  = dining.find((d: any) => d.slug === 'roadhouse');
const eureka     = dining.find((d: any) => d.slug === 'eureka-peak-brewing');

// Drive times per property (from FAQs / confirmed facts)
const townhomeDrives = [
  { course: 'Plumas Pines',    time: 'Steps away', slug: 'plumas-pines-golf-packages' },
  { course: 'Graeagle Meadows', time: '10 min',   slug: 'graeagle-meadows-golf-packages' },
  { course: 'Whitehawk Ranch',  time: '12 min',   slug: 'whitehawk-ranch-golf-packages' },
  { course: 'Nakoma Dragon',    time: '18 min',   slug: 'nakoma-dragon-golf-packages' },
  { course: 'Grizzly Ranch',    time: '22 min',   slug: 'grizzly-ranch-golf-packages' },
];
const riverPineDrives = [
  { course: 'Graeagle Meadows', time: 'Walk',     slug: 'graeagle-meadows-golf-packages' },
  { course: 'Whitehawk Ranch',  time: '8 min',    slug: 'whitehawk-ranch-golf-packages' },
  { course: 'Plumas Pines',     time: '10 min',   slug: 'plumas-pines-golf-packages' },
  { course: 'Grizzly Ranch',    time: '18 min',   slug: 'grizzly-ranch-golf-packages' },
  { course: 'Nakoma Dragon',    time: '20 min',   slug: 'nakoma-dragon-golf-packages' },
];
const chaletDrives = [
  { course: 'Whitehawk Ranch',  time: '8 min',    slug: 'whitehawk-ranch-golf-packages' },
  { course: 'Graeagle Meadows', time: '10 min',   slug: 'graeagle-meadows-golf-packages' },
  { course: 'Plumas Pines',     time: '12 min',   slug: 'plumas-pines-golf-packages' },
  { course: 'Grizzly Ranch',    time: '18 min',   slug: 'grizzly-ranch-golf-packages' },
  { course: 'Nakoma Dragon',    time: '22 min',   slug: 'nakoma-dragon-golf-packages' },
];
---

<Base {title} {description} {schema} canonical={canonical} bodyClass="light-page"
  ogImage={`${siteConfig.url}/wp-images/plumas-pines-hero.webp`}>
  <Nav />

  <!-- ══ HERO ══════════════════════════════════════════════════ -->
  <section style="position:relative;min-height:72vh;display:flex;align-items:flex-end;overflow:hidden;">
    <div style="position:absolute;inset:0;display:grid;grid-template-columns:1fr 1fr;gap:3px;">
      <img src="/wp-images/plumas-pines-hero.webp" alt="Townhomes at Plumas Pines golf views"
        style="width:100%;height:100%;object-fit:cover;" width="960" height="720" loading="eager" fetchpriority="high"/>
      <div style="display:grid;grid-template-rows:1fr 1fr;gap:3px;">
        <img src="/wp-images/ChaletView-02.webp" alt="Chalet View Lodge cabin"
          style="width:100%;height:100%;object-fit:cover;" width="480" height="360" loading="eager"/>
        <img src="/wp-images/DJI_0949-Edit.webp" alt="River Pines Resort aerial"
          style="width:100%;height:100%;object-fit:cover;" width="480" height="360" loading="eager"/>
      </div>
    </div>
    <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(13,26,14,0.92) 0%,rgba(13,26,14,0.5) 50%,rgba(13,26,14,0.15) 100%);"></div>
    <div style="position:relative;z-index:2;padding:0 8% 64px;max-width:860px;">
      <p style="font-size:11px;color:#e8a850;text-transform:uppercase;letter-spacing:0.18em;font-weight:700;margin:0 0 18px;">Graeagle, California · Plumas County · Sierra Nevada</p>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(36px,6vw,64px);color:#f5f0e8;font-weight:400;margin:0 0 20px;line-height:1.08;">Vacation Rentals &amp; Cabins<br/><em style="color:#e8a850;">for Golf Groups</em></h1>
      <p class="speakable" style="font-size:18px;color:rgba(245,240,232,0.7);max-width:580px;margin:0 0 32px;line-height:1.75;" data-speakable>
        Graeagle vacation rentals — on-course townhomes with full kitchens, Feather River cabins, and forested lodge suites. Every property bundled with guaranteed tee times at all 5 championship courses.
      </p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
        <a href="/request-a-quote/?groupType=vacation-rental" class="btn-green-glow" style="font-size:15px;padding:15px 32px;">Get a Free Quote →</a>
        <a href="tel:+18885861157" style="display:flex;align-items:center;gap:8px;color:rgba(245,240,232,0.6);font-size:14px;text-decoration:none;padding:15px 20px;border:1px solid rgba(245,240,232,0.2);border-radius:10px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.15 3.4 2 2 0 0 1 3.12 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16z"/></svg>
          (888) 586-1157
        </a>
      </div>
    </div>
  </section>

  <!-- ══ TRUST BAR ═════════════════════════════════════════════ -->
  <div style="background:#f0ece3;border-bottom:1px solid rgba(28,18,8,0.08);padding:14px 8%;display:flex;gap:0;flex-wrap:wrap;">
    {[
      ['3 properties','Cabins, townhomes & lodge suites'],
      ['2–4 BR','Self-catering units with full kitchens'],
      ['All 5 courses','Tee times bundled in every package'],
      ['$299+/golfer','Stay-and-play packages'],
      ['4.8 ★','672 verified reviews'],
    ].map(([v,l]) => (
      <div style="flex:1;min-width:140px;text-align:center;padding:8px 12px;border-right:1px solid rgba(28,18,8,0.07);">
        <div style="font-family:'Playfair Display',serif;font-size:17px;color:#1a2e1a;font-weight:500;">{v}</div>
        <div style="font-size:11px;color:rgba(28,18,8,0.4);margin-top:2px;line-height:1.3;">{l}</div>
      </div>
    ))}
  </div>

  <!-- ══ QUICK MATCH ═══════════════════════════════════════════ -->
  <section style="background:#fff;padding:48px 8% 32px;">
    <p style="font-size:11px;color:#a06c30;text-transform:uppercase;letter-spacing:0.14em;font-weight:700;margin:0 0 16px;">Find Your Match</p>
    <h2 style="font-family:'Playfair Display',serif;font-size:clamp(22px,3vw,32px);color:#1a2e1a;margin:0 0 24px;font-weight:400;">Which rental suits your group?</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(220px,45vw),1fr));gap:12px;margin-bottom:8px;">
      {[
        { icon:'🏠', q:'Large group, want own space?',     a:'Townhomes at Plumas Pines — 2–4 BR, full kitchens, rent adjacent units', href:'#townhomes' },
        { icon:'🌲', q:'Cabin feel, resort amenities?',    a:'River Pines cabins — Feather River setting, pool, hot tub, Roadhouse on-site', href:'#river-pines' },
        { icon:'🏔️', q:'Privacy + spa + forest?',          a:'Chalet View Lodge private suites — 10 forested acres, Eureka Peak Brewing on-site', href:'#chalet-view' },
        { icon:'⬆️', q:'Want the full luxury upgrade?',    a:'Inn at Nakoma — Frank Lloyd Wright clubhouse, on the Dragon course', href:'/portfolio/the-inn-at-nakoma-clio-ca/' },
      ].map(c => (
        <a href={c.href} style="display:flex;gap:14px;align-items:flex-start;padding:18px;background:rgba(28,18,8,0.03);border:1px solid rgba(28,18,8,0.07);border-radius:12px;text-decoration:none;transition:all 0.2s;" onmouseover="this.style.borderColor='rgba(232,168,80,0.35)';this.style.background='rgba(232,168,80,0.04)'" onmouseout="this.style.borderColor='rgba(28,18,8,0.07)';this.style.background='rgba(28,18,8,0.03)'">
          <span style="font-size:22px;flex-shrink:0;margin-top:1px;">{c.icon}</span>
          <div>
            <div style="font-size:13px;font-weight:600;color:#1a2e1a;margin-bottom:5px;">{c.q}</div>
            <div style="font-size:12px;color:rgba(28,18,8,0.5);line-height:1.55;">{c.a}</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ══ PROPERTY 1: TOWNHOMES ══════════════════════════════ -->
  <section id="townhomes" style="padding:56px 8%;background:#faf8f5;scroll-margin-top:80px;">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
        <span style="background:#1a2e1a;color:#e8a850;font-size:10px;font-weight:700;padding:4px 12px;border-radius:100px;text-transform:uppercase;letter-spacing:0.1em;">Best for Groups of 8–20</span>
        <span style="font-size:12px;color:rgba(28,18,8,0.4);">On-course vacation rentals</span>
      </div>
      <h2 style="font-family:'Playfair Display',serif;font-size:clamp(26px,4vw,40px);color:#1a2e1a;margin:0 0 6px;font-weight:400;">Townhomes at Plumas Pines</h2>
      <p style="font-size:14px;color:#a06c30;font-weight:600;margin:0 0 24px;">2–4 Bedroom Units · Full Kitchens · Steps from the 1st Tee</p>

      <!-- Photo carousel -->
      <div class="gal-carousel-wrap" data-carousel style="margin-bottom:32px;">
        <button class="gal-arrow gal-arrow-prev" aria-label="Previous">&#8249;</button>
        <div class="gal-carousel" id="carousel-townhomes">
          {townhomes?.images?.slice(0,6).map((img: string, i: number) => (
            <button class="gallery-btn" data-src={img} data-idx={i} data-total={Math.min(townhomes.images.length,6)}
              style="border:none;padding:0;background:none;cursor:zoom-in;flex:0 0 calc(50% - 3px);aspect-ratio:16/9;border-radius:10px;overflow:hidden;display:block;">
              <img src={img} alt={`Townhomes at Plumas Pines — photo ${i+1}`}
                loading={i===0?'eager':'lazy'} width="640" height="360"
                style="width:100%;height:100%;object-fit:cover;transition:transform 0.4s ease;" />
            </button>
          ))}
        </div>
        <button class="gal-arrow gal-arrow-next" aria-label="Next">&#8250;</button>
      </div>

      <div style="display:grid;grid-template-columns:1fr 340px;gap:40px;align-items:start;" class="prop-grid">
        <div>
          <p style="font-size:16px;color:rgba(28,18,8,0.65);line-height:1.85;margin:0 0 24px;" class="speakable">{townhomes?.description}</p>
          <!-- Highlights -->
          <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:28px;">
            {townhomes?.highlights?.map((h: string) => (
              <div style="display:flex;gap:10px;align-items:flex-start;font-size:14px;color:rgba(28,18,8,0.6);line-height:1.5;">
                <span style="color:#e8a850;flex-shrink:0;margin-top:2px;font-size:12px;">✓</span>{h}
              </div>
            ))}
          </div>
          <!-- On-site dining cross-sell -->
          <div style="background:rgba(232,168,80,0.07);border:1px solid rgba(232,168,80,0.2);border-radius:12px;padding:16px 20px;margin-bottom:28px;">
            <p style="font-size:10px;color:#a06c30;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;margin:0 0 8px;">On-Site Dining</p>
            <a href="/portfolio/longboards-bar-and-grill/" style="display:flex;align-items:center;justify-content:space-between;text-decoration:none;" onmouseover="this.style.opacity='0.75'" onmouseout="this.style.opacity='1'">
              <div>
                <div style="font-size:14px;font-weight:600;color:#1a2e1a;">Longboards Bar &amp; Grill</div>
                <div style="font-size:12px;color:rgba(28,18,8,0.45);margin-top:3px;">{longboards?.tagline}</div>
              </div>
              <span style="font-size:12px;color:#a06c30;flex-shrink:0;margin-left:12px;">View →</span>
            </a>
          </div>
          <div style="display:flex;gap:12px;flex-wrap:wrap;">
            <a href="/portfolio/the-townhomes-at-plumas-pines/" style="font-size:14px;font-weight:600;color:#1a2e1a;padding:11px 22px;border:1px solid rgba(28,18,8,0.15);border-radius:8px;text-decoration:none;">Full property details →</a>
            <a href="/request-a-quote/?lodging=townhomes-at-plumas-pines&groupType=vacation-rental" class="btn-green-glow" style="font-size:14px;padding:11px 22px;">Book with Tee Times →</a>
          </div>
        </div>

        <!-- Drive times sidebar -->
        <div style="background:#fff;border:1px solid rgba(28,18,8,0.08);border-radius:14px;padding:20px 22px;">
          <p style="font-size:10px;color:#a06c30;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;margin:0 0 14px;">Drive Times to Courses</p>
          {townhomeDrives.map(d => (
            <a href={`/portfolio/${d.slug}/`} style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid rgba(28,18,8,0.05);text-decoration:none;" onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">
              <span style="font-size:13px;color:#1a2e1a;font-weight:500;">{d.course}</span>
              <span style={`font-size:12px;font-weight:700;${d.time==='Steps away'?'color:#1a7a40;':'color:rgba(28,18,8,0.45);'}`}>{d.time}</span>
            </a>
          ))}
          <a href="/request-a-quote/?lodging=townhomes-at-plumas-pines" class="btn-green-glow" style="display:block;text-align:center;font-size:13px;padding:11px;margin-top:16px;border-radius:8px;">Get Package Quote →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ PROPERTY 2: RIVER PINES ════════════════════════════ -->
  <section id="river-pines" style="padding:56px 8%;background:#fff;scroll-margin-top:80px;">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
        <span style="background:#1a2e1a;color:#e8a850;font-size:10px;font-weight:700;padding:4px 12px;border-radius:100px;text-transform:uppercase;letter-spacing:0.1em;">Best Cabin Option</span>
        <span style="font-size:12px;color:rgba(28,18,8,0.4);">Feather River setting</span>
      </div>
      <h2 style="font-family:'Playfair Display',serif;font-size:clamp(26px,4vw,40px);color:#1a2e1a;margin:0 0 6px;font-weight:400;">River Pines Resort</h2>
      <p style="font-size:14px;color:#a06c30;font-weight:600;margin:0 0 24px;">Cabins · Cottages · Suites · Walking Distance to Graeagle Meadows</p>

      <!-- Photo carousel -->
      <div class="gal-carousel-wrap" data-carousel style="margin-bottom:32px;">
        <button class="gal-arrow gal-arrow-prev" aria-label="Previous">&#8249;</button>
        <div class="gal-carousel" id="carousel-riverpines">
          {riverPines?.images?.slice(0,6).map((img: string, i: number) => (
            <button class="gallery-btn" data-src={img} data-idx={i} data-total={Math.min(riverPines.images.length,6)}
              style="border:none;padding:0;background:none;cursor:zoom-in;flex:0 0 calc(50% - 3px);aspect-ratio:16/9;border-radius:10px;overflow:hidden;display:block;">
              <img src={img} alt={`River Pines Resort — photo ${i+1}`}
                loading={i===0?'eager':'lazy'} width="640" height="360"
                style="width:100%;height:100%;object-fit:cover;transition:transform 0.4s ease;" />
            </button>
          ))}
        </div>
        <button class="gal-arrow gal-arrow-next" aria-label="Next">&#8250;</button>
      </div>

      <div style="display:grid;grid-template-columns:1fr 340px;gap:40px;align-items:start;" class="prop-grid">
        <div>
          <p style="font-size:16px;color:rgba(28,18,8,0.65);line-height:1.85;margin:0 0 24px;" class="speakable">{riverPines?.description}</p>
          <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:28px;">
            {riverPines?.highlights?.map((h: string) => (
              <div style="display:flex;gap:10px;align-items:flex-start;font-size:14px;color:rgba(28,18,8,0.6);line-height:1.5;">
                <span style="color:#e8a850;flex-shrink:0;margin-top:2px;font-size:12px;">✓</span>{h}
              </div>
            ))}
          </div>
          <!-- On-site dining cross-sell -->
          <div style="background:rgba(232,168,80,0.07);border:1px solid rgba(232,168,80,0.2);border-radius:12px;padding:16px 20px;margin-bottom:28px;">
            <p style="font-size:10px;color:#a06c30;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;margin:0 0 8px;">On-Site Dining</p>
            <a href="/portfolio/roadhouse-at-river-pines/" style="display:flex;align-items:center;justify-content:space-between;text-decoration:none;" onmouseover="this.style.opacity='0.75'" onmouseout="this.style.opacity='1'">
              <div>
                <div style="font-size:14px;font-weight:600;color:#1a2e1a;">The Roadhouse at River Pines</div>
                <div style="font-size:12px;color:rgba(28,18,8,0.45);margin-top:3px;">{roadhouse?.tagline}</div>
              </div>
              <span style="font-size:12px;color:#a06c30;flex-shrink:0;margin-left:12px;">View →</span>
            </a>
          </div>
          <div style="display:flex;gap:12px;flex-wrap:wrap;">
            <a href="/portfolio/river-pines-resort-graeagle-ca/" style="font-size:14px;font-weight:600;color:#1a2e1a;padding:11px 22px;border:1px solid rgba(28,18,8,0.15);border-radius:8px;text-decoration:none;">Full property details →</a>
            <a href="/request-a-quote/?lodging=river-pines-resort&groupType=vacation-rental" class="btn-green-glow" style="font-size:14px;padding:11px 22px;">Book with Tee Times →</a>
          </div>
        </div>
        <div style="background:#faf8f5;border:1px solid rgba(28,18,8,0.08);border-radius:14px;padding:20px 22px;">
          <p style="font-size:10px;color:#a06c30;text-transform:uppercase;letter-spacing:0.12em;font-weight:700;margin:0 0 14px;">Drive Times to Courses</p>
          {riverPineDrives.map(d => (
            <a href={`/portfolio/${d.slug}/`} style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid rgba(28,18,8,0.05);text-decoration:none;" onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">
              <span style="font-size:13px;color:#1a2e1a;font-weight:500;">{d.course}</span>
              <span style={`font-size:12px;font-weight:700;${d.time==='Walk'?'color:#1a7a40;':'color:rgba(28,18,8,0.45);'}`}>{d.time}</span>
            </a>
